          <button type="button" class="shop-photo-modal__close" data-photo-modal-close aria-label="閉じる">×</button>
          <button type="button" class="shop-photo-modal__prev" data-photo-modal-prev aria-label="前の写真">‹</button>
          <button type="button" class="shop-photo-modal__next" data-photo-modal-next aria-label="次の写真">›</button>

          <% shop_photo_groups.each do |group| %>
            <div
              class="shop-photo-modal__viewport"
              data-photo-modal-viewport
              data-photo-group="<%= group[:key] %>"
              style="<%= group[:key] == 'all' ? '' : 'display:none;' %>">
              <% group[:photos].each do |photo| %>
                <div class="shop-photo-modal__slide">
                  <%= image_tag url_for(photo),
                                class: "shop-photo-modal__img",
