            <%= link_to "難波で席で喫煙可", namba_smoking_path("all_smoking"), class: "ss-btn ss-btn--ghost" %>
            <%= link_to "難波で喫煙所あり", namba_smoking_path("separated"), class: "ss-btn ss-btn--ghost" %>
            <%= link_to "難波の居酒屋", namba_genre_path("izakaya"), class: "ss-btn ss-btn--ghost" %>
          <% end %>
        </div>
      </section>
    <% end %>

    <hr class="shop-show__divider">

    <section class="shop-show__section">
      <h2 class="shop-show__sectionTitle">このページについて</h2>
      <div class="shop-show__footerActions">
        <%= link_to footer_back_label, back_path, class: "ss-btn ss-btn--ghost" %>
        <%= link_to "情報の修正依頼", new_shop_shop_edit_request_path(@shop), class: "ss-btn ss-btn--dark" %>
        <%= link_to "通報", new_shop_shop_report_path(@shop), class: "ss-btn ss-btn--muted" %>
      </div>
    </section>
  </div>
</div>