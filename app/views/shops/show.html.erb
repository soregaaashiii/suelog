<%# app/views/shops/show.html.erb %>

<h1 style="margin-top:0;"><%= @shop.name %></h1>

<% if flash[:notice].present? %>
<div style="padding:12px; border:1px solid #b6d7a8; background:#e6f4ea; border-radius:12px; margin:10px 0; color:#137333; font-weight:700;">
<%= flash[:notice] %>
</div>
<% end %>

<% if flash[:alert].present? %>
<div style="padding:12px; border:1px solid #f5c2c7; background:#fff5f5; border-radius:12px; margin:10px 0; color:#b00020; font-weight:700;">
<%= flash[:alert] %>
</div>
<% end %>

<p style="color:#666; margin:6px 0 14px;">
ジャンル：<%= @shop.display_genre.presence || "未設定" %>
</p>

<p>住所：<%= @shop.address.presence || "未設定" %></p>

<% if @shop.approved? && @shop.opening_hours.present? %>
<% if @shop.open_now? %>
<p style="color:#137333 !important; -webkit-text-fill-color:#137333 !important; font-weight:700;">● 現在営業中</p>
<% else %>
<p style="color:#b00020 !important; -webkit-text-fill-color:#b00020 !important; font-weight:700;">● 現在は営業時間外</p>
<% end %>
<% end %>

<h3>営業時間</h3>

<% if @shop.opening_hours.present? %>
<table style="border-collapse:collapse; width:100%; max-width:520px;">
<% today = %w[日 月 火 水 木 金 土][Time.zone.today.wday] %>

<% @shop.opening_hours_lines.each do |day, text| %>
<% is_today = (day == today) %>

<tr style="<%= is_today ? 'background:#f6f7f9;' : '' %>">
<td style="padding:8px; border-bottom:1px solid #eee; width:60px; font-weight:<%= is_today ? 'bold' : 'normal' %>;">
<%= day %>
</td>

<td style="padding:8px; border-bottom:1px solid #eee;">
<%= text %>

<% if is_today && @shop.approved? && @shop.opening_hours.present? %>
<% if @shop.open_now? %>
<span style="margin-left:8px; padding:3px 8px; border-radius:999px; background:#e6f4ea; color:#137333 !important; -webkit-text-fill-color:#137333 !important; font-size:12px; font-weight:700; display:inline-block;">営業中</span>
<% else %>
<span style="margin-left:8px; padding:3px 8px; border-radius:999px; background:#fdecea; color:#b00020 !important; -webkit-text-fill-color:#b00020 !important; font-size:12px; font-weight:700; display:inline-block;">営業終了</span>
<% end %>
<% end %>
</td>
</tr>
<% end %>
</table>

<p style="color:#666; font-size:12px; margin-top:8px;">
※ 営業中判定は入力された営業時間を元にした簡易判定です
</p>
<% else %>
<p style="color:#666;">未設定</p>
<% end %>

<p>最終確認日：<%= @shop.last_confirmed_on.presence || "未設定" %></p>

<h3>店舗情報</h3>
<p>最寄駅：<%= @shop.nearest_station.presence || "未設定" %></p>

<p>
電話番号：
<% if @shop.phone.present? %>
<a href="tel:<%= @shop.phone.gsub(/[^0-9]/, "") %>"
style="display:inline-block; padding:10px 14px; background:#e3f2fd; border-radius:8px; text-decoration:none; font-weight:bold;">
<%= @shop.phone %>
</a>
<% else %>
未設定
<% end %>
</p>

<h3>喫煙情報</h3>

<p>
喫煙エリア：
<% if @shop.smoking_area.present? %>
<%= @shop.smoking_area == "separated" ? "喫煙所あり" : "席で喫煙可" %>
<% else %>
未設定
<% end %>
</p>

<p>
喫煙タイプ：
<% case @shop.smoking_type %>
<% when "both_ok" %>
紙・加熱式どちらもOK
<% when "electronic_only" %>
加熱式タバコのみOK
<% when "paper_only" %>
紙タバコのみOK
<% else %>
未設定
<% end %>
</p>

<p style="margin-top:12px;">
<%= link_to "一覧に戻る", root_path %> |
<%= link_to "編集依頼", new_shop_shop_edit_request_path(@shop) %> |
<%= link_to "通報", new_shop_shop_report_path(@shop) %>
</p>

<% unless @shop.approved? %>
<div style="border:1px solid #f5c2c7; background:#fff5f5; padding:12px; border-radius:12px; margin-top:12px;">
<p style="margin:0; color:#b00020; font-weight:bold;">この店舗は承認待ちです</p>
<p style="margin:6px 0 0; color:#666;">※ 詳細（地図・写真・口コミ・メモ等）は確認後に公開されます</p>
</div>
<% else %>

<hr>

<p>エリア：<%= @shop.area.presence || "未設定" %></p>
<p>メモ：<%= @shop.note.presence || "未設定" %></p>

<%# ============================
地図（Leaflet）
※ 位置情報が無いとピンが出ない
============================ %>

<h2>地図</h2>

<% if @shop.latitude.present? && @shop.longitude.present? %>
<div id="shop-map" style="height:320px; border:1px solid #ddd; border-radius:12px; overflow:hidden;"></div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
document.addEventListener("turbo:before-cache", () => {
const el = document.getElementById("shop-map");
if (el && el._leaflet_map_instance) {
el._leaflet_map_instance.remove();
el._leaflet_map_instance = null;
}
});

document.addEventListener("turbo:load", () => {
const el = document.getElementById("shop-map");
if (!el) return;

if (el._leaflet_map_instance) {
el._leaflet_map_instance.remove();
el._leaflet_map_instance = null;
}

const lat = <%= @shop.latitude.to_f %>;
const lng = <%= @shop.longitude.to_f %>;

const map = L.map("shop-map").setView([lat, lng], 16);
el._leaflet_map_instance = map;

L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
maxZoom: 19,
attribution: '&copy; OpenStreetMap contributors'
}).addTo(map);

const marker = L.marker([lat, lng]).addTo(map);
marker.bindPopup("<strong><%= j @shop.name %></strong>").openPopup();

setTimeout(() => map.invalidateSize(), 0);
setTimeout(() => map.invalidateSize(), 200);
});
</script>

<p style="margin-top:8px;">
<% q = ERB::Util.url_encode([@shop.name, @shop.area, @shop.address].compact.join(" ")) %>
<a href="https://www.google.com/maps?q=<%= q %>" target="_blank" rel="noopener">Googleマップで開く</a>
</p>
<% else %>
<p style="color:#666;">この店舗は位置情報（緯度・経度）が未設定です。</p>
<% end %>

<hr>
<h2>写真</h2>

<% [["料理", @shop.food_photos], ["内観", @shop.interior_photos], ["外観", @shop.exterior_photos], ["メニュー", @shop.menu_photos]].each do |label, photos| %>
<h3><%= label %></h3>
<% if photos.attached? %>
<div style="display:flex; gap:10px; flex-wrap:wrap;">
<% photos.each do |p| %>
<%= image_tag url_for(p), style: "width:160px; height:160px; object-fit:cover; border-radius:12px; border:1px solid #ddd;" %>
<% end %>
</div>
<% else %>
<p style="color:#666;">まだありません</p>
<% end %>
<% end %>

<% end %>