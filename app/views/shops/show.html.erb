<%# /Users/kawamuratakuya/dev/suelog/app/views/shops/show.html.erb %>

<% page_title_parts = [@shop.name.presence, "喫煙できる店", "吸えログ in大阪"].compact %>
<% page_description_parts = [] %>
<% page_description_parts << "#{@shop.name}の喫煙情報。" if @shop.name.present? %>
<% page_description_parts << @shop.smoking_area_label if @shop.respond_to?(:smoking_area_label) %>
<% page_description_parts << @shop.smoking_type_label if @shop.respond_to?(:smoking_type_label) %>
<% page_description_parts << "最寄駅：#{@shop.nearest_station}" if @shop.nearest_station.present? %>
<% page_description_parts << "住所：#{@shop.address}" if @shop.address.present? %>
<% if @shop.respond_to?(:display_opening_hours_text) && @shop.display_opening_hours_text.present? && @shop.display_opening_hours_text != "未設定" %>
  <% page_description_parts << "営業時間：#{@shop.display_opening_hours_text}" %>
<% end %>
<% page_description_parts << "大阪で喫煙できる飲食店を探すなら吸えログ。" %>

<% content_for :title, page_title_parts.join("｜") %>
<% content_for :meta_description, page_description_parts.join(" ") %>
<% content_for :canonical_url, shop_url(@shop) %>

<% shop_location_text = [@shop.address, @shop.nearest_station, @shop.name].compact.join(" ") %>
<% is_umeda_shop = shop_location_text.include?("梅田") %>
<% is_namba_shop = shop_location_text.include?("難波") || shop_location_text.include?("なんば") %>

<% back_path =
  if is_umeda_shop
    umeda_path
  elsif is_namba_shop
    namba_path
  else
    root_path
  end %>

<% back_label =
  if is_umeda_shop
    "← 梅田の一覧に戻る"
  elsif is_namba_shop
    "← 難波の一覧に戻る"
  else
    "← 一覧に戻る"
  end %>

<% footer_back_label =
  if is_umeda_shop
    "梅田の一覧に戻る"
  elsif is_namba_shop
    "難波の一覧に戻る"
  else
    "一覧に戻る"
  end %>

<% shop_photo_groups = [
  { key: "all", label: "すべて", photos: (@shop.food_photos.to_a + @shop.interior_photos.to_a + @shop.exterior_photos.to_a + @shop.menu_photos.to_a) },
  { key: "food", label: "料理", photos: @shop.food_photos.to_a },
  { key: "interior", label: "内観", photos: @shop.interior_photos.to_a },
  { key: "exterior", label: "外観", photos: @shop.exterior_photos.to_a },
  { key: "menu", label: "メニュー", photos: @shop.menu_photos.to_a }
] %>


<% total_shop_photos_count = shop_photo_groups.reject { |group| group[:key] == "all" }.sum { |group| group[:photos].size } %>

<% content_for :head do %>
  <% photo_url = nil %>
  <% if @shop.respond_to?(:food_photos) && @shop.food_photos.attached? %>
    <% photo_url = url_for(@shop.food_photos.first) rescue nil %>
  <% elsif @shop.respond_to?(:exterior_photos) && @shop.exterior_photos.attached? %>
    <% photo_url = url_for(@shop.exterior_photos.first) rescue nil %>
  <% elsif @shop.respond_to?(:interior_photos) && @shop.interior_photos.attached? %>
    <% photo_url = url_for(@shop.interior_photos.first) rescue nil %>
  <% elsif @shop.respond_to?(:menu_photos) && @shop.menu_photos.attached? %>
    <% photo_url = url_for(@shop.menu_photos.first) rescue nil %>
  <% end %>

  <% restaurant_structured_data = {
    "@context": "https://schema.org",
    "@type": "Restaurant",
    "name": @shop.name,
    "url": shop_url(@shop),
    "image": photo_url,
    "telephone": @shop.phone.presence,
    "address": (@shop.address.present? ? {
      "@type": "PostalAddress",
      "streetAddress": @shop.address,
      "addressRegion": "大阪府",
      "addressCountry": "JP"
    } : nil),
    "servesCuisine": @shop.display_genre.presence,
    "description": page_description_parts.join(" "),
    "smokingAllowed": (@shop.smoking_area == "all_smoking"),
    "keywords": [
      (@shop.smoking_area_label if @shop.respond_to?(:smoking_area_label)),
      (@shop.smoking_type_label if @shop.respond_to?(:smoking_type_label)),
      @shop.display_genre.presence,
      @shop.nearest_station.presence,
      "大阪",
      "喫煙可"
    ].compact.join(", "),
    "geo": (@shop.latitude.present? && @shop.longitude.present? ? {
      "@type": "GeoCoordinates",
      "latitude": @shop.latitude,
      "longitude": @shop.longitude
    } : nil)
  }.compact %>

  <% breadcrumb_items = [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "ホーム",
      "item": root_url
    }
  ] %>

  <% if is_umeda_shop %>
    <% breadcrumb_items << {
      "@type": "ListItem",
      "position": 2,
      "name": "梅田で喫煙できる店",
      "item": umeda_url
    } %>
    <% breadcrumb_items << {
      "@type": "ListItem",
      "position": 3,
      "name": @shop.name
    } %>
  <% elsif is_namba_shop %>
    <% breadcrumb_items << {
      "@type": "ListItem",
      "position": 2,
      "name": "難波で喫煙できる店",
      "item": namba_url
    } %>
    <% breadcrumb_items << {
      "@type": "ListItem",
      "position": 3,
      "name": @shop.name
    } %>
  <% else %>
    <% breadcrumb_items << {
      "@type": "ListItem",
      "position": 2,
      "name": @shop.name
    } %>
  <% end %>

  <% breadcrumb_structured_data = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumb_items
  } %>

  <script type="application/ld+json">
    <%= raw restaurant_structured_data.to_json %>
  </script>

  <script type="application/ld+json">
    <%= raw breadcrumb_structured_data.to_json %>
  </script>
<% end %>

<style>
.shop-show {
  max-width: 980px;
  margin: 0 auto;
}

.shop-show__breadcrumb {
  margin: 0 0 14px;
  font-size: 13px;
  color: #666666;
  line-height: 1.7;
}

.shop-show__breadcrumb a {
  color: #666666;
  text-decoration: none;
}

.shop-show__breadcrumbCurrent {
  color: #111111;
  font-weight: 700;
}

.shop-show__back {
  margin: 0 0 14px;
}

.shop-show__backLink {
  display: inline-flex;
  align-items: center;
  color: #6b6b6b;
  text-decoration: none;
  font-weight: 700;
}

.shop-show__backLink:hover {
  color: #111111;
}

.shop-show__hero {
  background: linear-gradient(135deg, #fffdf8 0%, #ffffff 60%);
  border: 1px solid #e8e3d7;
  border-radius: 22px;
  padding: 18px;
  box-shadow: 0 10px 30px rgba(17, 17, 17, 0.04);
  margin-bottom: 16px;
}

.shop-show__title {
  margin: 0 0 8px;
  font-size: clamp(28px, 4vw, 40px);
  line-height: 1.15;
  letter-spacing: -0.03em;
  color: #111111;
}

.shop-show__sub {
  margin: 0;
  color: #7a7a7a;
  font-size: 13px;
}

.shop-show__badges {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 12px;
}

.shop-show__layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 16px;
}

.shop-show__section {
  background: #ffffff;
  border: 1px solid #e8e3d7;
  border-radius: 20px;
  padding: 18px;
  box-shadow: 0 10px 30px rgba(17, 17, 17, 0.03);
}

.shop-show__sectionTitle {
  margin: 0 0 14px;
  font-size: 20px;
  font-weight: 800;
  color: #111111;
  letter-spacing: -0.02em;
}

.shop-show__sectionHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 14px;
}

.shop-show__sectionMeta {
  color: #666666;
  font-size: 13px;
  font-weight: 700;
}

.shop-show__infoTable {
  border-top: 1px solid #ece6d8;
  border-bottom: 1px solid #ece6d8;
  background: #ffffff;
}

.shop-show__infoRow {
  display: grid;
  grid-template-columns: 150px minmax(0, 1fr);
  border-top: 1px solid #ece6d8;
  min-height: unset;
}

.shop-show__infoRow:first-child {
  border-top: 0;
}

.shop-show__infoHead {
  padding: 6px 8px;
  background: #faf8f2;
  color: #6f6f6f;
  font-size: 11px;
  font-weight: 700;
  line-height: 1.35;
  border-right: 1px solid #ece6d8;
}

.shop-show__infoCell {
  padding: 6px 8px;
  color: #111111;
  font-size: 13px;
  line-height: 1.4;
  word-break: break-word;
  white-space: normal;
  background: #ffffff;
}

.shop-show__infoCell--multiline {
  white-space: pre-wrap;
}

.shop-show__hoursBox {
  display: grid;
  gap: 12px;
}

.shop-show__hoursCard {
  background: #faf8f2;
  border: 1px solid #eee6d6;
  border-radius: 16px;
  padding: 14px;
}

.shop-show__hoursCardTitle {
  margin: 0 0 6px;
  color: #7a7a7a;
  font-size: 12px;
  font-weight: 700;
}

.shop-show__hoursCardValue {
  color: #111111;
  font-size: 15px;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
}

.shop-show__hoursNote {
  margin-top: 8px;
  color: #777777;
  font-size: 12px;
}

.shop-show__phoneLink {
  display: inline;
  color: #1f4ea3;
  text-decoration: none;
  font-weight: 700;
  line-height: 1.3;
}

.shop-show__phoneLink:hover {
  text-decoration: underline;
}

.shop-show__bookingActions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 8px;
}

.shop-show__map {
  height: 320px;
  min-height: 320px;
  border: 1px solid #e0e0e0;
  border-radius: 14px;
  overflow: hidden;
  background: #f7f7f7;
}

.shop-show__mapLink {
  margin-top: 10px;
}

.shop-show__mapLink a {
  color: #7a5a12;
  font-weight: 700;
  text-decoration: none;
}

.shop-show__photosGroup + .shop-show__photosGroup {
  margin-top: 18px;
}

.shop-show__photosTitle {
  margin: 0 0 10px;
  font-size: 16px;
  font-weight: 800;
  color: #111111;
}

.shop-show__photosGrid {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.shop-show__photo {
  width: 160px;
  height: 160px;
  object-fit: cover;
  border-radius: 12px;
  border: 1px solid #ddd;
}

.shop-show__footerActions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 4px;
}

.shop-show__relatedLinks {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 8px;
}

.shop-show__divider {
  border: 0;
  border-top: 1px solid #eee6d6;
  margin: 4px 0 0;
}

/* 写真タブ */
.shop-show__photoTabs {
  margin-top: 2px;
}

.shop-show__photoTabsNav {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 14px;
}

.shop-show__photoTab {
  appearance: none;
  border: 1px solid #e2dccd;
  background: #ffffff;
  color: #444444;
  border-radius: 999px;
  padding: 8px 14px;
  font-size: 13px;
  font-weight: 800;
  line-height: 1.2;
  cursor: pointer;
}

.shop-show__photoTab:hover {
  border-color: #cfc4a5;
}

.shop-show__photoTab.is-active {
  background: #111111;
  border-color: #111111;
  color: #ffffff;
}

.shop-show__photoTabCount {
  opacity: 0.9;
}

.shop-show__photoPanel {
  display: none;
}

.shop-show__photoPanel.is-active {
  display: block;
}

.shop-show__photoGrid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.shop-show__photoCard {
  display: block;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid #ddd;
  background: #f7f7f7;
  aspect-ratio: 1 / 1;
}

.shop-show__photoCardImage {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.shop-show__photoEmpty {
  margin: 0;
  color: #666666;
  font-size: 14px;
}

.ss-badge {
  display: inline-flex;
  align-items: center;
  min-height: 32px;
  padding: 0 10px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 800;
  border: 1px solid transparent;
}

.ss-badge--dark {
  background: #111111;
  color: #ffffff;
  border-color: #111111;
}

.ss-badge--gold {
  background: #f6edd7;
  color: #7a5a12;
  border-color: #eadbb5;
}

.ss-badge--line {
  background: #ffffff;
  color: #111111;
  border-color: #e8e3d7;
}

.ss-badge--green {
  background: #eef7ee;
  color: #2f6b3b;
  border-color: #d8e7d7;
}

.ss-badge--warn {
  background: #fff6db;
  color: #8a6500;
  border-color: #f0de9c;
}

.ss-badge--muted {
  background: #f5f5f5;
  color: #555555;
  border-color: #d8d8d8;
}

.ss-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42px;
  padding: 0 16px;
  border-radius: 999px;
  text-decoration: none;
  font-size: 14px;
  font-weight: 800;
  border: 1px solid transparent;
}

.ss-btn--dark {
  background: #111111;
  color: #ffffff;
  border-color: #111111;
}

.ss-btn--ghost {
  background: #ffffff;
  color: #111111;
  border-color: #e8e3d7;
}

.ss-btn--muted {
  background: #ffffff;
  color: #666666;
  border-color: #eeeeee;
}

.ss-alert {
  padding: 12px 14px;
  border-radius: 12px;
  margin: 10px 0;
  font-weight: 700;
}

.ss-alert--notice {
  border: 1px solid #d8e7d7;
  background: #eef7ee;
  color: #2f6b3b;
}

.ss-alert--alert {
  border: 1px solid #f0d1d1;
  background: #fff6f6;
  color: #b00020;
}

.ss-alert--warn {
  border: 1px solid #f0de9c;
  background: #fffaf0;
  color: #8a6500;
}

.ss-pending {
  border: 1px solid #f0d1d1;
  background: #fff6f6;
  padding: 14px;
  border-radius: 14px;
}

.ss-pending__title {
  margin: 0;
  color: #b00020;
  font-weight: 800;
}

.ss-pending__text {
  margin: 6px 0 0;
  color: #666666;
}

@media (min-width: 721px) {
  .shop-show__photoGrid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

@media (max-width: 720px) {
  .shop-show__hero,
  .shop-show__section {
    border-radius: 16px;
    padding: 14px;
  }

  .shop-show__infoRow {
    grid-template-columns: 96px minmax(0, 1fr);
  }

  .shop-show__infoHead {
    padding: 6px 6px;
    font-size: 10px;
  }

  .shop-show__infoCell {
    padding: 6px 8px;
    font-size: 12px;
    line-height: 1.45;
  }

  .shop-show__footerActions,
  .shop-show__relatedLinks,
  .shop-show__bookingActions {
    flex-direction: column;
  }

  .ss-btn {
    width: 100%;
  }

  .shop-show__photo {
    width: calc(50% - 5px);
    height: 140px;
  }

  .shop-show__sectionHeader {
    align-items: flex-start;
    flex-direction: column;
  }
}
</style>

<div class="shop-show">
  <nav class="shop-show__breadcrumb" aria-label="パンくず">
    <%= link_to "ホーム", root_path %>

    <% if is_umeda_shop %>
      <span> › </span>
      <%= link_to "梅田で喫煙できる店", umeda_path %>
    <% elsif is_namba_shop %>
      <span> › </span>
      <%= link_to "難波で喫煙できる店", namba_path %>
    <% end %>

    <span> › </span>
    <span class="shop-show__breadcrumbCurrent"><%= @shop.name %></span>
  </nav>

  <div class="shop-show__back">
    <%= link_to back_label, back_path, class: "shop-show__backLink" %>
  </div>

  <section class="shop-show__hero">
    <h1 class="shop-show__title"><%= @shop.name %></h1>
    <p class="shop-show__sub">
      ジャンル：<%= @shop.display_genre.presence || "未設定" %>
    </p>

    <div class="shop-show__badges">
      <% if @shop.smoking_area == "all_smoking" %>
        <span class="ss-badge ss-badge--dark">席で喫煙可</span>
      <% elsif @shop.smoking_area == "separated" %>
        <span class="ss-badge ss-badge--line">喫煙所あり</span>
      <% elsif @shop.smoking_area == "unknown" %>
        <span class="ss-badge ss-badge--muted">喫煙エリア不明</span>
      <% end %>

      <% if @shop.smoking_type == "both_ok" %>
        <span class="ss-badge ss-badge--gold">紙・加熱式OK</span>
      <% elsif @shop.smoking_type == "electronic_only" %>
        <span class="ss-badge ss-badge--gold">加熱式のみ</span>
      <% elsif @shop.smoking_type == "paper_only" %>
        <span class="ss-badge ss-badge--gold">紙のみ</span>
      <% elsif @shop.smoking_type == "unknown" %>
        <span class="ss-badge ss-badge--muted">喫煙タイプ不明</span>
      <% end %>

      <% if @shop.respond_to?(:smoking_unverified?) && @shop.smoking_unverified? %>
        <span class="ss-badge ss-badge--warn">喫煙情報未確認</span>
      <% end %>

      <% if @shop.respond_to?(:open_now?) && @shop.open_now? %>
        <span class="ss-badge ss-badge--green">営業中</span>
      <% end %>

      <% if @shop.last_confirmed_on.present? %>
        <span class="ss-badge ss-badge--line">最終確認：<%= @shop.last_confirmed_on %></span>
      <% end %>
    </div>
  </section>

  <% if flash[:notice].present? %>
    <div class="ss-alert ss-alert--notice"><%= flash[:notice] %></div>
  <% end %>

  <% if flash[:alert].present? %>
    <div class="ss-alert ss-alert--alert"><%= flash[:alert] %></div>
  <% end %>

  <% if @shop.respond_to?(:smoking_unverified?) && @shop.smoking_unverified? %>
    <div class="ss-alert ss-alert--warn">
      この店舗の喫煙情報は未確認です。来店前に店舗へご確認ください。
    </div>
  <% end %>

  <div class="shop-show__layout">
    <section class="shop-show__section shop-show__section--table">
      <h2 class="shop-show__sectionTitle shop-show__sectionTitle--table">基本情報</h2>

      <div class="shop-show__infoTable">
        <div class="shop-show__infoRow">
          <div class="shop-show__infoHead">住所</div>
          <div class="shop-show__infoCell"><%= @shop.address.presence || "未設定" %></div>
        </div>

        <div class="shop-show__infoRow">
          <div class="shop-show__infoHead">最寄駅</div>
          <div class="shop-show__infoCell"><%= @shop.nearest_station.presence || "未設定" %></div>
        </div>

        <div class="shop-show__infoRow">
          <div class="shop-show__infoHead">電話番号</div>
          <div class="shop-show__infoCell">
            <% if @shop.phone.present? %>
              <a href="tel:<%= @shop.phone.gsub(/[^0-9]/, "") %>" class="shop-show__phoneLink">
                <%= @shop.phone %>
              </a>
            <% else %>
              未設定
            <% end %>
          </div>
        </div>

        <div class="shop-show__infoRow">
          <div class="shop-show__infoHead">喫煙エリア</div>
          <div class="shop-show__infoCell">
            <%= @shop.respond_to?(:smoking_area_label) ? @shop.smoking_area_label : "未設定" %>
          </div>
        </div>

        <div class="shop-show__infoRow">
          <div class="shop-show__infoHead">喫煙タイプ</div>
          <div class="shop-show__infoCell">
            <%= @shop.respond_to?(:smoking_type_label) ? @shop.smoking_type_label : "未設定" %>
          </div>
        </div>

        <% if @shop.respond_to?(:smoking_unverified?) && @shop.smoking_unverified? %>
          <div class="shop-show__infoRow">
            <div class="shop-show__infoHead">喫煙情報ステータス</div>
            <div class="shop-show__infoCell">未確認</div>
          </div>
        <% end %>

        <div class="shop-show__infoRow">
          <div class="shop-show__infoHead">営業時間</div>
          <div class="shop-show__infoCell shop-show__infoCell--multiline"><%= @shop.respond_to?(:display_opening_hours_text) ? @shop.display_opening_hours_text.to_s.gsub(" / ", "\n") : "未設定" %></div>
        </div>

        <div class="shop-show__infoRow">
          <div class="shop-show__infoHead">祝日営業時間</div>
          <div class="shop-show__infoCell shop-show__infoCell--multiline"><%= @shop.respond_to?(:display_holiday_hours_text) ? @shop.display_holiday_hours_text.to_s.gsub(" / ", "\n") : "未設定" %></div>
        </div>

        <div class="shop-show__infoRow">
          <div class="shop-show__infoHead">定休日</div>
          <div class="shop-show__infoCell shop-show__infoCell--multiline"><%= @shop.respond_to?(:display_closed_days_text) ? @shop.display_closed_days_text.to_s.gsub(" / ", "\n") : "未設定" %></div>
        </div>

        <div class="shop-show__infoRow">
  <div class="shop-show__infoHead">店舗詳細</div>
  <div class="shop-show__infoCell shop-show__infoCell--multiline" style="text-align:left; display:block;">
    <%= @shop.respond_to?(:public_store_details) ? (@shop.public_store_details.presence || "未設定") : "未設定" %>
  </div>
</div>

        <div class="shop-show__infoRow">
          <div class="shop-show__infoHead">最終確認日</div>
          <div class="shop-show__infoCell"><%= @shop.last_confirmed_on.presence || "未設定" %></div>
        </div>
      </div>
    </section>

    <% unless @shop.approved? %>
      <section class="shop-show__section">
        <div class="ss-pending">
          <p class="ss-pending__title">この店舗は承認待ちです</p>
