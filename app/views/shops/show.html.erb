              <% end %>
            </div>
          <% end %>

          <div class="shop-photo-modal__count" data-photo-modal-count></div>
        </div>

        <script>
          (function() {
            function initShopPhotoTabs() {
              document.querySelectorAll("[data-photo-tabs]").forEach(function(wrapper) {
                if (wrapper.dataset.photoTabsReady === "true") return;
                wrapper.dataset.photoTabsReady = "true";

                const buttons = wrapper.querySelectorAll("[data-photo-tab-button]");
                const panels = wrapper.querySelectorAll("[data-photo-tab-panel]");

                buttons.forEach(function(button) {
                  button.addEventListener("click", function() {
                    const key = button.getAttribute("data-photo-tab-key");

                    buttons.forEach(function(btn) {
                      const active = btn.getAttribute("data-photo-tab-key") === key;
                      btn.classList.toggle("is-active", active);
                      btn.setAttribute("aria-selected", active ? "true" : "false");
                    });

                    panels.forEach(function(panel) {
                      const active = panel.getAttribute("data-photo-tab-key") === key;
                      panel.classList.toggle("is-active", active);
                    });
                  });
                });
              });
            }

            function initShopPhotoModal() {
              const modal = document.querySelector("[data-photo-modal]");
              if (!modal || modal.dataset.ready === "true") return;
              modal.dataset.ready = "true";

              const openButtons = document.querySelectorAll("[data-photo-modal-open]");
              const closeButton = modal.querySelector("[data-photo-modal-close]");
              const prevButton = modal.querySelector("[data-photo-modal-prev]");
              const nextButton = modal.querySelector("[data-photo-modal-next]");
              const count = modal.querySelector("[data-photo-modal-count]");
              const viewports = modal.querySelectorAll("[data-photo-modal-viewport]");

              let activeViewport = null;

              function currentSlides() {
                return activeViewport ? activeViewport.querySelectorAll(".shop-photo-modal__slide") : [];
              }

              function currentIndex() {
                if (!activeViewport) return 0;
                return Math.round(activeViewport.scrollLeft / Math.max(activeViewport.clientWidth, 1));
              }

              function updateCount() {
                const slides = currentSlides();
                if (!count || !slides.length) return;
                count.textContent = (currentIndex() + 1) + " / " + slides.length;
              }

              function showGroup(groupKey) {
                viewports.forEach(function(viewport) {
                  const active = viewport.getAttribute("data-photo-group") === groupKey;
                  viewport.style.display = active ? "flex" : "none";
                  if (active) activeViewport = viewport;
                });
              }

              function scrollToIndex(index, behavior) {
                if (!activeViewport) return;
                activeViewport.scrollTo({
                  left: activeViewport.clientWidth * index,
                  behavior: behavior || "auto"
                });
                window.setTimeout(updateCount, behavior === "smooth" ? 220 : 30);
              }

              function openModal(groupKey, index) {
                showGroup(groupKey);
                modal.classList.add("is-open");
                modal.setAttribute("aria-hidden", "false");
                document.body.style.overflow = "hidden";

                window.requestAnimationFrame(function() {
                  scrollToIndex(index, "auto");
                  updateCount();
                });
              }

              function closeModal() {
                modal.classList.remove("is-open");
                modal.setAttribute("aria-hidden", "true");
                document.body.style.overflow = "";
              }

              openButtons.forEach(function(button) {
                button.addEventListener("click", function(event) {
                  event.preventDefault();
                  openModal(button.getAttribute("data-photo-group"), parseInt(button.getAttribute("data-photo-index"), 10) || 0);
                });
              });

              closeButton.addEventListener("click", closeModal);

              prevButton.addEventListener("click", function() {
                const slides = currentSlides();
                if (!slides.length) return;
                const nextIndex = currentIndex() <= 0 ? slides.length - 1 : currentIndex() - 1;
                scrollToIndex(nextIndex, "smooth");
              });

              nextButton.addEventListener("click", function() {
                const slides = currentSlides();
                if (!slides.length) return;
                const nextIndex = currentIndex() >= slides.length - 1 ? 0 : currentIndex() + 1;
                scrollToIndex(nextIndex, "smooth");
              });

              viewports.forEach(function(viewport) {
                viewport.addEventListener("scroll", function() {
                  window.clearTimeout(viewport._countTimer);
                  viewport._countTimer = window.setTimeout(updateCount, 80);
                }, { passive: true });
              });

              modal.addEventListener("click", function(event) {
                if (event.target === modal) closeModal();
              });

              document.addEventListener("keydown", function(event) {
                if (!modal.classList.contains("is-open")) return;

                if (event.key === "Escape") closeModal();
                if (event.key === "ArrowLeft") prevButton.click();
                if (event.key === "ArrowRight") nextButton.click();
              });

              document.addEventListener("turbo:before-cache", function() {
                closeModal();
              });
            }

            document.addEventListener("turbo:load", function() {
              initShopPhotoTabs();
              initShopPhotoModal();
            });

            document.addEventListener("DOMContentLoaded", function() {
              initShopPhotoTabs();
              initShopPhotoModal();
            });

            initShopPhotoTabs();
            initShopPhotoModal();
          })();
        </script>
      </section>

