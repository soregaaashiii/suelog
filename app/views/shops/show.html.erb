@media (min-width: 721px) {
  .shop-show__photoGrid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

@media (max-width: 720px) {
  .shop-show__hero,
  .shop-show__section {
    border-radius: 6px;
    padding: 14px;
  }

  .shop-show__infoRow {
    grid-template-columns: 96px minmax(0, 1fr);
  }

  .shop-show__infoHead {
    padding: 6px 6px;
    font-size: 10px;
  }

  .shop-show__infoCell {
    padding: 6px 8px;
    font-size: 12px;
    line-height: 1.45;
  }

  .shop-show__footerActions,
  .shop-show__relatedLinks,
  .shop-show__bookingActions {
    flex-direction: column;
  }

  .ss-btn {
    width: 100%;
  }

  .shop-show__photo {
    width: calc(50% - 5px);
    height: 140px;
  }

  .shop-show__sectionHeader {
    align-items: flex-start;
    flex-direction: column;
  }
}
</style>

<div class="shop-show">
  <nav class="shop-show__breadcrumb" aria-label="パンくず">
    <%= link_to "ホーム", root_path %>

    <% if is_umeda_shop %>
      <span> › </span>
      <%= link_to "梅田で喫煙できる店", umeda_path %>
    <% elsif is_namba_shop %>
      <span> › </span>
      <%= link_to "難波で喫煙できる店", namba_path %>
    <% end %>

    <span> › </span>
    <span class="shop-show__breadcrumbCurrent"><%= @shop.name %></span>
  </nav>

  <div class="shop-show__back">
    <%= link_to back_label, back_path, class: "shop-show__backLink" %>
  </div>

  <section class="shop-show__hero">
    <h1 class="shop-show__title"><%= @shop.name %></h1>
    <p class="shop-show__sub">
      ジャンル：<%= @shop.display_genre.presence || "未設定" %>
    </p>

    <div class="shop-show__badges">
      <% if @shop.smoking_area == "all_smoking" %>
        <span class="ss-badge ss-badge--dark">席で喫煙可</span>
      <% elsif @shop.smoking_area == "separated" %>
        <span class="ss-badge ss-badge--line">喫煙所あり</span>
      <% elsif @shop.smoking_area == "unknown" %>
        <span class="ss-badge ss-badge--muted">喫煙エリア不明</span>
      <% end %>

      <% if @shop.smoking_type == "both_ok" %>
        <span class="ss-badge ss-badge--gold">紙・加熱式OK</span>
      <% elsif @shop.smoking_type == "electronic_only" %>
        <span class="ss-badge ss-badge--gold">加熱式のみ</span>
      <% elsif @shop.smoking_type == "paper_only" %>
        <span class="ss-badge ss-badge--gold">紙のみ</span>
      <% elsif @shop.smoking_type == "unknown" %>
        <span class="ss-badge ss-badge--muted">喫煙タイプ不明</span>
      <% end %>

      <% if @shop.respond_to?(:secondary_smoking_condition?) && @shop.secondary_smoking_condition? %>
        <span class="ss-badge <%= @shop.smoking_area_2 == 'all_smoking' ? 'ss-badge--dark' : 'ss-badge--line' %>"><%= @shop.smoking_area_2_label %></span>
        <span class="ss-badge ss-badge--gold"><%= @shop.smoking_type_2_label %></span>
      <% end %>

      <% if @shop.respond_to?(:open_now?) && @shop.open_now? %>
        <span class="ss-badge ss-badge--green">
          営業中
          <% if @shop.respond_to?(:display_opening_hours_text) && @shop.display_opening_hours_text.present? %>
            （本日営業）
          <% end %>
        </span>
      <% end %>

      <% if @shop.respond_to?(:smoking_unverified?) && !@shop.smoking_unverified? %>
        <span class="ss-badge ss-badge--green">喫煙情報確認済み</span>
      <% end %>

      <% if @shop.last_confirmed_on.present? %>
        <span class="ss-badge ss-badge--line">最終確認：<%= @shop.last_confirmed_on %></span>
      <% end %>

      <% hero_reviews_count = @approved_reviews.size %>
      <% if hero_reviews_count.positive? %>
        <% hero_average_rating = (@approved_reviews.sum { |r| r.rating.to_f } / hero_reviews_count).round(1) %>
        <span class="ss-badge ss-badge--gold">
          ★<%= hero_average_rating %>・口コミ<%= hero_reviews_count %>件
        </span>
      <% end %>
    </div>

    <% if booking_links.present? || (@shop.phone.present? && tel_target_url.present?) || @shop.address.present? %>
      <div class="shop-show__heroActions shop-show__heroActions--fv">
        <% booking_links.each do |booking_link| %>
          <%= link_to booking_link[:url],
                      target: "_blank",
                      rel: "sponsored nofollow noopener",
                      class: "ss-btn shop-show__cvPrimary shop-show__cvPrimary--#{booking_link[:provider]} shop-show__fvPrimary" do %>

            <span class="shop-show__cvPrimaryLabel">
              <span><%= booking_link[:label] %></span>

              <% if booking_link[:provider_label].present? %>
                <span class="shop-show__cvPrimaryProvider">
                  <%= booking_link[:provider_label] %>
                </span>
              <% end %>
            </span>
          <% end %>
        <% end %>

        <% if @shop.phone.present? && tel_target_url.present? %>
          <%= link_to "電話する",
                      track_click_shop_path(@shop, kind: "phone_click", target_url: tel_target_url),
                      class: "ss-btn ss-btn--ghost shop-show__cvSub shop-show__fvSub" %>
        <% end %>

        <% if @shop.address.present? %>
          <%= link_to "地図を見る",
                      track_click_shop_path(@shop, kind: "map_click", target_url: map_target_url),
                      target: "_blank",
                      rel: "noopener",
                      class: "ss-btn ss-btn--ghost shop-show__cvSub shop-show__fvSub" %>
        <% end %>
      </div>

      <p class="shop-show__heroCtaNote">
        来店前に、喫煙可否・営業時間・場所を確認しておくと安心です。
      </p>
    <% end %>
  </section>

  <section class="shop-show__section shop-show__quickActions">
    <div class="shop-show__quickActionsInner">
      <%= link_to "今営業中の喫煙可",
                  root_path(open_now: 1),
                  class: "ss-btn ss-btn--dark shop-show__quickAction shop-show__quickAction--primary" %>

      <%= link_to "席で吸える店だけ",
                  root_path(smoking_area: "all_smoking"),
                  class: "ss-btn ss-btn--ghost shop-show__quickAction" %>

      <% if @shop.latitude.present? && @shop.longitude.present? %>
        <%= link_to "近くで探す",
                    map_path(lat: @shop.latitude, lng: @shop.longitude),
                    class: "ss-btn ss-btn--ghost shop-show__quickAction" %>
      <% end %>
    </div>
  </section>

  <% if flash[:notice].present? %>
    <div class="ss-alert ss-alert--notice"><%= flash[:notice] %></div>
  <% end %>

  <% if flash[:alert].present? %>
    <div class="ss-alert ss-alert--alert"><%= flash[:alert] %></div>
  <% end %>

  <% if @shop.respond_to?(:smoking_unverified?) && @shop.smoking_unverified? %>
    <div class="ss-alert ss-alert--warn">
      この店舗の喫煙情報は未確認です。来店前に店舗へご確認ください。
    </div>
  <% end %>

  <div class="shop-show__layout">
    <section class="shop-show__section shop-show__section--table">
      <h2 class="shop-show__sectionTitle shop-show__sectionTitle--table">基本情報</h2>

      <div class="shop-show__infoTable">
        <div class="shop-show__infoRow">
          <div class="shop-show__infoHead">住所</div>
          <div class="shop-show__infoCell"><%= @shop.address.presence || "未設定" %></div>
        </div>

        <div class="shop-show__infoRow">
          <div class="shop-show__infoHead">最寄駅</div>
          <div class="shop-show__infoCell">
            <%= @shop.nearest_station.presence || "未設定" %>

            <% if is_umeda_shop %>
              <div class="shop-show__microLinks">
                 <%= link_to "梅田で喫煙できる店", umeda_path, class: "shop-show__microLink" %>
                <%= link_to "今営業中 × 席で喫煙可", umeda_smoking_path("all_smoking", open_now: 1), class: "shop-show__microLink" %>
                <%= link_to "今営業中 × 喫煙所あり", umeda_smoking_path("separated", open_now: 1), class: "shop-show__microLink" %>
              </div>
            <% elsif is_namba_shop %>
              <div class="shop-show__microLinks">
                <%= link_to "難波で喫煙できる店", namba_path, class: "shop-show__microLink" %>
                <%= link_to "今営業中 × 席で喫煙可", namba_smoking_path("all_smoking", open_now: 1), class: "shop-show__microLink" %>
                <%= link_to "今営業中 × 喫煙所あり", namba_smoking_path("separated", open_now: 1), class: "shop-show__microLink" %>
              </div>
            <% end %>
          </div>
        </div>

        <div class="shop-show__infoRow">
          <div class="shop-show__infoHead">電話番号</div>
          <div class="shop-show__infoCell">
            <% if @shop.phone.present? && tel_target_url.present? %>
              <%= link_to @shop.phone,
                          track_click_shop_path(@shop, kind: "phone_click", target_url: tel_target_url),
                          class: "shop-show__phoneLink" %>
            <% else %>
              未設定
            <% end %>
          </div>
        </div>

        <div class="shop-show__infoRow">
          <div class="shop-show__infoHead">ジャンル</div>
          <div class="shop-show__infoCell">
            <%= @shop.respond_to?(:display_genre) ? @shop.display_genre.presence || "未設定" : @shop.genre.presence || "未設定" %>
          </div>
        </div>

        <div class="shop-show__infoRow">
          <div class="shop-show__infoHead">喫煙エリア</div>
          <div class="shop-show__infoCell">
            <%= @shop.respond_to?(:smoking_area_label) ? @shop.smoking_area_label : "未設定" %>
          </div>
        </div>

        <div class="shop-show__infoRow">
          <div class="shop-show__infoHead">喫煙タイプ</div>
          <div class="shop-show__infoCell">
            <%= @shop.respond_to?(:smoking_type_label) ? @shop.smoking_type_label : "未設定" %>
          </div>
        </div>

        <% if @shop.respond_to?(:secondary_smoking_condition?) && @shop.secondary_smoking_condition? %>
          <div class="shop-show__infoRow">
            <div class="shop-show__infoHead">喫煙条件2</div>
            <div class="shop-show__infoCell"><%= @shop.smoking_area_2_label %>／<%= @shop.smoking_type_2_label %></div>
          </div>
        <% end %>

        <% if @shop.respond_to?(:smoking_unverified?) && @shop.smoking_unverified? %>
          <div class="shop-show__infoRow">
            <div class="shop-show__infoHead">喫煙情報ステータス</div>
            <div class="shop-show__infoCell">未確認</div>
          </div>
        <% end %>

        <% if @shop.respond_to?(:budget_range) && @shop.budget_range.present? %>
          <div class="shop-show__infoRow">
            <div class="shop-show__infoHead">平均予算</div>
            <div class="shop-show__infoCell"><%= @shop.budget_range %></div>
          </div>
        <% end %>

        <% if @shop.respond_to?(:private_room_label) && @shop.private_room_type.to_s != "unknown" %>
