@media (max-width: 720px) {
.shop-show__hero,
.shop-show__section {
border-radius: 16px;
padding: 16px;
}

.shop-show__metaGrid {
grid-template-columns: 1fr;
}

.shop-show__footerActions {
flex-direction: column;
}

.ss-btn {
width: 100%;
}

.shop-show__photo {
width: calc(50% - 5px);
height: 140px;
}
}
</style>

<div class="shop-show">
<div class="shop-show__back">
<%= link_to "← 一覧に戻る", root_path, class: "shop-show__backLink" %>
</div>

<section class="shop-show__hero">
<h1 class="shop-show__title"><%= @shop.name %></h1>
<p class="shop-show__sub">
ジャンル：<%= @shop.display_genre.presence || "未設定" %>
</p>

<div class="shop-show__badges">
<% if @shop.smoking_area == "all_smoking" %>
<span class="ss-badge ss-badge--dark">席で喫煙可</span>
<% elsif @shop.smoking_area == "separated" %>
<span class="ss-badge ss-badge--line">喫煙所あり</span>
<% end %>

<% if @shop.smoking_type == "both_ok" %>
<span class="ss-badge ss-badge--gold">紙・加熱式OK</span>
<% elsif @shop.smoking_type == "electronic_only" %>
<span class="ss-badge ss-badge--gold">加熱式のみ</span>
<% elsif @shop.smoking_type == "paper_only" %>
<span class="ss-badge ss-badge--gold">紙のみ</span>
<% end %>

<% if @shop.open_now? %>
<span class="ss-badge ss-badge--green">営業中</span>
<% end %>

<% if @shop.last_confirmed_on.present? %>
<span class="ss-badge ss-badge--line">最終確認：<%= @shop.last_confirmed_on %></span>
<% end %>
</div>

<p class="shop-show__lead">
<%= @shop.name %>は
<%= @shop.smoking_area_label %>、
<%= @shop.smoking_type_label %>の店舗です。
<% if @shop.nearest_station.present? %>
最寄駅は<%= @shop.nearest_station %>。
<% end %>
<% if @shop.display_opening_hours_text.present? && @shop.display_opening_hours_text != "未設定" %>
通常営業時間は「<%= @shop.display_opening_hours_text %>」です。
<% end %>
大阪で喫煙できる飲食店を探している方の参考用ページです。
</p>
</section>

<% if flash[:notice].present? %>
<div class="ss-alert ss-alert--notice"><%= flash[:notice] %></div>
<% end %>

<% if flash[:alert].present? %>
<div class="ss-alert ss-alert--alert"><%= flash[:alert] %></div>
<% end %>

<div class="shop-show__layout">
<section class="shop-show__section">
<h2 class="shop-show__sectionTitle">基本情報</h2>

<div class="shop-show__metaGrid">
<div class="shop-show__metaItem">
<span class="shop-show__metaLabel">住所</span>
<div class="shop-show__metaValue"><%= @shop.address.presence || "未設定" %></div>
</div>

<div class="shop-show__metaItem">
<span class="shop-show__metaLabel">最寄駅</span>
<div class="shop-show__metaValue"><%= @shop.nearest_station.presence || "未設定" %></div>
</div>

<div class="shop-show__metaItem">
<span class="shop-show__metaLabel">電話番号</span>
<div class="shop-show__metaValue">
<% if @shop.phone.present? %>
<a href="tel:<%= @shop.phone.gsub(/[^0-9]/, "") %>" class="shop-show__phoneLink">
<%= @shop.phone %>
</a>
<% else %>
未設定
<% end %>
</div>
</div>

<div class="shop-show__metaItem">
<span class="shop-show__metaLabel">喫煙エリア</span>
<div class="shop-show__metaValue"><%= @shop.smoking_area_label %></div>
</div>

<div class="shop-show__metaItem">
<span class="shop-show__metaLabel">喫煙タイプ</span>
<div class="shop-show__metaValue"><%= @shop.smoking_type_label %></div>
</div>
</div>
</section>

<section class="shop-show__section">
<h2 class="shop-show__sectionTitle">営業時間</h2>

<div class="shop-show__hoursBox">
<div class="shop-show__hoursCard">
<p class="shop-show__hoursCardTitle">通常営業時間</p>
<div class="shop-show__hoursCardValue"><%= @shop.display_opening_hours_text %></div>
</div>

<div class="shop-show__hoursCard">
<p class="shop-show__hoursCardTitle">祝日営業時間</p>
<div class="shop-show__hoursCardValue"><%= @shop.display_holiday_hours_text %></div>
</div>

<div class="shop-show__hoursCard">
<p class="shop-show__hoursCardTitle">定休日</p>
<div class="shop-show__hoursCardValue"><%= @shop.display_closed_days_text %></div>
</div>
</div>

<p class="shop-show__hoursNote">
※ 営業時間は店舗情報・ユーザー投稿を元に表示しています
</p>
</section>

<% unless @shop.approved? %>
<section class="shop-show__section">
<div class="ss-pending">
<p class="ss-pending__title">この店舗は承認待ちです</p>
<p class="ss-pending__text">※ 詳細（地図・写真・口コミ・メモ等）は確認後に公開されます</p>
</div>
</section>
<% else %>
<section class="shop-show__section">
<h2 class="shop-show__sectionTitle">補足情報</h2>

<div class="shop-show__metaGrid">
<div class="shop-show__metaItem">
<span class="shop-show__metaLabel">メモ</span>
<div class="shop-show__metaValue"><%= @shop.note.presence || "未設定" %></div>
</div>

<div class="shop-show__metaItem">
<span class="shop-show__metaLabel">最終確認日</span>
<div class="shop-show__metaValue"><%= @shop.last_confirmed_on.presence || "未設定" %></div>
</div>
</div>
</section>

<section class="shop-show__section">
<h2 class="shop-show__sectionTitle">地図</h2>

<% if @shop.latitude.present? && @shop.longitude.present? %>
<div id="shop-map" class="shop-show__map"></div>

<p class="shop-show__mapLink">
<% q = ERB::Util.url_encode([@shop.name, @shop.address].compact.join(" ")) %>
<a href="https://www.google.com/maps?q=<%= q %>" target="_blank" rel="noopener">Googleマップで開く</a>
</p>

<script>
(function() {
function loadLeafletCss() {
if (document.getElementById("leaflet-css")) return;
const link = document.createElement("link");
link.id = "leaflet-css";
link.rel = "stylesheet";
link.href = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css";
document.head.appendChild(link);
}

function loadLeafletJs(callback) {
if (window.L) {
callback();
return;
}

if (document.getElementById("leaflet-js")) {
document.getElementById("leaflet-js").addEventListener("load", callback, { once: true });
return;
}

const script = document.createElement("script");
script.id = "leaflet-js";
script.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
script.async = true;
script.onload = callback;
document.body.appendChild(script);
}

function initShopMap() {
const el = document.getElementById("shop-map");
if (!el || !window.L) return;

if (el._leaflet_map_instance) {
el._leaflet_map_instance.remove();
el._leaflet_map_instance = null;
}

const lat = <%= @shop.latitude.to_f %>;
const lng = <%= @shop.longitude.to_f %>;

const map = L.map(el).setView([lat, lng], 16);
el._leaflet_map_instance = map;

L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
maxZoom: 19,
attribution: '&copy; OpenStreetMap contributors'
}).addTo(map);

const marker = L.marker([lat, lng]).addTo(map);
marker.bindPopup("<strong><%= j @shop.name %></strong>").openPopup();

setTimeout(() => map.invalidateSize(), 50);
setTimeout(() => map.invalidateSize(), 300);
}

function bootShopMap() {
loadLeafletCss();
loadLeafletJs(initShopMap);
}

document.addEventListener("turbo:load", bootShopMap);
document.addEventListener("DOMContentLoaded", bootShopMap);
document.addEventListener("turbo:before-cache", () => {
const el = document.getElementById("shop-map");
if (el && el._leaflet_map_instance) {
el._leaflet_map_instance.remove();
el._leaflet_map_instance = null;
}
});

bootShopMap();
})();
</script>
<% else %>
<p style="color:#666;">この店舗は位置情報（緯度・経度）が未設定です。</p>
<% end %>
</section>

<section class="shop-show__section">
<h2 class="shop-show__sectionTitle">写真</h2>

<% [["料理", @shop.food_photos], ["内観", @shop.interior_photos], ["外観", @shop.exterior_photos], ["メニュー", @shop.menu_photos]].each do |label, photos| %>
<div class="shop-show__photosGroup">
<h3 class="shop-show__photosTitle"><%= label %></h3>

<% if photos.attached? %>
<div class="shop-show__photosGrid">
<% photos.each do |p| %>
<%= image_tag url_for(p), class: "shop-show__photo" %>
<% end %>
</div>
<% else %>
<p style="color:#666;">まだありません</p>
<% end %>
</div>
<% end %>
</section>
<% end %>

<hr class="shop-show__divider">

<section class="shop-show__section">
<h2 class="shop-show__sectionTitle">このページについて</h2>
<div class="shop-show__footerActions">
<%= link_to "一覧に戻る", root_path, class: "ss-btn ss-btn--ghost" %>
<%= link_to "情報の修正依頼", new_shop_shop_edit_request_path(@shop), class: "ss-btn ss-btn--dark" %>
<%= link_to "通報", new_shop_shop_report_path(@shop), class: "ss-btn ss-btn--muted" %>
</div>
</section>
</div>
</div>