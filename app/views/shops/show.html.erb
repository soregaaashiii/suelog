<%# /Users/kawamuratakuya/dev/suelog/app/views/shops/show.html.erb %>

<%
  shop_location_text = [@shop.area, @shop.address, @shop.nearest_station, @shop.name].compact.join(" ")
  is_umeda_shop = shop_location_text.include?("梅田")
  is_namba_shop = shop_location_text.include?("難波") || shop_location_text.include?("なんば")

  area_label =
    if is_umeda_shop
      "梅田"
    elsif is_namba_shop
      "難波"
    elsif @shop.area.present?
      @shop.area
    else
      "大阪"
    end

  genre_label_text =
    if @shop.respond_to?(:display_genre) && @shop.display_genre.present?
      @shop.display_genre
    elsif @shop.genre.present?
      @shop.genre
    else
      "飲食店"
    end

  smoking_area_text =
    if @shop.respond_to?(:smoking_area_label) && @shop.smoking_area_label.present?
      @shop.smoking_area_label
    else
      nil
    end

  smoking_type_text =
    if @shop.respond_to?(:smoking_type_label) && @shop.smoking_type_label.present?
      @shop.smoking_type_label
    else
      nil
    end

  seo_area_title =
    if shop_location_text.include?("東通り") || shop_location_text.include?("堂山")
      "#{area_label}・東通り"
    else
      area_label
    end

  seo_smoking_title =
    if @shop.respond_to?(:smoking_unverified?) && @shop.smoking_unverified?
      "喫煙情報確認中"
    elsif @shop.smoking_area.to_s == "all_smoking"
      case @shop.smoking_type.to_s
      when "both_ok"
        "席で喫煙可・紙加熱式OK"
      when "paper_only"
        "席で喫煙可・紙タバコOK"
      when "electronic_only"
        "席で喫煙可・加熱式たばこOK"
      else
        "席で喫煙可"
      end
    elsif @shop.smoking_area.to_s == "separated"
      "喫煙所あり"
    else
      "喫煙情報確認中"
    end

  page_title_parts = [
    "#{@shop.name.presence}｜#{seo_area_title}の#{genre_label_text}【#{seo_smoking_title}】",
    "吸えログ"
  ].compact

  seo_station_text =
    if @shop.nearest_station.present?
      "#{@shop.nearest_station}近く"
    else
      "#{seo_area_title}"
    end

  page_description_parts = []

  if @shop.name.present?
    page_description_parts << "#{@shop.name}は#{seo_station_text}の#{genre_label_text}です。"
  end

  page_description_parts << seo_smoking_title

  if @shop.respond_to?(:smoking_unverified?) && @shop.smoking_unverified?
    page_description_parts << "喫煙情報は確認中のため、最新情報は店舗へご確認ください。"
  elsif @shop.respond_to?(:smoking_unverified?) && !@shop.smoking_unverified?
    page_description_parts << "喫煙情報確認済み。"
  end

  if @shop.respond_to?(:display_opening_hours_text) &&
     @shop.display_opening_hours_text.present? &&
     @shop.display_opening_hours_text != "未設定"

    page_description_parts << "営業時間：#{@shop.display_opening_hours_text}"
  end

  page_description_parts << "住所：#{@shop.address}" if @shop.address.present?

  page_description_parts << "#{seo_area_title}で喫煙できる#{genre_label_text}を探すなら吸えログ。"

  referrer_path = nil

  if request.referer.present?
    begin
      referrer_uri = URI.parse(request.referer)
      referrer_path = referrer_uri.path if referrer_uri.host == request.host && referrer_uri.path != request.path
    rescue URI::InvalidURIError
      referrer_path = nil
    end
  end

  back_path =
    if referrer_path.present?
      request.referer
    elsif is_umeda_shop
      umeda_path
    elsif is_namba_shop
      namba_path
    else
      root_path
    end

  back_label =
    if referrer_path == root_path
      "← ホームに戻る"
    elsif referrer_path&.start_with?("/umeda")
      "← 梅田の一覧に戻る"
    elsif referrer_path&.start_with?("/namba")
      "← 難波の一覧に戻る"
    elsif referrer_path.present?
      "← 前のページに戻る"
    elsif is_umeda_shop
      "← 梅田の一覧に戻る"
    elsif is_namba_shop
      "← 難波の一覧に戻る"
    else
      "← 一覧に戻る"
    end

  footer_back_label =
    if referrer_path == root_path
      "ホームに戻る"
    elsif referrer_path&.start_with?("/umeda")
      "梅田の一覧に戻る"
    elsif referrer_path&.start_with?("/namba")
      "難波の一覧に戻る"
    elsif referrer_path.present?
      "前のページに戻る"
    elsif is_umeda_shop
      "梅田の一覧に戻る"
    elsif is_namba_shop
      "難波の一覧に戻る"
    else
      "一覧に戻る"
    end

  tel_digits = @shop.phone.to_s.gsub(/[^0-9]/, "")
  tel_target_url = tel_digits.present? ? "tel:#{tel_digits}" : nil
  map_query = ERB::Util.url_encode([@shop.name, @shop.address].compact.join(" "))
  address_query = ERB::Util.url_encode(@shop.address.to_s)
  google_map_query_url = "https://www.google.com/maps?q=#{map_query}"
  google_map_search_url = "https://www.google.com/maps/search/?api=1&query=#{address_query}"
  map_target_url = @shop.address.present? ? google_map_search_url : google_map_query_url

  custom_affiliate_track_url =
    if @shop.respond_to?(:custom_affiliate_url) && @shop.custom_affiliate_url.present?
      track_click_shop_path(@shop, kind: "affiliate_click", target_url: @shop.custom_affiliate_url)
    end

  tabelog_track_url =
    if @shop.respond_to?(:tabelog_affiliate_url) && @shop.tabelog_affiliate_url.present?
      track_click_shop_path(@shop, kind: "affiliate_click", target_url: @shop.tabelog_affiliate_url)

    elsif @shop.respond_to?(:tabelog_url) &&
          @shop.tabelog_url.to_s.start_with?("http") &&
          !@shop.tabelog_url.to_s.include?("not-found.local")
      track_click_shop_path(@shop, kind: "affiliate_click", target_url: @shop.tabelog_url)
    end

  hotpepper_track_url =
    if @shop.respond_to?(:hotpepper_url) && @shop.hotpepper_url.present?
      track_click_shop_path(@shop, kind: "affiliate_click", target_url: @shop.hotpepper_url)
    end

  booking_links = []

  if custom_affiliate_track_url.present?
    booking_links << {
      url: custom_affiliate_track_url,
      provider: "custom",
      provider_label: @shop.custom_affiliate_label.presence || "公式サイト",
      label: "空席を確認"
    }
  end

  if hotpepper_track_url.present?
    booking_links << {
      url: hotpepper_track_url,
      provider: "hotpepper",
      provider_label: "HotPepper",
      label: "空席を確認"
    }
  end

  if tabelog_track_url.present?
    booking_links << {
      url: tabelog_track_url,
      provider: "tabelog",
      provider_label: "食べログ",
      label: "空席を確認"
    }
  end

  primary_booking_url = booking_links.first&.dig(:url)

  related_area_links = []

  if is_umeda_shop
    related_area_links << ["梅田で喫煙できる店一覧", umeda_path]
    related_area_links << ["梅田で席で喫煙可", umeda_smoking_path("all_smoking")]
    related_area_links << ["梅田で喫煙所あり", umeda_smoking_path("separated")]
  elsif is_namba_shop
    related_area_links << ["難波で喫煙できる店一覧", namba_path]
    related_area_links << ["難波で席で喫煙可", namba_smoking_path("all_smoking")]
    related_area_links << ["難波で喫煙所あり", namba_smoking_path("separated")]
  end

  related_genre_slug =
    if genre_label_text.include?("居酒屋")
      "izakaya"
    elsif genre_label_text.match?(/バー|パブ|ハブ|ラウンジ/)
      "bar"
    elsif genre_label_text.match?(/カフェ|喫茶/)
      "cafe"
    elsif genre_label_text.include?("焼肉")
      "yakiniku"
    else
      nil
    end

  if related_genre_slug.present?
    if is_umeda_shop
      related_area_links << ["梅田の#{genre_label_text}", umeda_genre_path(related_genre_slug)]
    elsif is_namba_shop
      related_area_links << ["難波の#{genre_label_text}", namba_genre_path(related_genre_slug)]
    end
  end
%>

<% content_for :title, page_title_parts.join("｜") %>
<% content_for :meta_description, page_description_parts.join(" ") %>
<% content_for :canonical_url, shop_url(@shop) %>

<% shop_photo_groups = [
  { key: "all", label: "すべて", photos: (@shop.food_photos.to_a + @shop.interior_photos.to_a + @shop.exterior_photos.to_a + @shop.menu_photos.to_a) },
  { key: "food", label: "料理", photos: @shop.food_photos.to_a },
  { key: "interior", label: "内観", photos: @shop.interior_photos.to_a },
  { key: "exterior", label: "外観", photos: @shop.exterior_photos.to_a },
  { key: "menu", label: "メニュー", photos: @shop.menu_photos.to_a }
] %>

<% total_shop_photos_count = shop_photo_groups.reject { |group| group[:key] == "all" }.sum { |group| group[:photos].size } %>

<% content_for :head do %>
  <% photo_url = nil %>
  <% if @shop.respond_to?(:food_photos) && @shop.food_photos.attached? %>
    <% photo_url = url_for(@shop.food_photos.first) rescue nil %>
  <% elsif @shop.respond_to?(:exterior_photos) && @shop.exterior_photos.attached? %>
    <% photo_url = url_for(@shop.exterior_photos.first) rescue nil %>
  <% elsif @shop.respond_to?(:interior_photos) && @shop.interior_photos.attached? %>
    <% photo_url = url_for(@shop.interior_photos.first) rescue nil %>
  <% elsif @shop.respond_to?(:menu_photos) && @shop.menu_photos.attached? %>
    <% photo_url = url_for(@shop.menu_photos.first) rescue nil %>
  <% end %>

  <% restaurant_structured_data = {
    "@context": "https://schema.org",
    "@type": "Restaurant",
    "name": @shop.name,
    "url": shop_url(@shop),
    "image": photo_url,
    "telephone": @shop.phone.presence,
    "address": (@shop.address.present? ? {
      "@type": "PostalAddress",
      "streetAddress": @shop.address,
      "addressRegion": "大阪府",
      "addressCountry": "JP"
    } : nil),
    "servesCuisine": @shop.display_genre.presence,
    "description": page_description_parts.join(" "),
    "smokingAllowed": (@shop.smoking_area == "all_smoking"),
    "keywords": [
      (@shop.smoking_area_label if @shop.respond_to?(:smoking_area_label)),
      (@shop.smoking_type_label if @shop.respond_to?(:smoking_type_label)),
      @shop.display_genre.presence,
      @shop.nearest_station.presence,
      area_label,
      "喫煙可"
    ].compact.join(", "),
    "geo": (@shop.latitude.present? && @shop.longitude.present? ? {
      "@type": "GeoCoordinates",
      "latitude": @shop.latitude,
      "longitude": @shop.longitude
    } : nil)
  }.compact %>

  <% breadcrumb_items = [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "ホーム",
      "item": root_url
    }
  ] %>

  <% if is_umeda_shop %>
    <% breadcrumb_items << {
      "@type": "ListItem",
      "position": 2,
      "name": "梅田で喫煙できる店",
      "item": umeda_url
    } %>
    <% breadcrumb_items << {
      "@type": "ListItem",
      "position": 3,
      "name": @shop.name
    } %>
  <% elsif is_namba_shop %>
    <% breadcrumb_items << {
      "@type": "ListItem",
      "position": 2,
      "name": "難波で喫煙できる店",
      "item": namba_url
    } %>
    <% breadcrumb_items << {
      "@type": "ListItem",
      "position": 3,
      "name": @shop.name
    } %>
  <% else %>
    <% breadcrumb_items << {
      "@type": "ListItem",
      "position": 2,
      "name": @shop.name
    } %>
  <% end %>

  <% breadcrumb_structured_data = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumb_items
  } %>

  <script type="application/ld+json">
    <%= raw restaurant_structured_data.to_json %>
  </script>

  <script type="application/ld+json">
    <%= raw breadcrumb_structured_data.to_json %>
  </script>
<% end %>

<style>
.shop-show {
  max-width: 980px;
  margin: 0 auto;
}

.shop-show__breadcrumb {
  margin: 0 0 14px;
  font-size: 13px;
  color: #666666;
  line-height: 1.7;
}

.shop-show__breadcrumb a {
  color: #666666;
  text-decoration: none;
}

.shop-show__breadcrumbCurrent {
  color: #111111;
  font-weight: 700;
}

.shop-show__back {
  margin: 0 0 14px;
}

.shop-show__backLink {
  display: inline-flex;
  align-items: center;
  color: #6b6b6b;
  text-decoration: none;
  font-weight: 700;
}

.shop-show__backLink:hover {
  color: #111111;
}

.shop-show__hero {
  position: relative;
  overflow: hidden;
  background: #fffdf8;
  border: 1px solid #e8e3d7;
  border-radius: 6px;
  padding: 20px 18px 18px;
  box-shadow: 0 10px 30px rgba(17, 17, 17, 0.04);
  margin-bottom: 16px;
}

.shop-show__hero::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, #111111 0%, #c6a75e 100%);
}

.shop-show__title {
  margin: 0 0 8px;
  font-size: clamp(28px, 4vw, 40px);
  line-height: 1.15;
  letter-spacing: -0.03em;
  color: #111111;
}

.shop-show__sub {
  margin: 0;
  color: #7a7a7a;
  font-size: 13px;
}

.shop-show__badges {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 12px;
}

.shop-show__layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 16px;
}

.shop-show__section {
  background: #ffffff;
  border: 1px solid #e8e3d7;
  border-radius: 6px;
  padding: 18px;
  box-shadow: 0 10px 30px rgba(17, 17, 17, 0.03);
}

.shop-show__sectionTitle {
  margin: 0 0 14px;
  font-size: 20px;
  font-weight: 800;
  color: #111111;
  letter-spacing: -0.02em;
}

.shop-show__sectionHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 14px;
}

.shop-show__sectionMeta {
  color: #666666;
  font-size: 13px;
  font-weight: 700;
}

.shop-show__infoTable {
  border-top: 1px solid #ece6d8;
  border-bottom: 1px solid #ece6d8;
  background: #ffffff;
}

.shop-show__infoRow {
  display: grid;
  grid-template-columns: 150px minmax(0, 1fr);
  border-top: 1px solid #ece6d8;
  min-height: unset;
}

.shop-show__infoRow:first-child {
  border-top: 0;
}

.shop-show__infoHead {
  padding: 6px 8px;
  background: #faf8f2;
  color: #6f6f6f;
  font-size: 11px;
  font-weight: 700;
  line-height: 1.35;
  border-right: 1px solid #ece6d8;
}

.shop-show__infoCell {
  padding: 6px 8px;
  color: #111111;
  font-size: 13px;
  line-height: 1.4;
  word-break: break-word;
  white-space: normal;
  background: #ffffff;
}

.shop-show__infoCell--multiline {
  white-space: pre-wrap;
}

.shop-show__hoursBox {
  display: grid;
  gap: 12px;
}

.shop-show__hoursCard {
  background: #faf8f2;
  border: 1px solid #eee6d6;
  border-radius: 16px;
  padding: 14px;
}

.shop-show__hoursCardTitle {
  margin: 0 0 6px;
  color: #7a7a7a;
  font-size: 12px;
  font-weight: 700;
}

.shop-show__hoursCardValue {
  color: #111111;
  font-size: 15px;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
}

.shop-show__hoursNote {
  margin-top: 8px;
  color: #777777;
  font-size: 12px;
}

.shop-show__phoneLink {
  display: inline;
  color: #1f4ea3;
  text-decoration: none;
  font-weight: 700;
  line-height: 1.3;
}

.shop-show__phoneLink:hover {
  text-decoration: underline;
}

.shop-show__bookingActions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 8px;
}

.shop-show__bookingSection {
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at top right, rgba(198, 167, 94, 0.12), transparent 34%),
    linear-gradient(135deg, #fffdf8 0%, #ffffff 72%);
}

.shop-show__bookingHead {
  margin-bottom: 14px;
}

.shop-show__bookingLead {
  margin: 6px 0 0;
  color: #666666;
  font-size: 13px;
  line-height: 1.7;
}

.shop-show__bookingMain {
  display: grid;
  gap: 10px;
  margin-top: 12px;
}

.shop-show__bookingPrimary {
  width: 100%;
  min-height: 54px;
  font-size: 16px;
}

.shop-show__bookingSubActions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  margin-top: 10px;
}

.shop-show__bookingSub {
  min-height: 44px;
}

.shop-show__visitCheck {
  margin-top: 12px;
  padding: 12px;
  border: 1px solid #eee6d6;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.72);
}

.shop-show__visitCheckTitle {
  margin: 0 0 4px;
  color: #111111;
  font-size: 13px;
  font-weight: 900;
}

.shop-show__visitCheckText {
  margin: 0;
  color: #666666;
  font-size: 12px;
  line-height: 1.7;
}

.shop-show__heroActions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 16px;
}

.shop-show__heroActions--fv {
  align-items: center;
  margin-top: 18px;
}

.shop-show__fvPrimary {
  min-height: 48px;
  padding: 0 18px;
  font-size: 15px;
}

.shop-show__fvSub {
  min-height: 48px;
  padding: 0 18px;
  font-size: 14px;
}

.shop-show__heroCtaNote {
  margin: 10px 0 0;
  color: #666666;
  font-size: 12px;
  line-height: 1.7;
}

@media (max-width: 640px) {
  .shop-show__heroActions--fv {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 8px;
  }

  .shop-show__fvPrimary,
  .shop-show__fvSub {
    width: 100%;
    min-height: 46px;
  }
}

.shop-show__cvPrimary {
  color: #ffffff !important;
  border-radius: 10px !important;
  font-weight: 900;
  letter-spacing: 0.04em;
  box-shadow:
    0 10px 24px rgba(17, 17, 17, 0.18),
    inset 0 1px 0 rgba(255, 255, 255, 0.08);
}

.shop-show__cvPrimary--custom {
  background: linear-gradient(180deg, #2a2a2a 0%, #111111 100%) !important;
  border: 1px solid rgba(198, 167, 94, 0.55) !important;
}

.shop-show__cvPrimary--hotpepper {
  background: #e60012 !important;
  border: 1px solid #cc0010 !important;
}

.shop-show__cvPrimary--tabelog {
  background: #f39800 !important;
  border: 1px solid #e08900 !important;
}

.shop-show__cvPrimaryLabel {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  line-height: 1.15;
}

.shop-show__cvPrimaryProvider {
  margin-top: 4px;
  font-size: 11px;
  font-weight: 700;
  opacity: 0.92;
  letter-spacing: 0.02em;
}

.shop-show__cvSub {
  background: #ffffff !important;
  color: #111111 !important;
  border: 1px solid #111111 !important;
  border-radius: 10px !important;
  font-weight: 800;
}

.shop-show__quickActions {
  padding: 14px !important;
  margin-bottom: 16px;
  background: #fffdf8;
}

.shop-show__quickActionsInner {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
}

.shop-show__quickAction {
  min-height: 44px;
  font-size: 13px;
  font-weight: 900;
}

.shop-show__quickAction--primary {
  border-color: rgba(198, 167, 94, 0.55) !important;
}

@media (max-width: 640px) {
  .shop-show__quickActionsInner {
    grid-template-columns: 1fr;
  }

  .shop-show__quickAction {
    width: 100%;
  }
}

@media (max-width: 640px) {
  .shop-show__bookingSubActions {
    grid-template-columns: 1fr;
  }

  .shop-show__bookingPrimary,
  .shop-show__bookingSub {
    width: 100%;
  }
}

.shop-show__stickyCta {
  display: none;
}

@media (max-width: 720px) {
  .shop-show__stickyCta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1000;

    display: block;
    padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
    background: rgba(255, 255, 255, 0.96);
    border-top: 1px solid #e8e3d7;
    box-shadow: 0 -10px 24px rgba(17, 17, 17, 0.10);
  }

  .shop-show__stickyCta .ss-btn {
    width: 100%;
    min-height: 48px;
  }

  body {
    padding-bottom: 76px;
  }
}

@media (max-width: 720px) {
  .shop-show {
    padding-bottom: 86px;
  }

  .shop-show__stickyCta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 80;

    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 8px;

    padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
    background: rgba(255, 255, 255, 0.96);
    border-top: 1px solid #e8e3d7;
    box-shadow: 0 -10px 28px rgba(17, 17, 17, 0.12);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .shop-show__stickyCta .ss-btn {
    width: 100%;
    min-height: 48px;
  }

  .shop-show__stickyCta .ss-btn:only-child {
    grid-column: 1 / -1;
  }
}

.shop-show__map {
