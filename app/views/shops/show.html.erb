<% page_title_parts = [@shop.name.presence, "喫煙できる店", "吸えログ in大阪"].compact %>
<% page_description_parts = [] %>
<% page_description_parts << "#{@shop.name}の喫煙情報。" if @shop.name.present? %>
<% page_description_parts << @shop.smoking_area_label if @shop.respond_to?(:smoking_area_label) %>
<% page_description_parts << @shop.smoking_type_label if @shop.respond_to?(:smoking_type_label) %>
<% page_description_parts << "最寄駅：#{@shop.nearest_station}" if @shop.nearest_station.present? %>
<% page_description_parts << "住所：#{@shop.address}" if @shop.address.present? %>
<% page_description_parts << "営業時間：#{@shop.display_opening_hours_text}" if @shop.respond_to?(:display_opening_hours_text) && @shop.display_opening_hours_text.present? && @shop.display_opening_hours_text != "未設定" %>
<% page_description_parts << "大阪で喫煙できる飲食店を探すなら吸えログ。" %>

<% content_for :title, page_title_parts.join("｜") %>
<% content_for :meta_description, page_description_parts.join(" ") %>

<style>
.shop-show {
max-width: 980px;
margin: 0 auto;
}

.shop-show__back {
margin: 0 0 14px;
}

.shop-show__backLink {
display: inline-flex;
align-items: center;
color: #6b6b6b;
text-decoration: none;
font-weight: 700;
}

.shop-show__backLink:hover {
color: #111111;
}

.shop-show__hero {
background: linear-gradient(135deg, #fffdf8 0%, #ffffff 60%);
border: 1px solid #e8e3d7;
border-radius: 22px;
padding: 22px;
box-shadow: 0 10px 30px rgba(17, 17, 17, 0.04);
margin-bottom: 18px;
}

.shop-show__title {
margin: 0 0 8px;
font-size: clamp(28px, 4vw, 40px);
line-height: 1.15;
letter-spacing: -0.03em;
color: #111111;
}

.shop-show__sub {
margin: 0;
color: #6b6b6b;
font-size: 14px;
}

.shop-show__badges {
display: flex;
gap: 8px;
flex-wrap: wrap;
margin-top: 14px;
}

.shop-show__lead {
margin-top: 16px;
color: #333333;
font-size: 15px;
line-height: 1.9;
}

.shop-show__layout {
display: grid;
grid-template-columns: minmax(0, 1fr);
gap: 16px;
}

.shop-show__section {
background: #ffffff;
border: 1px solid #e8e3d7;
border-radius: 20px;
padding: 18px;
box-shadow: 0 10px 30px rgba(17, 17, 17, 0.03);
}

.shop-show__sectionTitle {
margin: 0 0 14px;
font-size: 20px;
font-weight: 800;
color: #111111;
letter-spacing: -0.02em;
}

.shop-show__metaGrid {
display: grid;
grid-template-columns: repeat(2, minmax(0, 1fr));
gap: 12px;
}

.shop-show__metaItem {
background: #faf8f2;
border: 1px solid #eee6d6;
border-radius: 16px;
padding: 14px;
min-width: 0;
}

.shop-show__metaLabel {
display: block;
margin-bottom: 6px;
color: #7a7a7a;
font-size: 12px;
font-weight: 700;
}

.shop-show__metaValue {
color: #111111;
font-size: 15px;
line-height: 1.7;
word-break: break-word;
white-space: pre-wrap;
}

.shop-show__hoursBox {
display: grid;
gap: 12px;
}

.shop-show__hoursCard {
background: #faf8f2;
border: 1px solid #eee6d6;
border-radius: 16px;
padding: 14px;
}

.shop-show__hoursCardTitle {
margin: 0 0 6px;
color: #7a7a7a;
font-size: 12px;
font-weight: 700;
}

.shop-show__hoursCardValue {
color: #111111;
font-size: 15px;
line-height: 1.8;
white-space: pre-wrap;
word-break: break-word;
}

.shop-show__hoursNote {
margin-top: 8px;
color: #777777;
font-size: 12px;
}

.shop-show__phoneLink {
display: inline-flex;
align-items: center;
padding: 10px 14px;
background: #f6edd7;
color: #7a5a12;
border: 1px solid #eadbb5;
border-radius: 10px;
text-decoration: none;
font-weight: 800;
}

.shop-show__map {
height: 320px;
min-height: 320px;
border: 1px solid #e0e0e0;
border-radius: 14px;
overflow: hidden;
background: #f7f7f7;
}

.shop-show__mapLink {
margin-top: 10px;
}

.shop-show__mapLink a {
color: #7a5a12;
font-weight: 700;
text-decoration: none;
}

.shop-show__photosGroup + .shop-show__photosGroup {
margin-top: 18px;
}

.shop-show__photosTitle {
margin: 0 0 10px;
font-size: 16px;
font-weight: 800;
color: #111111;
}

.shop-show__photosGrid {
display: flex;
gap: 10px;
flex-wrap: wrap;
}

.shop-show__photo {
width: 160px;
height: 160px;
object-fit: cover;
border-radius: 12px;
border: 1px solid #ddd;
}

.shop-show__footerActions {
display: flex;
gap: 10px;
flex-wrap: wrap;
margin-top: 4px;
}

.shop-show__divider {
border: 0;
border-top: 1px solid #eee6d6;
margin: 4px 0 0;
}

.ss-badge {
display: inline-flex;
align-items: center;
min-height: 32px;
padding: 0 10px;
border-radius: 999px;
font-size: 12px;
font-weight: 800;
border: 1px solid transparent;
}

.ss-badge--dark {
background: #111111;
color: #ffffff;
border-color: #111111;
}

.ss-badge--gold {
background: #f6edd7;
color: #7a5a12;
border-color: #eadbb5;
}

.ss-badge--line {
background: #ffffff;
color: #111111;
border-color: #e8e3d7;
}

.ss-badge--green {
background: #eef7ee;
color: #2f6b3b;
border-color: #d8e7d7;
}

.ss-btn {
display: inline-flex;
align-items: center;
justify-content: center;
min-height: 42px;
padding: 0 16px;
border-radius: 999px;
text-decoration: none;
font-size: 14px;
font-weight: 800;
border: 1px solid transparent;
}

.ss-btn--dark {
background: #111111;
color: #ffffff;
border-color: #111111;
}

.ss-btn--ghost {
background: #ffffff;
color: #111111;
border-color: #e8e3d7;
}

.ss-btn--muted {
background: #ffffff;
color: #666666;
border-color: #eeeeee;
}

.ss-alert {
padding: 12px 14px;
border-radius: 12px;
margin: 10px 0;
font-weight: 700;
}

.ss-alert--notice {
border: 1px solid #d8e7d7;
background: #eef7ee;
color: #2f6b3b;
}

.ss-alert--alert {
border: 1px solid #f0d1d1;
background: #fff6f6;
color: #b00020;
}

.ss-pending {
border: 1px solid #f0d1d1;
background: #fff6f6;
padding: 14px;
border-radius: 14px;
}

.ss-pending__title {
margin: 0;
color: #b00020;
font-weight: 800;
}

.ss-pending__text {
margin: 6px 0 0;
color: #666666;
