}

.shop-show__photoCardImage {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.shop-photo-modal {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: none;
  background: rgba(0, 0, 0, 0.92);
}

.shop-photo-modal.is-open {
  display: block;
}

.shop-photo-modal__viewport {
  width: 100%;
  height: 100%;
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
}

.shop-photo-modal__slide {
  flex: 0 0 100%;
  width: 100%;
  height: 100%;
  scroll-snap-align: start;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 52px 14px 72px;
  box-sizing: border-box;
}

.shop-photo-modal__img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

.shop-photo-modal__close,
.shop-photo-modal__prev,
.shop-photo-modal__next {
  position: absolute;
  z-index: 10000;
  border: 0;
  background: rgba(255, 255, 255, 0.72);
  color: #111;
  backdrop-filter: blur(4px);
  cursor: pointer;
}

.shop-photo-modal__close {
  top: 14px;
  right: 14px;
  width: 38px;
  height: 38px;
  border-radius: 999px;
  font-size: 24px;
  font-weight: 800;
}

.shop-photo-modal__prev,
.shop-photo-modal__next {
  top: 50%;
  transform: translateY(-50%);
  width: 38px;
  height: 52px;
  border-radius: 999px;
  font-size: 26px;
  font-weight: 700;
}

.shop-photo-modal__prev {
  left: 10px;
}

.shop-photo-modal__next {
  right: 10px;
}

.shop-photo-modal__count {
  position: absolute;
  left: 50%;
  bottom: 22px;
  transform: translateX(-50%);
  z-index: 10000;
  padding: 6px 12px;
  border-radius: 999px;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 13px;
  font-weight: 800;
}

.shop-show__photoEmpty {
  margin: 0;
  color: #666666;
  font-size: 14px;
}

.shop-show__microLinks {
  margin-top: 6px;
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.shop-show__microLink {
  font-size: 12px;
  color: #7a5a12;
  text-decoration: none;
  font-weight: 700;
}

.shop-show__microLink:hover {
  text-decoration: underline;
}

.shop-show__relatedChip {
  display: inline-flex;
  align-items: center;
  min-height: 38px;
  padding: 0 14px;
  border-radius: 999px;
  border: 1px solid #e8e3d7;
  color: #111111;
  background: #fffdf8;
  text-decoration: none;
  font-size: 13px;
  font-weight: 800;
}

.shop-show__relatedChip:hover {
  border-color: #cfc4a5;
}

.shop-show__articleCards {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.shop-show__articleCard {
  display: flex;
  gap: 12px;
  text-decoration: none;
  color: inherit;
  border: 1px solid #e8e3d7;
  border-radius: 16px;
  overflow: hidden;
  background: #fffdf8;
  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    border-color 0.18s ease;
}

.shop-show__articleCard:hover {
  transform: translateY(-2px);
  border-color: #d8c79a;
  box-shadow: 0 12px 28px rgba(17, 17, 17, 0.08);
}

.shop-show__articleThumb {
  width: 120px;
  min-width: 120px;
  height: 120px;
  overflow: hidden;
  background: #f3f3f3;
}

.shop-show__articleThumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.shop-show__articleBody {
  padding: 12px 12px 12px 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.shop-show__articleLabel {
  font-size: 11px;
  font-weight: 800;
  color: #7a5a12;
  margin-bottom: 6px;
}

.shop-show__articleTitle {
  margin: 0;
  color: #111111;
  font-size: 16px;
  font-weight: 800;
  line-height: 1.45;
}

.shop-show__articleSummary {
  margin: 8px 0 0;
  color: #666666;
  font-size: 13px;
  line-height: 1.7;
}

@media (max-width: 720px) {
  .shop-show__articleCards {
    grid-template-columns: 1fr;
  }

  .shop-show__articleThumb {
    width: 96px;
    min-width: 96px;
    height: 96px;
  }

  .shop-show__articleTitle {
    font-size: 14px;
  }

  .shop-show__articleSummary {
    font-size: 12px;
  }
}

.ss-badge {
  display: inline-flex;
  align-items: center;
  min-height: 32px;
  padding: 0 10px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 800;
  border: 1px solid transparent;
}

.ss-badge--dark {
  background: #111111;
  color: #ffffff;
  border-color: #111111;
}

.ss-badge--gold {
  background: #f6edd7;
  color: #7a5a12;
  border-color: #eadbb5;
}

.ss-badge--line {
  background: #ffffff;
  color: #111111;
  border-color: #e8e3d7;
}

.ss-badge--green {
  background: #eef7ee;
  color: #2f6b3b;
  border-color: #d8e7d7;
}

.ss-badge--warn {
  background: #fff6db;
