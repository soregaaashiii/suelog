<%= form_with model: @shop, local: true do |f| %>
<% shop = f.object %>

<% if shop.errors.any? %>
<div style="padding:12px; border:1px solid #f5c2c7; background:#fff5f5; border-radius:12px; margin:10px 0; color:#b00020;">
<div style="font-weight:700; margin-bottom:6px;">入力エラー</div>
<ul style="margin:0; padding-left:18px;">
<% shop.errors.full_messages.each do |msg| %>
<li><%= msg %></li>
<% end %>
</ul>
</div>
<% end %>

<div style="display:grid; gap:10px; max-width:640px;">
<div>
<%= f.label :name, "店名" %><br>
<%= f.text_field :name, required: true, style: "width:100%;" %>
</div>

<div>
<%= f.label :address, "住所" %><br>
<%= f.text_field :address, required: true, style: "width:100%;" %>
</div>

<div style="display:flex; gap:10px; flex-wrap:wrap;">
<div>
<%= f.label :area, "エリア" %><br>
<%= f.text_field :area %>
</div>
<div>
<%= f.label :nearest_station, "最寄駅" %><br>
<%= f.text_field :nearest_station %>
</div>
<div>
<%= f.label :phone, "電話番号" %><br>
<%= f.text_field :phone %>
</div>
</div>

<div style="display:flex; gap:10px; flex-wrap:wrap;">
<div>
<%= f.label :genre, "ジャンル" %><br>
<%= f.select :genre,
Shop.genre_options.map { |genre| [genre, genre] },
include_blank: "選択してください" %>
</div>

<div>
<%= f.label :genre_other, "ジャンル（その他）" %><br>
<%= f.text_field :genre_other %>
</div>
</div>

<div style="display:flex; gap:10px; flex-wrap:wrap;">
<div>
<%= f.label :smoking_area, "喫煙エリア" %><br>
<%= f.select :smoking_area,
[["喫煙所あり","separated"],["席で喫煙可","all_smoking"]],
include_blank: "選択してください" %>
</div>

<div>
<%= f.label :smoking_type, "喫煙タイプ" %><br>
<%= f.select :smoking_type,
[["紙・加熱式OK","both_ok"],["加熱式のみ","electronic_only"],["紙のみ","paper_only"]],
include_blank: "選択してください" %>
</div>

<div>
<%= f.label :smoking_area_2, "喫煙エリア2（任意）" %><br>
<%= f.select :smoking_area_2,
[["喫煙所あり","separated"],["席で喫煙可","all_smoking"]],
include_blank: "条件が1つなら空欄" %>
</div>

<div>
<%= f.label :smoking_type_2, "喫煙タイプ2（任意）" %><br>
<%= f.select :smoking_type_2,
[["紙・加熱式OK","both_ok"],["加熱式のみ","electronic_only"],["紙のみ","paper_only"]],
include_blank: "条件が1つなら空欄" %>
</div>

<div>
<%= f.label :last_confirmed_on, "最終確認日" %><br>
<%= f.date_field :last_confirmed_on, required: true %>
</div>
</div>

<div>
<%= f.label :note, "メモ" %><br>
<%= f.text_area :note, rows: 3, style: "width:100%;" %>
</div>

<div style="display:flex; gap:10px; flex-wrap:wrap;">
<div>
<%= f.label :budget_range, "平均予算" %><br>
<%= f.text_field :budget_range, placeholder: "例：2,000〜2,999円" %>
</div>

<div>
<%= f.label :last_order_text, "LO" %><br>
<%= f.text_field :last_order_text, placeholder: "例：料理LO 22:30 / ドリンクLO 23:00" %>
</div>
</div>

<div style="display:flex; gap:10px; flex-wrap:wrap;">
<div>
<%= f.label :private_room_type, "個室" %><br>
<%= f.select :private_room_type,
[
["不明", "unknown"],
["個室なし", "no_private_room"],
["半個室あり", "semi_private_room"],
["完全個室あり", "full_private_room"]
] %>
</div>

<div>
<%= f.label :all_you_can_drink_type, "飲み放題" %><br>
<%= f.select :all_you_can_drink_type,
[
["不明", "unknown"],
["なし", "no_all_you_can_drink"],
["あり", "has_all_you_can_drink"]
] %>
</div>
</div>

<div>
<div style="font-weight:700; margin-bottom:6px;">席タイプ</div>
<% Shop::SEAT_TYPE_LABELS.each do |value, label| %>
<label style="display:inline-flex; align-items:center; gap:4px; margin-right:10px;">
<%= check_box_tag "shop[seat_type_tags][]",
value,
Array(shop.seat_type_tags).map(&:to_s).include?(value) %>
<%= label %>
</label>
<% end %>
<input type="hidden" name="shop[seat_type_tags][]" value="">
</div>

<hr>

<h3 style="margin:0;">営業時間</h3>
<p style="color:#666; margin:0 0 6px;">曜日ごとに「営業/定休」「開店/閉店」「中休み」を入力。祝前・祝後は未設定なら通常の曜日営業時間として扱います。</p>

<% days = [["月","monday"],["火","tuesday"],["水","wednesday"],["木","thursday"],["金","friday"],["土","saturday"],["日","sunday"],["祝前","pre_holiday"],["祝後","post_holiday"]] %>

<div id="opening-hours-form" style="display:grid; gap:12px;">
<% data = shop.opening_hours_data || {} %>

<% days.each do |label, key| %>
<% d = data[key] || {} %>
<% closed = !!d["closed"] %>
<% break_enabled = !!d["break_enabled"] %>

<div style="border:1px solid #eee; border-radius:12px; padding:12px;">
<div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
<div style="min-width:54px; font-weight:800;"><%= label %></div>

<label style="display:flex; align-items:center; gap:6px;">
<input type="checkbox"
name="shop[opening_hours_json][<%= key %>][closed]"
value="1"
<%= "checked" if closed %>
data-oh-closed="<%= key %>">
定休
</label>

<div style="display:flex; align-items:center; gap:6px;">
開店:
<input type="time"
name="shop[opening_hours_json][<%= key %>][open]"
value="<%= d["open"].to_s %>"
data-oh-open="<%= key %>"
<%= "disabled" if closed %>>
〜
閉店:
<input type="time"
name="shop[opening_hours_json][<%= key %>][close]"
value="<%= d["close"].to_s %>"
data-oh-close="<%= key %>"
<%= "disabled" if closed %>>
</div>

<label style="display:flex; align-items:center; gap:6px;">
<input type="checkbox"
name="shop[opening_hours_json][<%= key %>][break_enabled]"
value="1"
<%= "checked" if break_enabled %>
data-oh-break-toggle="<%= key %>"
<%= "disabled" if closed %>>
中休みあり
</label>
</div>

<div style="margin-top:10px; display:flex; align-items:center; gap:8px; flex-wrap:wrap;"
data-oh-break-row="<%= key %>"
<%= 'hidden="hidden"' unless break_enabled && !closed %>>
<span style="color:#666;">休憩:</span>
<input type="time"
name="shop[opening_hours_json][<%= key %>][break_start]"
value="<%= d["break_start"].to_s %>"
data-oh-break-start="<%= key %>"
<%= "disabled" if closed %>>
〜
<input type="time"
name="shop[opening_hours_json][<%= key %>][break_end]"
value="<%= d["break_end"].to_s %>"
data-oh-break-end="<%= key %>"
<%= "disabled" if closed %>>
</div>
</div>
<% end %>
</div>

<script>
document.addEventListener("turbo:load", () => {
const root = document.getElementById("opening-hours-form");
if (!root) return;

const toggleDay = (key) => {
const closed = root.querySelector(`[data-oh-closed="${key}"]`);
const open = root.querySelector(`[data-oh-open="${key}"]`);
const close = root.querySelector(`[data-oh-close="${key}"]`);
const breakToggle = root.querySelector(`[data-oh-break-toggle="${key}"]`);
const breakRow = root.querySelector(`[data-oh-break-row="${key}"]`);

const isClosed = !!(closed && closed.checked);

[open, close, breakToggle].forEach(el => {
if (!el) return;
el.disabled = isClosed;
});

if (breakRow) {
if (isClosed) {
breakRow.hidden = true;
} else {
const be = breakToggle && breakToggle.checked;
breakRow.hidden = !be;
}
}
};

const keys = ["monday","tuesday","wednesday","thursday","friday","saturday","sunday"];

keys.forEach((key) => {
toggleDay(key);

const closed = root.querySelector(`[data-oh-closed="${key}"]`);
const breakToggle = root.querySelector(`[data-oh-break-toggle="${key}"]`);

if (closed) closed.addEventListener("change", () => toggleDay(key));
if (breakToggle) breakToggle.addEventListener("change", () => toggleDay(key));
});
});
</script>

<hr>

<div style="display:flex; gap:10px;">
<%= f.submit "保存", class: "nav-btn" %>
<%= link_to "戻る", root_path, class: "nav-btn" %>
</div>
</div>
<% end %>
