<%# /Users/kawamuratakuya/dev/suelog/app/views/articles/_shop_card.html.erb %>

<div style="border:1px solid #ddd; border-radius:10px; padding:12px; margin:16px 0; background:#fff;">
  <div style="font-weight:700; font-size:16px; line-height:1.6;">
    <%= shop.name %>
  </div>

  <% if shop.address.present? %>
    <div style="font-size:13px; color:#666; margin-top:4px; line-height:1.7;">
      <%= shop.address %>
    </div>
  <% end %>

  <div style="margin-top:8px; display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
    <% case shop.smoking_area.to_s %>
    <% when "all_smoking" %>
      <span style="display:inline-block; padding:4px 8px; border-radius:999px; background:#fff7e6; color:#c6a75e; font-size:12px; font-weight:700;">
        席で喫煙可
      </span>
    <% when "separated" %>
      <span style="display:inline-block; padding:4px 8px; border-radius:999px; background:#f3f4f6; color:#333; font-size:12px; font-weight:700;">
        喫煙所あり
      </span>
    <% end %>

    <% if shop.respond_to?(:smoking_type_label) && shop.smoking_type_label.present? && shop.smoking_type_label != "不明" %>
      <span style="display:inline-block; padding:4px 8px; border-radius:999px; background:#f8fafc; color:#444; font-size:12px;">
        <%= shop.smoking_type_label %>
      </span>
    <% end %>
  </div>

  <div style="margin-top:10px;">
    <%= link_to "店舗ページを見る", shop_path(shop), style: "color:#007bff; text-decoration:underline;" %>
  </div>
</div>