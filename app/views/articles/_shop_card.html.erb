<%= link_to shop_path(shop), class: "refine-article-shop-card" do %>
  <span class="refine-eyebrow"><%= shop.display_genre.presence || "SHOP" %></span>
  <div class="refine-article-shop-card__head"><h3><%= shop.name %></h3><span>店舗を見る →</span></div>
  <p><%= [shop.nearest_station, shop.address].compact_blank.join(" ／ ") %></p>
  <div class="refine-article-shop-card__badges">
    <%= refine_shop_smoking_badges(shop) %>
    <% if !shop.confirmed_non_smoking? && shop.secondary_smoking_condition? %>
      <span class="refine-secondary">条件2</span><%= refine_smoking_badges(shop.smoking_area_2, shop.smoking_type_2) %>
    <% end %>
    <%= refine_verification_badge(shop) %>
    <%= refine_business_status_badge(shop.open_now?) %>
  </div>
<% end %>
