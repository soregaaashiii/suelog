<%# /Users/kawamuratakuya/dev/suelog/app/views/articles/show.html.erb %>

<% content_for :title, (@article.respond_to?(:seo_title) && @article.seo_title.present?) ? @article.seo_title : @article.title.to_s %>

<%
meta_description =
  if @article.respond_to?(:meta_description) && @article.meta_description.present?
    @article.meta_description
  elsif @article.summary.present?
    @article.summary.to_s
  else
    @article.title.to_s
  end
%>
<% content_for :meta_description, meta_description %>

<%
raw_article_body = @article.body.to_s

sidebar_items = []

sidebar_ad_regex = /\[sidebar_ad\](.*?)\[\/sidebar_ad\]/im
article_body_source = raw_article_body.to_s.dup

article_body_source.gsub!(sidebar_ad_regex) do
  sidebar_ad_body = Regexp.last_match(1).to_s.strip

  sidebar_items << {
    type: :ad,
    html: render_article_body(sidebar_ad_body, include_article_footer: false)
  }

  ""
end



article_body_source.gsub!(/\[sidebar_links\]/i) do
  sidebar_items << { type: :links }
  ""
end

article_body_source.gsub!(/\[sidebar\]/i) do
  sidebar_items << { type: :links }
  ""
end

sidebar_enabled = sidebar_items.present?

toc_items = []

toc_marker_regex = /\[toc_(item|sub)\s+title=(?:"([^"]+)"|'([^']+)')\s*\]/i

build_toc_heading = lambda do |level, title|
  index = toc_items.length + 1
  anchor_id = "article-toc-#{index}"
  normalized_level = level.to_s.downcase == "sub" ? :sub : :item

  toc_items << {
    level: normalized_level,
    title: title,
    anchor_id: anchor_id
  }

  tag_name = normalized_level == :sub ? "h3" : "h2"
  css_class = normalized_level == :sub ? "article-section-subheading" : "article-section-heading"

  %(<#{tag_name} id="#{ERB::Util.html_escape(anchor_id)}" class="#{css_class}">#{ERB::Util.html_escape(title)}</#{tag_name}>)
end

article_body_source.gsub!(%r{<(p|div)>\s*#{toc_marker_regex.source}\s*</\1>}im) do
  level = Regexp.last_match(2).to_s
  title = Regexp.last_match(3).presence || Regexp.last_match(4).to_s

  build_toc_heading.call(level, title)
end

article_body_source.gsub!(toc_marker_regex) do
  level = Regexp.last_match(1).to_s
  title = Regexp.last_match(2).presence || Regexp.last_match(3).to_s

  build_toc_heading.call(level, title)
end

toc_requested = article_body_source.match?(/\[toc\]/i)

build_toc_html = lambda do |extra_class|
  if toc_items.length >= 2 && toc_requested
    toc_nodes = []
    current_sub_items = []

    flush_sub_items = lambda do
      next if current_sub_items.blank?

      toc_nodes << tag.ul(class: "article-toc__sublist") do
        safe_join(
          current_sub_items.map do |sub_item|
            tag.li(class: "article-toc__subitem") do
              link_to(sub_item[:title], "##{sub_item[:anchor_id]}", class: "article-toc__sublink")
            end
          end
        )
      end

      current_sub_items = []
    end

    toc_items.each do |item|
      if item[:level] == :sub
        current_sub_items << item
      else
        flush_sub_items.call

        toc_nodes << tag.li(class: "article-toc__item") do
          link_to(item[:title], "##{item[:anchor_id]}", class: "article-toc__link")
        end
      end
    end

    flush_sub_items.call

    tag.nav(class: "article-toc #{extra_class}", aria: { label: "この記事の目次" }) do
      safe_join([
        tag.div("この記事の目次", class: "article-toc__title"),
        tag.ul(class: "article-toc__list") do
          safe_join(toc_nodes)
        end
      ])
    end
  else
    ""
  end
end

toc_inline_html = build_toc_html.call("article-toc--inline")
toc_desktop_html = build_toc_html.call("article-toc--desktop")

article_body_source.gsub!(%r{<(p|div)>\s*\[toc\]\s*</\1>}i, toc_inline_html)
article_body_source.gsub!(/\[toc\]/i, toc_inline_html)

article_body_html =
  begin
    render_article_body(article_body_source)
  rescue StandardError
    simple_format(article_body_source)
  end
%>

<div class="article-layout <%= sidebar_enabled ? 'article-layout--with-sidebar' : 'article-layout--single' %> <%= toc_desktop_html.present? ? 'article-layout--with-left-toc' : '' %>">
  <% if toc_desktop_html.present? %>
    <aside class="article-left-toc">
      <%= toc_desktop_html %>
    </aside>
  <% end %>

  <article class="article-main">
    <header style="margin-bottom:24px;">
      <h1 style="margin:0 0 16px; line-height:1.4;"><%= @article.title %></h1>

      <% if @article.respond_to?(:published_at) && @article.published_at.present? %>
        <p style="margin:0 0 16px; color:#666; font-size:14px;">
          公開日: <%= @article.published_at.strftime("%Y/%m/%d") %>
        </p>
      <% end %>

      <% if @article.respond_to?(:eyecatch) && @article.eyecatch.attached? %>
        <div style="margin-bottom:16px; text-align:center;">
          <%= image_tag @article.eyecatch, style: "max-width:100%; border-radius:8px;" %>
        </div>
      <% end %>

      <% if @article.summary.present? %>
        <p style="font-size:18px; color:#555; line-height:1.8; margin:0;">
          <%= @article.summary %>
        </p>
      <% end %>
    </header>

<div class="article-body" data-article-body="true">
  <%= article_body_html %>
</div>

    <section class="article-exit">
      <div class="article-exit__head">
        <div class="article-exit__label">次に探す</div>
        <h2 class="article-exit__title">大阪で喫煙できるお店を条件から探す</h2>
        <p class="article-exit__lead">
          記事で気になるお店が見つからなかった場合は、営業中・席で喫煙可・エリア別に探せます。
        </p>
      </div>

      <div class="article-exit__actions">
        <%= link_to "今営業中の喫煙可を探す",
                    root_path(open_now: 1),
                    class: "article-exit__btn article-exit__btn--primary" %>

        <%= link_to "席で吸える店を見る",
                    root_path(smoking_area: "all_smoking"),
                    class: "article-exit__btn" %>

        <%= link_to "梅田で探す",
                    umeda_path,
                    class: "article-exit__btn" %>

        <%= link_to "難波で探す",
                    namba_path,
                    class: "article-exit__btn" %>
      </div>

      <div class="article-exit__sub">
        <%= link_to "特集記事一覧を見る →", articles_path, class: "article-exit__more" %>
      </div>
    </section>

    <div style="margin-top:24px; padding-top:14px; border-top:1px solid #eee; color:#777; font-size:13px; line-height:1.8;">
      <div>※本記事は<%= (@article.published_at.presence || @article.created_at).strftime("%Y年%-m月") %>に作成しました。</div>
      <div>※掲載情報は変更される可能性があります。最新情報は店舗へご確認ください。</div>
    </div>
  </article>

  <% if sidebar_enabled %>
    <aside class="article-sidebar">
      <% sidebar_items.sort_by { |item| item[:type] == :ad ? 1 : 0 }.each do |item| %>
        <% if item[:type] == :ad %>
          <div class="sidebar-box sidebar-box--ad">
            <%= item[:html] %>
          </div>
        <% elsif item[:type] == :links %>
          <div class="sidebar-box">
            <div class="sidebar-title">大阪で喫煙できる店を探す</div>
            <%= link_to "梅田で探す", umeda_path, class: "sidebar-link" %>
            <%= link_to "難波で探す", namba_path, class: "sidebar-link" %>
            <%= link_to "席で喫煙可の店", umeda_smoking_path("all_smoking"), class: "sidebar-link" %>
            <%= link_to "喫煙所ありの店", umeda_smoking_path("separated"), class: "sidebar-link" %>
          </div>

          <div class="sidebar-box">
            <div class="sidebar-title">おすすめ特集</div>
            <%= link_to "特集記事一覧を見る", articles_path, class: "sidebar-link" %>
          </div>
        <% end %>
      <% end %>
    </aside>
  <% end %>
</div>

<style>
