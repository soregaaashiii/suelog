<%# /Users/kawamuratakuya/dev/suelog/app/views/articles/show.html.erb %>

<h1><%= @article.title %></h1>

<% if @article.eyecatch.attached? %>
<div style="margin-bottom:16px;">
<%= image_tag @article.eyecatch, style: "max-width:100%; border-radius:12px;" %>
</div>
<% end %>

<% if @article.summary.present? %>
<p style="font-size:18px; color:#555;"><%= @article.summary %></p>
<% end %>

<div class="article-body">
<%= render_article_body(@article.body.to_s) %>
</div>

<style>
.article-body a {
color: #2563eb;
text-decoration: underline;
}

.article-body a:hover {
opacity: 0.85;
}

.article-body img {
max-width: 100%;
height: auto;
border-radius: 12px;
}

.article-body figure {
margin: 16px 0;
}

.article-body figcaption {
color: #666;
font-size: 13px;
margin-top: 6px;
}
</style>