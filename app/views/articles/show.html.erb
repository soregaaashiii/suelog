<%# /Users/kawamuratakuya/dev/suelog/app/views/articles/show.html.erb %>

<% content_for :title, (@article.respond_to?(:seo_title) && @article.seo_title.present?) ? @article.seo_title : @article.title.to_s %>

<%
meta_description =
  if @article.respond_to?(:meta_description) && @article.meta_description.present?
    @article.meta_description
  elsif @article.summary.present?
    @article.summary.to_s
  else
    @article.title.to_s
  end
%>
<% content_for :meta_description, meta_description %>

<%
raw_article_body = @article.body.to_s

sidebar_items = []

article_body_source = raw_article_body.gsub(/\[sidebar_ad\](.*?)\[\/sidebar_ad\]|\[sidebar_links\]|\[sidebar\]/im) do
  matched_text = Regexp.last_match(0)

  if matched_text.match?(/\A\[sidebar_ad\]/i)
    sidebar_items << {
      type: :ad,
      html: render_article_body(Regexp.last_match(1).to_s.strip)
    }
  else
    sidebar_items << { type: :links }
  end

  ""
end

sidebar_enabled = sidebar_items.present?

article_body_html =
  begin
    render_article_body(article_body_source)
  rescue StandardError
    simple_format(article_body_source)
  end
%>

<div class="article-layout <%= sidebar_enabled ? 'article-layout--with-sidebar' : 'article-layout--single' %>">
  <article class="article-main">
    <header style="margin-bottom:24px;">
      <h1 style="margin:0 0 16px; line-height:1.4;"><%= @article.title %></h1>

      <% if @article.respond_to?(:published_at) && @article.published_at.present? %>
        <p style="margin:0 0 16px; color:#666; font-size:14px;">
          公開日: <%= @article.published_at.strftime("%Y/%m/%d") %>
        </p>
      <% end %>

      <% if @article.respond_to?(:eyecatch) && @article.eyecatch.attached? %>
        <div style="margin-bottom:16px; text-align:center;">
          <%= image_tag @article.eyecatch, style: "max-width:100%; border-radius:12px;" %>
        </div>
      <% end %>

      <% if @article.summary.present? %>
        <p style="font-size:18px; color:#555; line-height:1.8; margin:0;">
          <%= @article.summary %>
        </p>
      <% end %>
    </header>

    <div class="article-body" data-article-body="true">
      <%= article_body_html %>
    </div>

    <div style="margin-top:24px; padding-top:14px; border-top:1px solid #eee; color:#777; font-size:13px; line-height:1.8;">
      <div>※本記事は<%= (@article.published_at.presence || @article.created_at).strftime("%Y年%-m月") %>に作成しました。</div>
      <div>※掲載情報は変更される可能性があります。最新情報は店舗へご確認ください。</div>
    </div>
  </article>

  <% if sidebar_enabled %>
    <aside class="article-sidebar">
      <% sidebar_items.each do |item| %>
        <% if item[:type] == :ad %>
          <div class="sidebar-box sidebar-box--ad">
            <%= item[:html] %>
          </div>
        <% elsif item[:type] == :links %>
          <div class="sidebar-box">
            <div class="sidebar-title">大阪で喫煙できる店を探す</div>
            <%= link_to "梅田で探す", umeda_path, class: "sidebar-link" %>
            <%= link_to "難波で探す", namba_path, class: "sidebar-link" %>
            <%= link_to "席で喫煙可の店", umeda_smoking_path("all_smoking"), class: "sidebar-link" %>
            <%= link_to "喫煙所ありの店", umeda_smoking_path("separated"), class: "sidebar-link" %>
          </div>

          <div class="sidebar-box">
            <div class="sidebar-title">おすすめ特集</div>
            <%= link_to "特集記事一覧を見る", articles_path, class: "sidebar-link" %>
          </div>
        <% end %>
      <% end %>
    </aside>
  <% end %>
</div>

<style>
.article-layout {
  max-width: 1120px;
  margin: 0 auto;
  padding: 24px 16px 56px;
  display: grid;
  gap: 28px;
  align-items: start;
}

.article-layout--with-sidebar {
  grid-template-columns: minmax(0, 1fr) 280px;
}

.article-layout--single {
  max-width: 860px;
  display: block;
}

.article-main {
  min-width: 0;
}

.article-sidebar {
  align-self: start;
  display: grid;
  gap: 16px;
}

@media (min-width: 901px) {
  .sidebar-box--ad.is-floating-sidebar-ad {
    position: fixed;
    left: var(--sidebar-floating-left);
    right: auto;
    top: var(--sidebar-floating-top, 8px);
    bottom: auto;
    width: var(--sidebar-floating-width);
    z-index: 30;
  }

  .sidebar-floating-placeholder {
    display: none;
  }
}

.sidebar-box {
  border: 1px solid #eee;
  background: #fff;
  border-radius: 14px;
  padding: 16px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
}

.sidebar-box--ad {
  overflow: hidden;
}

.sidebar-box--ad img {
  max-width: 100%;
  height: auto;
  display: block;
}

.sidebar-title {
  font-weight: 900;
  margin-bottom: 10px;
  color: #222;
}

.sidebar-link {
  display: block;
  padding: 10px 0;
  color: #2563eb;
  text-decoration: none;
  font-weight: 700;
  border-top: 1px solid #f1f1f1;
}

.sidebar-link:first-of-type {
  border-top: 0;
}

.sidebar-link:hover {
  text-decoration: underline;
}

@media (max-width: 900px) {
  .article-layout {
    display: block;
    max-width: 860px;
  }

  .article-sidebar {
    position: static;
    margin-top: 24px;
  }
}

.article-body a {
  color: #2563eb;
  text-decoration: underline;
}

.article-body a:hover {
  opacity: 0.85;
}

.article-body img {
  max-width: 100%;
  height: auto;
}

.article-body figure {
  margin: 20px 0;
  text-align: center;
}

.article-body figure img {
  max-width: 560px;
  width: 100%;
  height: auto;
  border-radius: 12px;
  display: inline-block;
}

.article-body .image-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: flex-start;
  margin: 20px 0;
}

.article-body .image-row figure {
  flex: 1 1 240px;
  margin: 0;
}

.article-body .image-row figure img {
  max-width: 100%;
  width: 100%;
}

.article-body figure.image-small img {
  max-width: 300px;
  width: auto;
}

.article-body figure.image-medium img {
  max-width: 560px;
  width: 100%;
}

.article-body figure.image-large img {
  max-width: 900px;
  width: 100%;
}

.article-body figure.align-left {
  text-align: left;
}

.article-body figure.align-center {
  text-align: center;
}

.article-body figure.align-right {
  text-align: right;
}
</style>

<script>
(() => {
  function isMarkerNode(node) {
    if (!node || node.nodeType !== 1) return false;
    if (!["P", "DIV"].includes(node.tagName)) return false;
    return node.children.length === 0;
  }

  function normalizeText(node) {
    return (node.textContent || "").replace(/\u00A0/g, " ").trim();
  }

  function nextMeaningfulSibling(node) {
    let current = node.nextSibling;

    while (current) {
      if (current.nodeType === 1) return current;
      if (current.nodeType === 3 && current.textContent.trim() !== "") return current;
      current = current.nextSibling;
    }

    return null;
  }

  function nextFigureAfter(node) {
    let current = nextMeaningfulSibling(node);

    while (current) {
      if (current.nodeType === 1) {
        if (current.tagName === "FIGURE") return current;

        const nested = current.querySelector && current.querySelector("figure");
        if (nested) return nested;
      }
      current = nextMeaningfulSibling(current);
    }

    return null;
  }

  function applyImageOptions(figure, size, align) {
    if (!figure) return;

    figure.classList.remove("image-small", "image-medium", "image-large");
    figure.classList.remove("align-left", "align-center", "align-right");

    if (size === "small") figure.classList.add("image-small");
    if (size === "medium") figure.classList.add("image-medium");
    if (size === "large") figure.classList.add("image-large");

    if (align === "left") figure.classList.add("align-left");
    if (align === "center") figure.classList.add("align-center");
    if (align === "right") figure.classList.add("align-right");
  }

  function processArticleBody() {
    const root = document.querySelector('[data-article-body="true"]');
    if (!root) return;

    const nodes = Array.from(root.children);
    let currentRow = null;

    nodes.forEach((node) => {
      if (!isMarkerNode(node)) return;

      const text = normalizeText(node);

      const imageMatch = text.match(/^\[image\s+size=(small|medium|large)\s+align=(left|center|right)\]$/i);
      if (imageMatch) {
        const figure = nextFigureAfter(node);
        applyImageOptions(figure, imageMatch[1].toLowerCase(), imageMatch[2].toLowerCase());
        node.remove();
        return;
      }

      if (/^\[image-row-start\]$/i.test(text)) {
        const row = document.createElement("div");
        row.className = "image-row";
        node.parentNode.insertBefore(row, node.nextSibling);
        currentRow = row;
        node.remove();
        return;
      }

      if (/^\[image-row-end\]$/i.test(text)) {
        currentRow = null;
        node.remove();
        return;
      }
    });

    let activeRow = null;
    Array.from(root.children).forEach((node) => {
      if (node.classList && node.classList.contains("image-row")) {
        activeRow = node;
        return;
      }

      if (!activeRow) return;

      if (node.tagName === "FIGURE") {
        activeRow.appendChild(node);
        return;
      }

      const text = normalizeText(node);
      if (/^\[image-row-start\]$/i.test(text)) return;
      if (/^\[image-row-end\]$/i.test(text)) {
        activeRow = null;
        node.remove();
        return;
      }

      if (text !== "") {
        activeRow = null;
      }
    });

    root.querySelectorAll("p, div").forEach((node) => {
      if (node.classList.contains("image-row")) return;
      if (node.children.length > 0) return;
      if (normalizeText(node) === "") node.remove();
    });
  }

  function setupFloatingLastSidebarAd() {
    const sidebar = document.querySelector(".article-sidebar");
    if (!sidebar) return;

    const ads = sidebar.querySelectorAll(".sidebar-box--ad");
    const lastAd = ads[ads.length - 1];
    if (!lastAd) return;

    let placeholder = sidebar.querySelector(".sidebar-floating-placeholder");
    if (!placeholder) {
      placeholder = document.createElement("div");
      placeholder.className = "sidebar-floating-placeholder";
      lastAd.parentNode.insertBefore(placeholder, lastAd);
    }

    function resetFloating() {
      lastAd.classList.remove("is-floating-sidebar-ad");
      lastAd.style.removeProperty("--sidebar-floating-left");
      lastAd.style.removeProperty("--sidebar-floating-width");
      lastAd.style.removeProperty("--sidebar-floating-top");
      lastAd.style.removeProperty("position");
      lastAd.style.removeProperty("top");
      lastAd.style.removeProperty("left");
      lastAd.style.removeProperty("width");
      placeholder.style.display = "none";
      placeholder.style.height = "0px";
    }

    function updateFloating() {
      if (window.matchMedia("(max-width: 900px)").matches) {
        resetFloating();
        return;
      }

      const layout = document.querySelector(".article-layout--with-sidebar");
      if (!layout) {
        resetFloating();
        return;
      }

      const normalTop = 8;
      const marker = lastAd.classList.contains("is-floating-sidebar-ad") ? placeholder : lastAd;
      const markerRect = marker.getBoundingClientRect();

      if (markerRect.top > normalTop) {
        resetFloating();
        return;
      }

      const sidebarRect = sidebar.getBoundingClientRect();
      const footer = document.querySelector(".site-footer");
      const footerRect = footer ? footer.getBoundingClientRect() : null;
      const adHeight = lastAd.offsetHeight;

      const floatingTop =
        footerRect ? Math.min(normalTop, footerRect.top - adHeight) : normalTop;

      placeholder.style.display = "block";
      placeholder.style.height = `${adHeight}px`;

      lastAd.classList.add("is-floating-sidebar-ad");
      lastAd.style.position = "fixed";
      lastAd.style.top = `${floatingTop}px`;
      lastAd.style.left = `${sidebarRect.left}px`;
      lastAd.style.width = `${sidebarRect.width}px`;
    }

    window.addEventListener("scroll", updateFloating, { passive: true });
    window.addEventListener("resize", updateFloating);
    updateFloating();
  }

  document.addEventListener("DOMContentLoaded", () => {
    processArticleBody();
    setupFloatingLastSidebarAd();
  });

  document.addEventListener("turbo:load", () => {
    processArticleBody();
    setupFloatingLastSidebarAd();
  });
})();
</script>