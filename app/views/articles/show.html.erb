<script>
(() => {
  function isMarkerNode(node) {
    if (!node || node.nodeType !== 1) return false;
    if (!["P", "DIV"].includes(node.tagName)) return false;
    return node.children.length === 0;
  }

  function normalizeText(node) {
    return (node.textContent || "").replace(/\u00A0/g, " ").trim();
  }

  function nextMeaningfulSibling(node) {
    let current = node.nextSibling;

    while (current) {
      if (current.nodeType === 1) return current;
      if (current.nodeType === 3 && current.textContent.trim() !== "") return current;
      current = current.nextSibling;
    }

    return null;
  }

  function nextFigureAfter(node) {
    let current = nextMeaningfulSibling(node);

    while (current) {
      if (current.nodeType === 1) {
        if (current.tagName === "FIGURE") return current;

        const nested = current.querySelector && current.querySelector("figure");
        if (nested) return nested;
      }
      current = nextMeaningfulSibling(current);
    }

    return null;
  }

  function applyImageOptions(figure, size, align) {
    if (!figure) return;

    figure.classList.remove("image-small", "image-medium", "image-large");
    figure.classList.remove("align-left", "align-center", "align-right");

    if (size === "small") figure.classList.add("image-small");
    if (size === "medium") figure.classList.add("image-medium");
    if (size === "large") figure.classList.add("image-large");

    if (align === "left") figure.classList.add("align-left");
    if (align === "center") figure.classList.add("align-center");
    if (align === "right") figure.classList.add("align-right");
  }

  function processArticleBody() {
    const root = document.querySelector('[data-article-body="true"]');
    if (!root) return;

    const nodes = Array.from(root.children);
    let currentRow = null;

    nodes.forEach((node) => {
      if (!isMarkerNode(node)) return;

      const text = normalizeText(node);

      const imageMatch = text.match(/^\[image\s+size=(small|medium|large)\s+align=(left|center|right)\]$/i);
      if (imageMatch) {
        const figure = nextFigureAfter(node);
        applyImageOptions(figure, imageMatch[1].toLowerCase(), imageMatch[2].toLowerCase());
        node.remove();
        return;
      }

      if (/^\[image-row-start\]$/i.test(text)) {
        const row = document.createElement("div");
        row.className = "image-row";
        node.parentNode.insertBefore(row, node.nextSibling);
        currentRow = row;
        node.remove();
        return;
      }

      if (/^\[image-row-end\]$/i.test(text)) {
        currentRow = null;
        node.remove();
        return;
      }
    });

    let activeRow = null;
    Array.from(root.children).forEach((node) => {
      if (node.classList && node.classList.contains("image-row")) {
        activeRow = node;
        return;
      }

      if (!activeRow) return;

      if (node.tagName === "FIGURE") {
        activeRow.appendChild(node);
        return;
      }

      const text = normalizeText(node);
      if (/^\[image-row-start\]$/i.test(text)) return;
      if (/^\[image-row-end\]$/i.test(text)) {
        activeRow = null;
        node.remove();
        return;
      }

      if (text !== "") {
        activeRow = null;
      }
    });

    root.querySelectorAll("p, div").forEach((node) => {
      if (node.classList.contains("image-row")) return;
      if (node.children.length > 0) return;
      if (normalizeText(node) === "") node.remove();
    });
  }

  function setupFloatingLeftToc() {
    const leftToc = document.querySelector(".article-left-toc");
    if (!leftToc) return;

    const tocBox = leftToc.querySelector(".article-toc");
    if (!tocBox) return;

    function resetFloating() {
      leftToc.classList.remove("is-floating-left-toc");
      leftToc.style.removeProperty("left");
      leftToc.style.removeProperty("--left-toc-floating-width");
      leftToc.style.removeProperty("position");
      leftToc.style.removeProperty("top");
      leftToc.style.removeProperty("width");
    }

    function updateFloating() {
      if (window.matchMedia("(max-width: 1199px)").matches) {
        resetFloating();
        return;
      }

      const rect = leftToc.getBoundingClientRect();
      const footer = document.querySelector(".site-footer");
      const footerRect = footer ? footer.getBoundingClientRect() : null;
      const tocHeight = leftToc.offsetHeight;
      const normalTop = 150;

      const floatingTop =
        footerRect ? Math.min(normalTop, footerRect.top - tocHeight - 16) : normalTop;

      leftToc.classList.add("is-floating-left-toc");
      leftToc.style.left = `${rect.left}px`;
      leftToc.style.setProperty("--left-toc-floating-width", `${rect.width}px`);
      leftToc.style.position = "fixed";
      leftToc.style.top = `${floatingTop}px`;
      leftToc.style.width = `${rect.width}px`;
    }

    window.addEventListener("scroll", updateFloating, { passive: true });
    window.addEventListener("resize", updateFloating);
    updateFloating();
  }

  function setupFloatingLastSidebarAd() {
    const sidebar = document.querySelector(".article-sidebar");
    if (!sidebar) return;

    const ads = sidebar.querySelectorAll(".sidebar-box--ad");
    const lastAd = ads[ads.length - 1];
    if (!lastAd) return;

    let placeholder = sidebar.querySelector(".sidebar-floating-placeholder");
    if (!placeholder) {
      placeholder = document.createElement("div");
      placeholder.className = "sidebar-floating-placeholder";
      lastAd.parentNode.insertBefore(placeholder, lastAd);
    }

    function resetFloating() {
      lastAd.classList.remove("is-floating-sidebar-ad");
      lastAd.style.removeProperty("--sidebar-floating-left");
      lastAd.style.removeProperty("--sidebar-floating-width");
      lastAd.style.removeProperty("--sidebar-floating-top");
      lastAd.style.removeProperty("position");
      lastAd.style.removeProperty("top");
      lastAd.style.removeProperty("left");
      lastAd.style.removeProperty("width");
      placeholder.style.display = "none";
      placeholder.style.height = "0px";
    }

    function updateFloating() {
      if (window.matchMedia("(max-width: 900px)").matches) {
        resetFloating();
        return;
      }

      const layout = document.querySelector(".article-layout--with-sidebar");
      if (!layout) {
        resetFloating();
        return;
      }

      const normalTop = 8;
      const marker = lastAd.classList.contains("is-floating-sidebar-ad") ? placeholder : lastAd;
      const markerRect = marker.getBoundingClientRect();

      if (markerRect.top > normalTop) {
        resetFloating();
        return;
      }

      const sidebarRect = sidebar.getBoundingClientRect();
      const footer = document.querySelector(".site-footer");
      const footerRect = footer ? footer.getBoundingClientRect() : null;
      const adHeight = lastAd.offsetHeight;

      const floatingTop =
        footerRect ? Math.min(normalTop, footerRect.top - adHeight) : normalTop;

      placeholder.style.display = "block";
      placeholder.style.height = `${adHeight}px`;

      lastAd.classList.add("is-floating-sidebar-ad");
      lastAd.style.position = "fixed";
      lastAd.style.top = `${floatingTop}px`;
      lastAd.style.left = `${sidebarRect.left}px`;
      lastAd.style.width = `${sidebarRect.width}px`;
    }

    window.addEventListener("scroll", updateFloating, { passive: true });
    window.addEventListener("resize", updateFloating);
    updateFloating();
  }

  document.addEventListener("DOMContentLoaded", () => {
    processArticleBody();
    setupFloatingLeftToc();
    setupFloatingLastSidebarAd();
  });

  document.addEventListener("turbo:load", () => {
    processArticleBody();
    setupFloatingLeftToc();
    setupFloatingLastSidebarAd();
  });
})();
</script>