<h1>記事一覧</h1>

<form action="<%= articles_path %>" method="get" style="margin:20px 0 28px;">
  <div style="display:flex; gap:10px; align-items:center;">
    <input
      type="text"
      name="q"
      value="<%= @q %>"
      placeholder="キーワードで記事を検索"
      style="flex:1; min-width:0; padding:12px 14px; border:1px solid #ddd; border-radius:12px; font-size:16px;"
    >

    <button
      type="submit"
      style="padding:12px 18px; border:0; border-radius:12px; background:#111; color:#fff; font-weight:700; font-size:16px; white-space:nowrap;"
    >
      検索
    </button>
  </div>

  <% if @q.present? %>
    <div style="margin-top:10px; font-size:14px; color:#666;">
      「<%= @q %>」の検索結果
      <%= link_to "クリア", articles_path, style: "margin-left:10px; color:#8a6d2f;" %>
    </div>
  <% end %>
</form>

<% if @articles.any? %>
  <% @articles.each do |article| %>
    <article style="margin-bottom:24px; padding-bottom:24px; border-bottom:1px solid #eee;">
      <% if article.eyecatch.attached? %>
        <div style="margin-bottom:12px;">
          <%= image_tag article.eyecatch, style: "max-width:320px; border-radius:12px;" %>
        </div>
      <% end %>

      <h2><%= link_to article.title, article_path(article) %></h2>

      <% if article.summary.present? %>
        <p><%= article.summary %></p>
      <% end %>

      <p style="color:#666; font-size:14px;">
        公開日: <%= l(article.published_at.to_date) if article.published_at.present? %>
      </p>
    </article>
  <% end %>
<% else %>
  <p style="color:#666; margin-top:24px;">
    該当する記事はありません。
  </p>
<% end %>