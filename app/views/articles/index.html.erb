<h1>記事一覧</h1>

<form action="<%= articles_path %>" method="get" style="margin:20px 0 28px;">
  <div style="display:flex; gap:10px; align-items:center;">
    <input
      type="text"
      name="q"
      value="<%= @q %>"
      placeholder="キーワードで記事を検索"
      style="flex:1; min-width:0; padding:12px 14px; border:1px solid #ddd; border-radius:12px; font-size:16px;"
    >

    <button
      type="submit"
      style="padding:12px 18px; border:0; border-radius:12px; background:#111; color:#fff; font-weight:700; font-size:16px; white-space:nowrap;"
    >
      検索
    </button>
  </div>

  <% if @q.present? %>
    <div style="margin-top:10px; font-size:14px; color:#666;">
      「<%= @q %>」の検索結果
      <%= link_to "クリア", articles_path, style: "margin-left:10px; color:#8a6d2f;" %>
    </div>
  <% end %>
</form>

<% if @articles.any? %>
  <% @articles.each do |article| %>
    <article class="article-list-item">
      <% if article.eyecatch.attached? %>
        <%= link_to article_path(article), class: "article-list-item__image", tabindex: -1, aria: { hidden: true } do %>
          <%= image_tag article.eyecatch, alt: "", loading: "lazy", decoding: "async" %>
        <% end %>
      <% end %>

      <div class="article-list-item__content">
        <h2 class="article-list-item__title"><%= link_to article.title, article_path(article) %></h2>
        <% if article.summary.present? %>
          <p class="article-list-item__summary"><%= article.summary %></p>
        <% end %>
        <% if article.published_at.present? %>
          <p class="article-list-item__date">公開日: <%= l(article.published_at.to_date) %></p>
        <% end %>
      </div>
    </article>
  <% end %>
<% else %>
  <p style="color:#666; margin-top:24px;">
    該当する記事はありません。
  </p>
<% end %>

<style>
.article-list-item { display:flex; gap:24px; align-items:flex-start; margin-bottom:24px; padding-bottom:24px; border-bottom:1px solid #eee; }
.article-list-item__image { display:block; flex:0 0 220px; overflow:hidden; border-radius:12px; aspect-ratio:4 / 3; background:#f5f5f5; }
.article-list-item__image img { display:block; width:100%; height:100%; object-fit:cover; }
.article-list-item__content { flex:1; min-width:0; overflow-wrap:anywhere; }
.article-list-item__title { margin:0 0 10px; font-size:22px; line-height:1.5; }
.article-list-item__title a { color:inherit; text-decoration:none; }
.article-list-item__title a:hover { text-decoration:underline; }
.article-list-item__summary { margin:0 0 12px; line-height:1.8; color:#444; }
.article-list-item__date { margin:0; color:#666; font-size:13px; }
@media (max-width:600px) {
  .article-list-item { gap:12px; }
  .article-list-item__image { flex-basis:104px; border-radius:8px; }
  .article-list-item__title { font-size:17px; margin-bottom:6px; }
  .article-list-item__summary { font-size:14px; line-height:1.65; }
  .article-list-item__date { font-size:12px; }
}
</style>
