<!DOCTYPE html>
<html lang="ja">
  <head>
    <title>吸えログ 管理画面</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body style="background:#f7f7f7; font-family:-apple-system, BlinkMacSystemFont, sans-serif;">
    <div style="background:#111; color:#fff; padding:14px 20px; font-weight:700;">
      吸えログ 管理画面
    </div>

    <div style="max-width:1200px; margin:30px auto; padding:0 20px;">
      <%# ✅ 管理メニュー（承認待ち口コミ/編集依頼/通報/アクセス/お問い合わせ など） %>
      <%= render "admin/nav" %>

      <div style="margin:15px 0; padding:12px; background:#fff; border:1px solid #e5e5e5; border-radius:10px;">
        <div style="font-weight:800; margin-bottom:8px;">この端末のアクセス集計</div>

        <% if page_view_tracking_excluded? %>
          <div style="margin-bottom:10px; color:#137333; font-size:14px;">
            現在、この端末のフロント閲覧はアクセス集計から除外されています。
          </div>

          <%= button_to "この端末を集計対象に戻す",
              admin_include_page_view_tracking_path,
              method: :delete,
              style: "padding:8px 12px; border:1px solid #111; border-radius:8px; background:#fff; color:#111; cursor:pointer;" %>
        <% else %>
          <div style="margin-bottom:10px; color:#666; font-size:14px;">
            現在、この端末のフロント閲覧はアクセス集計の対象です。
          </div>

          <%= button_to "この端末を集計から除外する",
              admin_exclude_page_view_tracking_path,
              method: :post,
              style: "padding:8px 12px; border:1px solid #111; border-radius:8px; background:#111; color:#fff; cursor:pointer;" %>
        <% end %>
      </div>

      <% if notice.present? %>
        <div style="margin:15px 0; padding:10px; background:#e6f4ea; border:1px solid #cfe8d6; color:#137333; border-radius:8px;">
          <%= notice %>
        </div>
      <% end %>

      <% if alert.present? %>
        <div style="margin:15px 0; padding:10px; background:#fff5f5; border:1px solid #f3c7c7; color:#b00020; border-radius:8px;">
          <%= alert %>
        </div>
      <% end %>

      <%= yield %>
    </div>
  </body>
</html>