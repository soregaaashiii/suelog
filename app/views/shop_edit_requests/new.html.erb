<%# /Users/kawamuratakuya/Desktop/吸えログデータ/dev/suelog/app/views/shop_edit_requests/new.html.erb %>

<h1>編集依頼：<%= @shop.name %></h1>

<p style="color:#666; line-height:1.6;">
※ 依頼内容は管理者が確認して反映します（空欄は「変更しない」扱い）<br>
※ ただし <strong>喫煙ステータス</strong> と <strong>写真（どれか1枚）</strong> は編集依頼で必須です
</p>

<% if @req.errors.any? %>
<div style="border:1px solid #f5c2c7; background:#f8d7da; padding:12px; border-radius:10px; margin:12px 0;">
<div style="font-weight:800; margin-bottom:6px;">入力エラーがあります：</div>
<ul style="margin:0; padding-left:18px;">
<% @req.errors.full_messages.each do |msg| %>
<li><%= msg %></li>
<% end %>
</ul>
</div>
<% end %>

<%= form_with model: [@shop, @req], local: true, html: { multipart: true, novalidate: true } do |f| %>

<div style="margin:12px 0;">
<div style="font-weight:700;">あなたの名前（任意）</div>
<%= f.text_field :proposer_name,
style: "width:100%; max-width:520px; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
</div>

<hr>

<h3>変更案（任意）</h3>
<p style="color:#666; margin-top:0;">空なら変更しません</p>

<div style="margin:12px 0;">
<div style="font-weight:700;">店名</div>
<%= f.text_field :proposed_name,
placeholder: "（変更しない場合は空でOK）",
style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
</div>

<div style="margin:12px 0;">
<div style="font-weight:700;">ジャンル</div>
<%= f.select :genre,
["居酒屋", "バー / パブ", "喫茶店 / カフェ", "焼肉", "ラーメン", "中華", "和食", "洋食", "立ち飲み", "スナック", "その他"],
{ include_blank: "（変更しない）" },
style: "width:100%; max-width:420px; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
</div>

<div style="margin:12px 0;">
<div style="font-weight:700;">その他（ジャンルが「その他」の時）</div>
<%= f.text_field :genre_other,
placeholder: "例：シーシャバー、ダーツバー（ジャンルが「その他」の時だけ）",
style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
</div>

<div style="margin:12px 0;">
<div style="font-weight:700;">住所</div>
<%= f.text_field :proposed_address,
placeholder: "（変更しない場合は空でOK）",
style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
</div>

<div style="margin:12px 0;">
<div style="font-weight:700;">最終確認日</div>
<%= f.date_field :proposed_last_confirmed_on, max: Date.current,
style: "padding:10px; border:1px solid #ddd; border-radius:12px;" %>
<div style="color:#666; font-size:12px; margin-top:6px;">※ 空なら変更しません</div>
</div>

<div style="margin:12px 0;">
<div style="font-weight:700;">最寄駅（任意）</div>
<%= f.text_field :proposed_nearest_station,
placeholder: "例：梅田駅 徒歩5分（変更しない場合は空でOK）",
style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
</div>

<div style="margin:12px 0; padding:14px; border:1px solid #eee; border-radius:12px; background:#fffdf8;">
<div style="font-weight:800; font-size:16px; margin-bottom:8px;">営業時間</div>
<p style="margin:0 0 10px; color:#666; font-size:13px; line-height:1.7;">
曜日ごとの細かい入力はやめて、見たまま入れてください。<br>
例）月-木 17:00-23:00 / 金土 17:00-02:00 / 日 15:00-22:00<br>
例）11:30-14:00, 17:00-23:00 のように中休みもそのまま書けます。<br>
空欄なら変更しません。
</p>

<div style="margin-bottom:8px;">
<div style="font-weight:700; margin-bottom:6px;">定型文</div>
<div style="display:flex; gap:8px; flex-wrap:wrap;">
<button type="button" class="hours-preset-btn" data-target="shop_edit_request_proposed_opening_hours_text" data-value="毎日 17:00-23:00" style="padding:6px 10px; border:1px solid #ddd; background:#fff; border-radius:999px; cursor:pointer;">毎日 夜営業</button>
<button type="button" class="hours-preset-btn" data-target="shop_edit_request_proposed_opening_hours_text" data-value="月-金 11:30-14:00, 17:00-23:00 / 土日 12:00-23:00" style="padding:6px 10px; border:1px solid #ddd; background:#fff; border-radius:999px; cursor:pointer;">ランチ＋ディナー</button>
<button type="button" class="hours-preset-btn" data-target="shop_edit_request_proposed_opening_hours_text" data-value="火-日 18:00-24:00" style="padding:6px 10px; border:1px solid #ddd; background:#fff; border-radius:999px; cursor:pointer;">夜のみ</button>
<button type="button" class="hours-preset-btn" data-target="shop_edit_request_proposed_holiday_hours_text" data-value="通常営業と同じ" style="padding:6px 10px; border:1px solid #ddd; background:#fff; border-radius:999px; cursor:pointer;">祝日=通常営業</button>
<button type="button" class="hours-preset-btn" data-target="shop_edit_request_proposed_holiday_hours_text" data-value="休業" style="padding:6px 10px; border:1px solid #ddd; background:#fff; border-radius:999px; cursor:pointer;">祝日休業</button>
<button type="button" class="hours-preset-btn" data-target="shop_edit_request_proposed_closed_days_text" data-value="なし" style="padding:6px 10px; border:1px solid #ddd; background:#fff; border-radius:999px; cursor:pointer;">定休日なし</button>
<button type="button" class="hours-preset-btn" data-target="shop_edit_request_proposed_closed_days_text" data-value="不定休" style="padding:6px 10px; border:1px solid #ddd; background:#fff; border-radius:999px; cursor:pointer;">不定休</button>
<button type="button" class="hours-preset-btn" data-target="shop_edit_request_proposed_closed_days_text" data-value="月曜" style="padding:6px 10px; border:1px solid #ddd; background:#fff; border-radius:999px; cursor:pointer;">月曜休み</button>
<button type="button" class="hours-preset-btn" data-target="shop_edit_request_proposed_closed_days_text" data-value="水曜" style="padding:6px 10px; border:1px solid #ddd; background:#fff; border-radius:999px; cursor:pointer;">水曜休み</button>
</div>
</div>

<div style="margin-bottom:10px;">
<div style="font-weight:700; margin-bottom:4px;">通常営業時間</div>
<%= f.text_area :proposed_opening_hours_text,
rows: 3,
placeholder: "例）月-金 11:30-14:00, 17:00-23:00 / 土日 12:00-23:00",
style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;",
id: "shop_edit_request_proposed_opening_hours_text" %>
</div>

<div style="margin-bottom:10px;">
<div style="font-weight:700; margin-bottom:4px;">祝日営業時間</div>
<%= f.text_area :proposed_holiday_hours_text,
rows: 2,
placeholder: "例）12:00-23:00 / 通常営業と同じ / 休業",
style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;",
id: "shop_edit_request_proposed_holiday_hours_text" %>
</div>

<div>
<div style="font-weight:700; margin-bottom:4px;">定休日</div>
<%= f.text_field :proposed_closed_days_text,
placeholder: "例）水曜 / 不定休 / なし",
style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;",
id: "shop_edit_request_proposed_closed_days_text" %>
</div>

<% if @req.respond_to?(:proposed_opening_hours_json) && @req.proposed_opening_hours_json.present? %>
<p style="margin:10px 0 0; color:#8a6d3b; font-size:12px;">
※ 以前の曜日別データは残っていますが、今後の編集依頼はこの簡易入力を優先します。
</p>
<% end %>
</div>

<div style="margin:12px 0;">
<div style="font-weight:700;">電話番号（任意）</div>
<%= f.telephone_field :proposed_phone,
placeholder: "例：06-1234-5678（変更しない場合は空でOK）",
style: "width:100%; max-width:420px; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
</div>

<div style="margin:12px 0;">
  <div style="font-weight:700;">店舗詳細</div>
  <%= f.text_area :proposed_public_store_details,
  rows: 4,
  placeholder: "例：席で吸える / 21時以降だけOK / 喫煙可能な席の場所 / 利用時の補足など",
  style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
</div>



<div style="margin:16px 0; padding:14px; border:1px solid #eee; border-radius:12px; background:#fffdf8;">
  <div style="font-weight:800; font-size:16px; margin-bottom:8px;">店舗状態の報告</div>
  <p style="margin:0 0 10px; color:#666; font-size:13px; line-height:1.7;">
    営業終了・移転・休業・禁煙化などを見つけた場合はこちらから報告できます。<br>
    こちらを選んだ場合は、承認後に店舗は管理画面の保留一覧へ入ります。
  </p>

  <div style="margin:12px 0;">
    <div style="font-weight:700;">報告理由</div>
    <%= f.select :status_report_type,
      [
        ["（選択しない）", ""],
        ["営業終了", "closed"],
        ["移転", "relocated"],
        ["休業", "temporarily_closed"],
        ["禁煙店だった", "was_non_smoking"],
        ["禁煙店になった", "became_non_smoking"]
      ],
      {},
      style: "width:100%; max-width:420px; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
  </div>

  <div style="margin:12px 0 0;">
    <div style="font-weight:700;">報告メモ（任意）</div>
    <%= f.text_area :status_report_note,
      rows: 4,
      placeholder: "例：現地で閉店を確認 / 張り紙に移転先あり / 電話で禁煙化を確認 など",
      style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
  </div>
</div>

<hr>

<h3>喫煙ステータス（必須）</h3>
<p style="color:#666; font-size:12px; line-height:1.6;">
  ※ 上の「店舗状態の報告」を使う場合は、喫煙ステータス未入力でも送信できます
</p>

<div style="margin:12px 0;">
<div style="font-weight:700;">喫煙エリア（必須）</div>
<%= f.select :proposed_smoking_area,
[["喫煙所あり", "area_separated"], ["席で喫煙可", "area_all_smoking"], ["不明", "area_unknown"]],
{ include_blank: "選択してください" },
style: "width:100%; max-width:420px; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
</div>

<div style="margin:12px 0;">
<div style="font-weight:700;">喫煙タイプ（必須）</div>
<%= f.select :proposed_smoking_type,
[["紙・加熱式どちらもOK", "type_both_ok"],
["加熱式タバコのみOK", "type_electronic_only"],
["紙タバコのみOK", "type_paper_only"],
["不明", "type_unknown"]],
{ include_blank: "選択してください" },
style: "width:100%; max-width:420px; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
</div>

<hr>

<h3>写真（必須・編集依頼に添付）</h3>
<p style="color:#666; font-size:12px; line-height:1.6;">
※ 料理/内観/外観/メニューのどれでもOK。<strong>どれか1枚</strong>は必ず添付してください。<br>
※ ここで添付した写真は「編集依頼」に紐づきます（管理側で確認して店舗に反映）
</p>

<div style="margin:12px 0;">
<div style="font-weight:700;">料理の写真（複数OK）</div>
<%= f.file_field :food_photos, multiple: true, accept: "image/*" %>
</div>

<div style="margin:12px 0;">
<div style="font-weight:700;">内観の写真（複数OK）</div>
<%= f.file_field :interior_photos, multiple: true, accept: "image/*" %>
</div>

<div style="margin:12px 0;">
<div style="font-weight:700;">外観の写真（複数OK）</div>
<%= f.file_field :exterior_photos, multiple: true, accept: "image/*" %>
</div>

<div style="margin:12px 0;">
<div style="font-weight:700;">メニューの写真（複数OK）</div>
<%= f.file_field :menu_photos, multiple: true, accept: "image/*" %>
</div>

<hr>

<h3>サムネ候補（一覧に出す写真）</h3>

<div style="display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end; margin-top:10px;">
<div>
<div style="font-weight:700;">種類</div>
<%= f.select :proposed_thumbnail_kind,
[["自動（おすすめ）", "auto"], ["料理", "food"], ["外観", "exterior"], ["内観", "interior"], ["メニュー", "menu"]],
{ include_blank: "（変更しない）" },
style: "padding:10px; border:1px solid #ddd; border-radius:12px;" %>
</div>

<div>
<div style="font-weight:700;">何枚目（1〜）</div>
<%= f.number_field :proposed_thumbnail_index, in: 1..20, step: 1,
style: "width:160px; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
</div>
</div>

<div style="margin-top:18px;">
<%= f.submit "編集依頼を送る",
style: "padding:10px 14px; border:1px solid #111; border-radius:12px; background:#111; color:#fff; font-weight:700;" %>
</div>

<% end %>

<p style="margin-top:14px;">
<%= link_to "戻る", shop_path(@shop) %>
</p>

<script>
document.addEventListener("turbo:load", function() {
document.querySelectorAll(".hours-preset-btn").forEach(function(button) {
if (button.dataset.bound === "1") return;
button.dataset.bound = "1";

button.addEventListener("click", function() {
var target = document.getElementById(button.dataset.target);
if (!target) return;
target.value = button.dataset.value;
target.dispatchEvent(new Event("input", { bubbles: true }));
});
});
});
</script>