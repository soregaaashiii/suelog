<%# /Users/kawamuratakuya/Desktop/吸えログデータ/dev/suelog/app/views/shop_edit_requests/new.html.erb %>

<h1>編集依頼：<%= @shop.name %></h1>

<p style="color:#666; line-height:1.6;">
※ 依頼内容は管理者が確認して反映します（空欄は「変更しない」扱い）<br>
※ ただし <strong>喫煙ステータス</strong> と <strong>写真（どれか1枚）</strong> は編集依頼で必須です
</p>

<% if @req.errors.any? %>
<div style="border:1px solid #f5c2c7; background:#f8d7da; padding:12px; border-radius:10px; margin:12px 0;">
<div style="font-weight:800; margin-bottom:6px;">入力エラーがあります：</div>
<ul style="margin:0; padding-left:18px;">
<% @req.errors.full_messages.each do |msg| %>
<li><%= msg %></li>
<% end %>
</ul>
</div>
<% end %>

<%= form_with model: [@shop, @req], local: true, html: { multipart: true, novalidate: true } do |f| %>

<div style="margin:12px 0;">
<div style="font-weight:700;">あなたの名前（任意）</div>
<%= f.text_field :proposer_name,
style: "width:100%; max-width:520px; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
</div>

<hr>

<h3>変更案（任意）</h3>
<p style="color:#666; margin-top:0;">空なら変更しません</p>

<div style="margin:12px 0;">
<div style="font-weight:700;">店名</div>
<%= f.text_field :proposed_name,
placeholder: "（変更しない場合は空でOK）",
style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
</div>

<div style="margin:12px 0;">
<div style="font-weight:700;">ジャンル</div>
<%= f.select :genre,
Shop.genre_options.map { |genre| [genre, genre] },
{ include_blank: "（変更しない）" },
style: "width:100%; max-width:420px; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
</div>

<div style="margin:12px 0;">
<div style="font-weight:700;">その他（ジャンルが「その他」の時）</div>
<%= f.text_field :genre_other,
placeholder: "例：シーシャバー、ダーツバー（ジャンルが「その他」の時だけ）",
style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
</div>

<div style="margin:12px 0;">
<div style="font-weight:700;">住所</div>
<%= f.text_field :proposed_address,
placeholder: "（変更しない場合は空でOK）",
style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
</div>

<div style="margin:12px 0;">
<div style="font-weight:700;">最終確認日</div>
<%= f.date_field :proposed_last_confirmed_on, max: Date.current,
style: "padding:10px; border:1px solid #ddd; border-radius:12px;" %>
<div style="color:#666; font-size:12px; margin-top:6px;">※ 空なら変更しません</div>
</div>

<div style="margin:12px 0;">
<div style="font-weight:700;">最寄駅（任意）</div>
<%= f.text_field :proposed_nearest_station,
placeholder: "例：梅田駅 徒歩5分（変更しない場合は空でOK）",
style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
</div>

<div style="margin:12px 0; padding:14px; border:1px solid #eee; border-radius:12px; background:#fffdf8;" data-controller="hours-builder">
  <div style="font-weight:800; font-size:16px; margin-bottom:8px;">営業時間</div>

  <p style="margin:0 0 12px; color:#666; font-size:13px; line-height:1.7;">
    営業日にチェックを入れて、営業時間を選択してください。チェックなしの曜日は定休日として表示されます。<br>
    祝前・祝後は未設定なら平日と同じ営業時間として扱います。特別営業時間がある場合だけチェックしてください。<br>
    喫煙時間は未指定なら「営業時間中は喫煙可」として扱います。
  </p>

  <% days = [
    ["mon", "月"], ["tue", "火"], ["wed", "水"], ["thu", "木"], ["fri", "金"],
    ["sat", "土"], ["sun", "日"], ["holiday", "祝日"], ["pre_holiday", "祝前"], ["post_holiday", "祝後"]
  ] %>

  <% time_options = [["未設定", ""]] + (0..96).map { |i| t = "%02d:%02d" % [i / 4, (i % 4) * 15]; [t, t] } %>

  <div style="display:grid; gap:10px;">
    <% days.each do |key, label| %>
      <div data-hours-row="<%= key %>" style="padding:10px; border:1px solid #eadfca; border-radius:12px; background:#fff;">
        <label style="display:flex; align-items:center; gap:8px; font-weight:800; margin-bottom:8px;">
          <input type="checkbox" data-hours-open>
          <span style="width:42px;"><%= label %></span>
          <span style="font-size:12px; color:#777;"><%= %w[pre_holiday post_holiday].include?(key) ? "特別営業時間あり" : "営業日" %></span>
          <button type="button" data-copy-hours-to-all style="margin-left:auto; padding:6px 10px; border:1px solid #ddd; background:#fff; border-radius:999px; cursor:pointer; font-size:12px;">
            他の日に反映
          </button>
        </label>

        <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center; margin-bottom:8px;">
          <span style="font-size:12px; font-weight:700; color:#555;">営業時間1</span>
          <%= select_tag nil, options_for_select(time_options), data: { hours_start1: true }, style: "padding:8px; border:1px solid #ddd; border-radius:10px;" %>
          <span>〜</span>
          <%= select_tag nil, options_for_select(time_options), data: { hours_end1: true }, style: "padding:8px; border:1px solid #ddd; border-radius:10px;" %>

          <span style="font-size:12px; font-weight:700; color:#555;">営業時間2</span>
          <%= select_tag nil, options_for_select(time_options), data: { hours_start2: true }, style: "padding:8px; border:1px solid #ddd; border-radius:10px;" %>
          <span>〜</span>
          <%= select_tag nil, options_for_select(time_options), data: { hours_end2: true }, style: "padding:8px; border:1px solid #ddd; border-radius:10px;" %>
        </div>

        <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
          <label style="display:flex; align-items:center; gap:6px; font-size:12px; font-weight:700;">
            <input type="checkbox" data-smoking-same checked>
            喫煙時間は営業時間と同じ
          </label>

          <span style="font-size:12px; font-weight:700; color:#555;">喫煙可</span>
          <%= select_tag nil, options_for_select(time_options), data: { smoking_start: true }, style: "padding:8px; border:1px solid #ddd; border-radius:10px;" %>
          <span>〜</span>
          <%= select_tag nil, options_for_select(time_options), data: { smoking_end: true }, style: "padding:8px; border:1px solid #ddd; border-radius:10px;" %>
        </div>
      </div>
    <% end %>
  </div>

  <%= f.hidden_field :proposed_opening_hours_text, id: "shop_edit_request_proposed_opening_hours_text" %>
  <%= f.hidden_field :proposed_holiday_hours_text, id: "shop_edit_request_proposed_holiday_hours_text" %>
  <%= f.hidden_field :proposed_closed_days_text, id: "shop_edit_request_proposed_closed_days_text" %>

  <div style="margin-top:14px;">
    <div style="font-weight:700;">営業時間の補足（任意）</div>
    <p style="margin:4px 0 8px; color:#666; font-size:13px; line-height:1.7;">
      年末年始・ゴールデンウィーク・お盆など、通常と違う営業時間がある場合に入力してください。
    </p>
    <%= f.text_area :proposed_special_hours_note,
      rows: 3,
      placeholder: "例：年末年始は営業時間が変更になる場合があります。詳しくは店舗へご確認ください。",
      style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
  </div>
</div>



<div style="margin:12px 0;">
<div style="font-weight:700;">電話番号（任意）</div>
<%= f.telephone_field :proposed_phone,
placeholder: "例：06-1234-5678（変更しない場合は空でOK）",
style: "width:100%; max-width:420px; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
</div>

<div style="margin:12px 0;">
  <div style="font-weight:700;">店舗詳細</div>
  <%= f.text_area :proposed_public_store_details,
  rows: 4,
  placeholder: "例：席で吸える / 21時以降だけOK / 喫煙可能な席の場所 / 利用時の補足など",
  style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
</div>



<div style="margin:16px 0; padding:14px; border:1px solid #eee; border-radius:12px; background:#fffdf8;">
  <div style="font-weight:800; font-size:16px; margin-bottom:8px;">店舗状態の報告</div>
  <p style="margin:0 0 10px; color:#666; font-size:13px; line-height:1.7;">
    営業終了・移転・休業・禁煙化などを見つけた場合はこちらから報告できます。<br>
    こちらを選んだ場合は、承認後に店舗は管理画面の保留一覧へ入ります。
  </p>

  <div style="margin:12px 0;">
    <div style="font-weight:700;">報告理由</div>
    <%= f.select :status_report_type,
      [
        ["（選択しない）", ""],
        ["営業終了", "closed"],
        ["移転", "relocated"],
        ["休業", "temporarily_closed"],
        ["禁煙店だった", "was_non_smoking"],
        ["禁煙店になった", "became_non_smoking"]
      ],
      {},
      style: "width:100%; max-width:420px; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
  </div>

  <div style="margin:12px 0 0;">
    <div style="font-weight:700;">報告メモ（任意）</div>
    <%= f.text_area :status_report_note,
      rows: 4,
      placeholder: "例：現地で閉店を確認 / 張り紙に移転先あり / 電話で禁煙化を確認 など",
      style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
  </div>
</div>

<hr>

<h3>喫煙ステータス（必須）</h3>
<p style="color:#666; font-size:12px; line-height:1.6;">
  ※ 上の「店舗状態の報告」を使う場合は、喫煙ステータス未入力でも送信できます
</p>

<div style="margin:12px 0;">
<div style="font-weight:700;">喫煙エリア（必須）</div>
<%= f.select :proposed_smoking_area,
[["喫煙所あり", "area_separated"], ["席で喫煙可", "area_all_smoking"], ["不明", "area_unknown"]],
{ include_blank: "選択してください" },
style: "width:100%; max-width:420px; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
</div>

<div style="margin:12px 0;">
<div style="font-weight:700;">喫煙タイプ（必須）</div>
<%= f.select :proposed_smoking_type,
[["紙・加熱式どちらもOK", "type_both_ok"],
["加熱式タバコのみOK", "type_electronic_only"],
["紙タバコのみOK", "type_paper_only"],
["不明", "type_unknown"]],
{ include_blank: "選択してください" },
style: "width:100%; max-width:420px; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
</div>

<div style="margin:12px 0;">
<div style="font-weight:700;">喫煙エリア2（任意）</div>
<%= f.select :proposed_smoking_area_2,
[["喫煙所あり", "area_separated"], ["席で喫煙可", "area_all_smoking"], ["不明", "area_unknown"]],
{ include_blank: "条件が1つなら空欄" },
style: "width:100%; max-width:420px; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
</div>

<div style="margin:12px 0;">
<div style="font-weight:700;">喫煙タイプ2（任意）</div>
<%= f.select :proposed_smoking_type_2,
[["紙・加熱式どちらもOK", "type_both_ok"], ["加熱式タバコのみOK", "type_electronic_only"], ["紙タバコのみOK", "type_paper_only"], ["不明", "type_unknown"]],
{ include_blank: "条件が1つなら空欄" },
style: "width:100%; max-width:420px; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
</div>

<hr>

<h3>現在登録されている写真</h3>
<p style="color:#666; font-size:12px; line-height:1.6;">
※ すでに登録されている写真です。ここから削除はできません。追加したい写真だけ下から送信してください。
</p>

<% {
food_photos: "料理写真",
interior_photos: "内観写真",
exterior_photos: "外観写真",
menu_photos: "メニュー写真"
}.each do |field, label| %>
<div style="margin:12px 0; padding:12px; border:1px solid #eee; border-radius:12px; background:#fafafa;">
<div style="font-weight:800; margin-bottom:8px;"><%= label %></div>

<% photos = @shop.public_send(field) %>

<% if photos.attached? %>
<div style="display:flex; gap:10px; flex-wrap:wrap;">
<% photos.each do |photo| %>
<div style="width:120px; padding:8px; border:1px solid #e5e7eb; border-radius:10px; background:#fff;">
<%= image_tag photo,
style: "width:100%; height:86px; object-fit:cover; border-radius:8px; display:block;" %>
</div>
<% end %>

<div id="<%= field.to_s.sub('_photos', '').sub('food', 'food').sub('interior', 'interior').sub('exterior', 'exterior').sub('menu', 'menu') %>-preview" style="display:flex; gap:10px; flex-wrap:wrap;"></div>
</div>
<% else %>
<p style="margin:0 0 10px; color:#777; font-size:13px;">現在の写真はありません。</p>
<div id="<%= field.to_s.sub('_photos', '').sub('food', 'food').sub('interior', 'interior').sub('exterior', 'exterior').sub('menu', 'menu') %>-preview" style="display:flex; gap:10px; flex-wrap:wrap;"></div>
<% end %>
</div>
<% end %>

<hr>

<h3>写真（必須・編集依頼に添付）</h3>
<p style="color:#666; font-size:12px; line-height:1.6;">
※ 料理/内観/外観/メニューのどれでもOK。<strong>どれか1枚</strong>は必ず添付してください。<br>
※ ここで添付した写真は「編集依頼」に紐づきます（管理側で確認して店舗に反映）
</p>

<div style="margin:12px 0;">
<div style="font-weight:700;">料理の写真（複数OK）</div>
<%= f.file_field :food_photos, multiple: true, accept: "image/*", data: { preview_target: "food-preview" } %>
</div>

<div style="margin:12px 0;">
<div style="font-weight:700;">内観の写真（複数OK）</div>
<%= f.file_field :interior_photos, multiple: true, accept: "image/*", data: { preview_target: "interior-preview" } %>
</div>

<div style="margin:12px 0;">
<div style="font-weight:700;">外観の写真（複数OK）</div>
<%= f.file_field :exterior_photos, multiple: true, accept: "image/*", data: { preview_target: "exterior-preview" } %>
</div>

<div style="margin:12px 0;">
<div style="font-weight:700;">メニューの写真（複数OK）</div>
<%= f.file_field :menu_photos, multiple: true, accept: "image/*", data: { preview_target: "menu-preview" } %>
</div>

<hr>

<h3>サムネ候補（一覧に出す写真）</h3>

<div style="display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end; margin-top:10px;">
<div>
<div style="font-weight:700;">種類</div>
<%= f.select :proposed_thumbnail_kind,
[["自動（おすすめ）", "auto"], ["料理", "food"], ["外観", "exterior"], ["内観", "interior"], ["メニュー", "menu"]],
{ include_blank: "（変更しない）" },
style: "padding:10px; border:1px solid #ddd; border-radius:12px;" %>
</div>

<div>
<div style="font-weight:700;">何枚目（1〜）</div>
<%= f.number_field :proposed_thumbnail_index, in: 1..20, step: 1,
style: "width:160px; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
</div>
</div>

<div style="margin-top:18px;">
<%= f.submit "編集依頼を送る",
style: "padding:10px 14px; border:1px solid #111; border-radius:12px; background:#111; color:#fff; font-weight:700;" %>
</div>

<% end %>

<p style="margin-top:14px;">
<%= link_to "戻る", shop_path(@shop) %>
</p>

<script>
(function() {
  function bindHoursPresetButtons() {
    document.querySelectorAll(".hours-preset-btn").forEach(function(button) {
      if (button.dataset.bound === "1") return;
      button.dataset.bound = "1";

      button.addEventListener("click", function(event) {
        event.preventDefault();

        var targetId = button.dataset.target;
        var value = button.dataset.value;
        var target = document.getElementById(targetId);

        if (!target) return;

        target.value = value;
        target.dispatchEvent(new Event("input", { bubbles: true }));
        target.dispatchEvent(new Event("change", { bubbles: true }));
      });
    });
  }

  function bindPhotoPreviews() {
    document.querySelectorAll("input[type='file'][data-preview-target]").forEach(function(input) {
      if (input.dataset.previewBound === "1") return;
      input.dataset.previewBound = "1";

      input.addEventListener("change", function() {
        renderPreview(input);
      });
    });
  }

  function renderPreview(input) {
    var target = document.getElementById(input.dataset.previewTarget);
    if (!target) return;

    target.innerHTML = "";

    Array.from(input.files).forEach(function(file, index) {
      if (!file.type.match(/^image\//)) return;

      var reader = new FileReader();

      reader.onload = function(e) {
        var box = document.createElement("div");
        box.style.cssText = "position:relative; width:120px; padding:8px; border:1px solid #e5e7eb; border-radius:10px; background:#fff;";

        var img = document.createElement("img");
        img.src = e.target.result;
        img.style.cssText = "width:100%; height:86px; object-fit:cover; border-radius:8px; display:block;";

        var remove = document.createElement("button");
        remove.type = "button";
        remove.textContent = "×";
        remove.style.cssText = "position:absolute; top:2px; right:2px; width:24px; height:24px; border-radius:999px; border:1px solid #b00020; background:#fff; color:#b00020; font-weight:900; cursor:pointer;";

        remove.addEventListener("click", function() {
          removeFile(input, index);
          renderPreview(input);
        });

        box.appendChild(img);
        box.appendChild(remove);
        target.appendChild(box);
      };

      reader.readAsDataURL(file);
    });
  }

  function removeFile(input, removeIndex) {
    var dt = new DataTransfer();

    Array.from(input.files).forEach(function(file, index) {
      if (index !== removeIndex) dt.items.add(file);
    });

    input.files = dt.files;
  }



  document.addEventListener("DOMContentLoaded", bindHoursPresetButtons);
  document.addEventListener("turbo:load", bindHoursPresetButtons);
  document.addEventListener("DOMContentLoaded", bindPhotoPreviews);
  document.addEventListener("turbo:load", bindPhotoPreviews);

})();
</script>
