<%# /Users/kawamuratakuya/Desktop/吸えログデータ/dev/suelog/app/views/admin/shop_edit_requests/show.html.erb %>

<%
opening_hours_text =
if @req.respond_to?(:proposed_opening_hours_text)
@req.proposed_opening_hours_text.to_s.strip
elsif @req.respond_to?(:opening_hours_text)
@req.opening_hours_text.to_s.strip
else
""
end

holiday_hours_text =
if @req.respond_to?(:proposed_holiday_hours_text)
@req.proposed_holiday_hours_text.to_s.strip
elsif @req.respond_to?(:holiday_hours_text)
@req.holiday_hours_text.to_s.strip
else
""
end

closed_days_text =
if @req.respond_to?(:proposed_closed_days_text)
@req.proposed_closed_days_text.to_s.strip
elsif @req.respond_to?(:closed_days_text)
@req.closed_days_text.to_s.strip
else
""
end

legacy_opening_hours =
if @req.respond_to?(:proposed_opening_hours)
@req.proposed_opening_hours.to_s.strip
else
""
end

current_note = @shop.note.to_s
requested_note = @req.note.to_s.strip
after_note = requested_note.present? ? requested_note : current_note

final_name = @req.proposed_name.to_s.strip.presence || @shop.name
final_address = @req.proposed_address.to_s.strip.presence || @shop.address
final_area = @req.proposed_area.to_s.strip.presence || @shop.area
final_nearest_station = @req.proposed_nearest_station.to_s.strip.presence || @shop.nearest_station
final_phone = @req.proposed_phone.to_s.strip.presence || @shop.phone
final_last_confirmed_on = @req.proposed_last_confirmed_on.presence || @shop.last_confirmed_on

final_smoking_area =
case @req.proposed_smoking_area.to_s.strip
when "area_all_smoking", "proposed_area_all_smoking"
"all_smoking"
when "area_separated", "proposed_area_separated"
"separated"
when "area_unknown", "proposed_area_unknown"
"unknown"
else
@shop.smoking_area
end

final_smoking_type =
case @req.proposed_smoking_type.to_s.strip
when "type_both_ok", "proposed_type_both_ok"
"both_ok"
when "type_electronic_only", "proposed_type_electronic_only"
"electronic_only"
when "type_paper_only", "proposed_type_paper_only"
"paper_only"
when "type_unknown", "proposed_type_unknown"
"unknown"
else
@shop.smoking_type
end

final_genre = @req.genre.to_s.strip.presence || @shop.genre

final_genre_other =
if final_genre == "その他"
@req.genre_other.to_s.strip.presence || @shop.genre_other
else
""
end

final_opening_hours_text = opening_hours_text.presence || @shop.try(:opening_hours_text)
final_holiday_hours_text = holiday_hours_text.presence || @shop.try(:holiday_hours_text)
final_closed_days_text = closed_days_text.presence || @shop.try(:closed_days_text)
final_special_hours_note =
  if @req.respond_to?(:proposed_special_hours_note)
    @req.proposed_special_hours_note.to_s.strip.presence || @shop.try(:special_hours_note)
  else
    @shop.try(:special_hours_note)
  end
final_note = requested_note.presence || @shop.note
final_thumbnail_kind = (@req.try(:proposed_thumbnail_kind).presence || @shop.try(:thumbnail_kind) || "auto").to_s
final_thumbnail_index = (@req.try(:proposed_thumbnail_index).presence || @shop.try(:thumbnail_index) || 1).to_i

status_pending = @req.pending?
%>

<h1>編集依頼 詳細（管理）</h1>

<p style="color:#666; margin:6px 0 12px;">
店舗：
<%= link_to @shop.name, shop_path(@shop), target: "_blank", rel: "noopener" %><br>
依頼者：<%= @req.proposer_name.presence || "匿名" %>
／ <%= @req.created_at.strftime("%Y-%m-%d %H:%M") %><br>
状態：<strong><%= @req.status %></strong>
</p>

<% if @req.status_report_type.to_s.present? %>
<div style="margin:0 0 12px; padding:12px; border:1px solid #f3b2b2; background:#fff5f5; border-radius:12px;">
<div style="margin-bottom:8px;">
<span style="display:inline-flex; align-items:center; padding:4px 10px; border-radius:999px; font-size:12px; font-weight:800; background:#ffe9e9; color:#b00020; border:1px solid #f3b2b2;">
状態報告：<%= @req.status_report_type_label %>
</span>
</div>

<div style="color:#555; font-size:13px;">
<strong>報告メモ：</strong>
<%= @req.status_report_note.present? ? @req.status_report_note : "（なし）" %>
</div>
</div>
<% end %>

<div style="display:flex; gap:10px; flex-wrap:wrap; margin:0 0 12px;">
<%= link_to "一覧に戻る",
admin_shop_edit_requests_path(status: "pending"),
style: "padding:10px 14px; border:1px solid #ddd; border-radius:10px; text-decoration:none; display:inline-block;" %>

<% if status_pending %>
<%= button_to "却下",
reject_admin_shop_edit_request_path(@req),
method: :patch,
form: { data: { turbo: false } },
data: { turbo_confirm: "却下しますか？" } %>
<% end %>
</div>

<% if flash[:alert].present? %>
<div style="padding:10px; border:1px solid #f5c2c7; background:#f8d7da; border-radius:10px; margin:10px 0;">
<%= flash[:alert] %>
</div>
<% end %>

<% if flash[:notice].present? %>
<div style="padding:10px; border:1px solid #b6d7a8; background:#e6f4ea; border-radius:10px; margin:10px 0;">
<%= flash[:notice] %>
</div>
<% end %>

<h2 style="margin:0 0 8px;">変更比較</h2>

<table style="width:100%; border-collapse:collapse; margin:0 0 16px;">
  <thead>
    <tr style="border-bottom:2px solid #111;">
      <th align="left" style="padding:8px;">項目</th>
      <th align="left" style="padding:8px;">現在</th>
      <th align="left" style="padding:8px;">提案</th>
      <th align="left" style="padding:8px;">判定</th>
    </tr>
  </thead>
  <tbody>
    <% compare_rows = [
      ["店名", @shop.name.to_s, @req.proposed_name.to_s],
      ["住所", @shop.address.to_s, @req.proposed_address.to_s],
      ["エリア", @shop.area.to_s, @req.proposed_area.to_s],
      ["最寄駅", @shop.nearest_station.to_s, @req.proposed_nearest_station.to_s],
      ["電話", @shop.phone.to_s, @req.proposed_phone.to_s],
      ["通常営業時間", @shop.try(:opening_hours_text).to_s, opening_hours_text.to_s],
      ["祝日営業時間", @shop.try(:holiday_hours_text).to_s, holiday_hours_text.to_s],
      ["定休日", @shop.try(:closed_days_text).to_s, closed_days_text.to_s],
      ["営業時間補足", @shop.try(:special_hours_note).to_s, (@req.respond_to?(:proposed_special_hours_note) ? @req.proposed_special_hours_note.to_s : "")],
      ["補足", @shop.note.to_s, @req.note.to_s]
    ] %>

    <% compare_rows.each do |label, current_value, proposed_value| %>
      <% current_text = current_value.to_s.strip %>
      <% proposed_text = proposed_value.to_s.strip %>
      <% changed = proposed_text.present? && proposed_text != current_text %>

      <tr style="border-bottom:1px solid #ddd; vertical-align:top;">
        <td style="padding:8px; font-weight:700;"><%= label %></td>
        <td style="padding:8px;"><%= current_text.presence || "—" %></td>
        <td style="padding:8px;"><%= proposed_text.presence || "—" %></td>
        <td style="padding:8px;">
          <% if changed %>
            <span style="display:inline-flex; align-items:center; padding:3px 8px; border-radius:999px; font-size:11px; font-weight:800; background:#eef8f0; color:#137333; border:1px solid #b7dfbf;">
              変更あり
            </span>
          <% else %>
            <span style="display:inline-flex; align-items:center; padding:3px 8px; border-radius:999px; font-size:11px; font-weight:800; background:#f5f5f5; color:#666; border:1px solid #ddd;">
              変更なし
            </span>
          <% end %>
        </td>
      </tr>
    <% end %>

    <% current_smoking_area_label =
      case @shop.smoking_area.to_s
      when "all_smoking" then "席で喫煙可"
      when "separated" then "喫煙所あり"
      when "unknown" then "不明"
      else "—"
      end %>

    <% proposed_smoking_area_label =
      case @req.proposed_smoking_area.to_s
      when "area_all_smoking", "proposed_area_all_smoking" then "席で喫煙可"
      when "area_separated", "proposed_area_separated" then "喫煙所あり"
      when "area_unknown", "proposed_area_unknown" then "不明"
      else ""
      end %>

    <% area_changed = proposed_smoking_area_label.present? && proposed_smoking_area_label != current_smoking_area_label %>

    <tr style="border-bottom:1px solid #ddd; vertical-align:top;">
      <td style="padding:8px; font-weight:700;">喫煙エリア</td>
      <td style="padding:8px;"><%= current_smoking_area_label %></td>
      <td style="padding:8px;"><%= proposed_smoking_area_label.presence || "—" %></td>
      <td style="padding:8px;">
        <% if area_changed %>
          <span style="display:inline-flex; align-items:center; padding:3px 8px; border-radius:999px; font-size:11px; font-weight:800; background:#eef8f0; color:#137333; border:1px solid #b7dfbf;">
            変更あり
          </span>
        <% else %>
          <span style="display:inline-flex; align-items:center; padding:3px 8px; border-radius:999px; font-size:11px; font-weight:800; background:#f5f5f5; color:#666; border:1px solid #ddd;">
            変更なし
          </span>
        <% end %>
      </td>
    </tr>

    <% current_smoking_type_label =
      case @shop.smoking_type.to_s
      when "both_ok" then "紙・加熱式どちらもOK"
      when "electronic_only" then "加熱式タバコのみOK"
      when "paper_only" then "紙タバコのみOK"
      when "unknown" then "不明"
      else "—"
      end %>

    <% proposed_smoking_type_label =
      case @req.proposed_smoking_type.to_s
      when "type_both_ok", "proposed_type_both_ok" then "紙・加熱式どちらもOK"
      when "type_electronic_only", "proposed_type_electronic_only" then "加熱式タバコのみOK"
      when "type_paper_only", "proposed_type_paper_only" then "紙タバコのみOK"
      when "type_unknown", "proposed_type_unknown" then "不明"
      else ""
      end %>

    <% type_changed = proposed_smoking_type_label.present? && proposed_smoking_type_label != current_smoking_type_label %>

    <tr style="border-bottom:1px solid #ddd; vertical-align:top;">
      <td style="padding:8px; font-weight:700;">喫煙タイプ</td>
      <td style="padding:8px;"><%= current_smoking_type_label %></td>
      <td style="padding:8px;"><%= proposed_smoking_type_label.presence || "—" %></td>
      <td style="padding:8px;">
        <% if type_changed %>
          <span style="display:inline-flex; align-items:center; padding:3px 8px; border-radius:999px; font-size:11px; font-weight:800; background:#eef8f0; color:#137333; border:1px solid #b7dfbf;">
            変更あり
          </span>
        <% else %>
          <span style="display:inline-flex; align-items:center; padding:3px 8px; border-radius:999px; font-size:11px; font-weight:800; background:#f5f5f5; color:#666; border:1px solid #ddd;">
            変更なし
          </span>
        <% end %>
      </td>
    </tr>
  </tbody>
</table>

<hr>

<h2 style="margin:0 0 8px;">変更案</h2>

<div style="border:1px solid #ddd; border-radius:12px; padding:12px; background:#fff;">
<p style="margin:0 0 8px;"><strong>店名：</strong><%= @req.proposed_name.presence || "（未変更）" %></p>

<p style="margin:0 0 8px;">
<strong>ジャンル：</strong>
<% g = @req.genre.presence ? (@req.genre.to_s == "その他" ? @req.genre_other.to_s : @req.genre.to_s) : "" %>
<%= g.presence || "（未変更）" %>
</p>

<p style="margin:0 0 8px;"><strong>住所：</strong><%= @req.proposed_address.presence || "（未変更）" %></p>
<p style="margin:0 0 8px;"><strong>エリア：</strong><%= @req.proposed_area.presence || "（未変更）" %></p>
<p style="margin:0 0 8px;"><strong>最寄駅：</strong><%= @req.proposed_nearest_station.presence || "（未変更）" %></p>
<p style="margin:0 0 8px;"><strong>電話：</strong><%= @req.proposed_phone.presence || "（未変更）" %></p>
<p style="margin:0 0 8px;"><strong>最終確認日：</strong><%= @req.proposed_last_confirmed_on.presence || "（未変更）" %></p>

<p style="margin:0 0 8px;">
<strong>通常営業時間：</strong><br>
<%= opening_hours_text.present? ? simple_format(h(opening_hours_text)) : "（未変更）" %>
</p>

<p style="margin:0 0 8px;">
<strong>祝日営業時間：</strong><br>
<%= holiday_hours_text.present? ? simple_format(h(holiday_hours_text)) : "（未変更）" %>
</p>

<p style="margin:0 0 8px;">
<strong>定休日：</strong><br>
<%= closed_days_text.present? ? simple_format(h(closed_days_text)) : "（未変更）" %>
</p>

<p style="margin:0 0 8px;">
<strong>営業時間補足：</strong><br>
<%= @req.respond_to?(:proposed_special_hours_note) && @req.proposed_special_hours_note.present? ? simple_format(h(@req.proposed_special_hours_note.to_s)) : "（未変更）" %>
</p>

<% if opening_hours_text.blank? && holiday_hours_text.blank? && closed_days_text.blank? %>
<p style="margin:0 0 8px;">
<strong>旧営業時間欄：</strong><br>
<%= legacy_opening_hours.present? ? simple_format(h(legacy_opening_hours)) : "（未変更）" %>
</p>
<% end %>

<p style="margin:0 0 8px;">
<strong>喫煙エリア：</strong>
<%= case @req.proposed_smoking_area.to_s
when "area_all_smoking", "proposed_area_all_smoking" then "席で喫煙可"
when "area_separated", "proposed_area_separated" then "喫煙所あり"
when "area_unknown", "proposed_area_unknown" then "不明"
else "（未変更）"
end %>
</p>

<p style="margin:0 0 8px;">
<strong>喫煙タイプ：</strong>
<%= case @req.proposed_smoking_type.to_s
when "type_both_ok", "proposed_type_both_ok" then "紙・加熱式どちらもOK"
when "type_electronic_only", "proposed_type_electronic_only" then "加熱式タバコのみOK"
when "type_paper_only", "proposed_type_paper_only" then "紙タバコのみOK"
when "type_unknown", "proposed_type_unknown" then "不明"
else "（未変更）"
end %>
</p>

<p style="margin:0;">
<strong>補足（この依頼の note）：</strong><br>
<%= @req.note.present? ? simple_format(h(@req.note.to_s)) : "（なし）" %>
</p>
</div>

<hr>

<h2 style="margin:0 0 8px;">メモ反映の見え方（重要）</h2>

<div style="border:1px solid #eee; border-radius:12px; padding:12px; background:#fafafa;">
<p style="margin:0 0 8px;"><strong>現在の店舗 note：</strong></p>
<% if current_note.present? %>
<div style="border:1px solid #eee; background:#fff; border-radius:10px; padding:10px;">
<%= simple_format(h(current_note)) %>
</div>
<% else %>
<p style="margin:0; color:#666;">（なし）</p>
<% end %>

<p style="margin:14px 0 8px;"><strong>承認後の店舗 note（想定）：</strong></p>
<% if after_note.present? %>
<div style="border:1px solid #eee; background:#fff; border-radius:10px; padding:10px;">
<%= simple_format(h(after_note)) %>
</div>
<% if requested_note.blank? %>
<p style="margin:6px 0 0; color:#666; font-size:12px;">※ 依頼 note が空なので、店舗 note は変更されません</p>
<% end %>
<% else %>
<p style="margin:0; color:#666;">（なし）</p>
<% end %>
</div>

<hr>

<h2 style="margin:0 0 8px;">承認時に反映する内容（ここで編集可）</h2>

<% if status_pending %>
<%= form_with url: approve_admin_shop_edit_request_path(@req),
method: :patch, local: true, data: { turbo: false } do %>

<div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; max-width:1100px;">

<div>
<div style="font-weight:700;">店名</div>
<input type="text" name="shop[name]" value="<%= final_name %>" style="width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;">
</div>

<div>
<div style="font-weight:700;">電話</div>
<input type="text" name="shop[phone]" value="<%= final_phone %>" style="width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;">
</div>

<div style="grid-column:1/-1;">
<div style="font-weight:700;">住所</div>
<input type="text" name="shop[address]" value="<%= final_address %>" style="width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;">
</div>

<div>
<div style="font-weight:700;">エリア</div>
<input type="text" name="shop[area]" value="<%= final_area %>" style="width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;">
</div>

<div>
<div style="font-weight:700;">最寄駅</div>
<input type="text" name="shop[nearest_station]" value="<%= final_nearest_station %>" style="width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;">
</div>

<div>
<div style="font-weight:700;">最終確認日</div>
<input type="date" name="shop[last_confirmed_on]" value="<%= final_last_confirmed_on %>" style="width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;">
</div>

<div>
<div style="font-weight:700;">ジャンル</div>
<select name="shop[genre]" style="width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;">
<% ([["未設定", ""]] + Shop.genre_options.map { |genre| [genre, genre] }).each do |label, value| %>
<option value="<%= value %>" <%= "selected" if final_genre.to_s == value.to_s %>><%= label %></option>
<% end %>
</select>
</div>

<div>
<div style="font-weight:700;">ジャンルその他</div>
<input type="text" name="shop[genre_other]" value="<%= final_genre_other %>" style="width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;">
</div>

<div>
<div style="font-weight:700;">喫煙エリア</div>
<select name="shop[smoking_area]" style="width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;">
<option value="">選択してください</option>
<option value="all_smoking" <%= "selected" if final_smoking_area.to_s == "all_smoking" %>>席で喫煙可</option>
<option value="separated" <%= "selected" if final_smoking_area.to_s == "separated" %>>喫煙所あり</option>
<option value="unknown" <%= "selected" if final_smoking_area.to_s == "unknown" %>>不明</option>
</select>
</div>

<div>
<div style="font-weight:700;">喫煙タイプ</div>
<select name="shop[smoking_type]" style="width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;">
<option value="">選択してください</option>
<option value="both_ok" <%= "selected" if final_smoking_type.to_s == "both_ok" %>>紙・加熱式どちらもOK</option>
<option value="electronic_only" <%= "selected" if final_smoking_type.to_s == "electronic_only" %>>加熱式タバコのみOK</option>
<option value="paper_only" <%= "selected" if final_smoking_type.to_s == "paper_only" %>>紙タバコのみOK</option>
<option value="unknown" <%= "selected" if final_smoking_type.to_s == "unknown" %>>不明</option>
</select>
</div>

<div style="grid-column:1/-1;">
<div style="font-weight:700;">通常営業時間</div>
<textarea name="shop[opening_hours_text]" rows="3" style="width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;"><%= final_opening_hours_text %></textarea>
</div>

<div style="grid-column:1/-1;">
<div style="font-weight:700;">祝日営業時間</div>
<textarea name="shop[holiday_hours_text]" rows="2" style="width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;"><%= final_holiday_hours_text %></textarea>
</div>

<div style="grid-column:1/-1;">
<div style="font-weight:700;">定休日</div>
<input type="text" name="shop[closed_days_text]" value="<%= final_closed_days_text %>" style="width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;">
</div>

<div style="grid-column:1/-1;">
<div style="font-weight:700;">営業時間補足</div>
<textarea name="shop[special_hours_note]" rows="3" style="width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;"><%= final_special_hours_note %></textarea>
</div>

<div style="grid-column:1/-1;">
<div style="font-weight:700;">メモ</div>
<textarea name="shop[note]" rows="5" style="width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;"><%= final_note %></textarea>
</div>
</div>

<hr>

<h2 style="margin:0 0 8px;">添付写真（編集依頼に紐づく）</h2>
<p style="color:#666; font-size:12px; margin:0 0 10px;">
※ 画像表示が重いので、サムネではなくリンク表示にしています。クリックで別タブ表示できます。<br>
※ ここで「反映する」にチェックした写真だけ、店舗に追加で取り込みます（既存写真は消しません）
</p>

<% [
["料理", "food", (@req.respond_to?(:food_photos) ? @req.food_photos : nil)],
["内観", "interior", (@req.respond_to?(:interior_photos) ? @req.interior_photos : nil)],
["外観", "exterior", (@req.respond_to?(:exterior_photos) ? @req.exterior_photos : nil)],
["メニュー", "menu", (@req.respond_to?(:menu_photos) ? @req.menu_photos : nil)]
].each do |label, key, attachments| %>
<div style="margin:14px 0;">
<h3 style="margin:0 0 8px;"><%= label %></h3>

<% if attachments.present? && attachments.attached? %>
<div style="display:flex; gap:10px; flex-wrap:wrap;">
<% attachments.attachments.each_with_index do |att, i| %>
<div style="width:170px;">
<%= link_to rails_blob_path(att, only_path: true), target: "_blank", rel: "noopener", style: "text-decoration:none;" do %>
<div style="width:170px; height:120px; display:flex; align-items:center; justify-content:center; background:#f7f7f7; color:#666; font-size:12px; text-align:center; padding:8px; box-sizing:border-box; border:1px solid #ddd; border-radius:12px;">
画像を開く<br>（<%= i + 1 %>枚目）
</div>
<% end %>

<label style="display:flex; gap:8px; align-items:center; margin-top:8px;">
<input type="checkbox"
name="apply[<%= key %>_blob_ids][]"
value="<%= att.blob_id %>"
checked>
<span style="font-size:12px;">反映する</span>
</label>
</div>
<% end %>
</div>
<% else %>
<p style="color:#666; margin:0;">（添付なし）</p>
<% end %>
</div>
<% end %>

<hr>

<h2 style="margin:0 0 8px;">サムネ反映（任意）</h2>
<p style="color:#666; font-size:12px; margin:0 0 10px;">
※ ここで指定すると、店舗側の <code>thumbnail_kind / thumbnail_index</code> を更新します
</p>

<div style="display:flex; gap:12px; flex-wrap:wrap; align-items:end;">
<div>
<label>サムネ種類</label><br>
<select name="apply[thumbnail_kind]">
<option value="auto" <%= "selected" if final_thumbnail_kind == "auto" %>>自動</option>
<option value="food" <%= "selected" if final_thumbnail_kind == "food" %>>料理</option>
<option value="exterior" <%= "selected" if final_thumbnail_kind == "exterior" %>>外観</option>
<option value="interior" <%= "selected" if final_thumbnail_kind == "interior" %>>内観</option>
<option value="menu" <%= "selected" if final_thumbnail_kind == "menu" %>>メニュー</option>
</select>
</div>

<div>
<label>何枚目（1〜）</label><br>
<input type="number" name="apply[thumbnail_index]" min="1" max="20" value="<%= final_thumbnail_index %>" style="width:140px;">
</div>
</div>

<div style="display:flex; gap:10px; margin-top:16px; flex-wrap:wrap;">
<%= submit_tag "承認して反映",
data: { turbo_confirm: "承認して反映しますか？（チェックした写真は店舗に追加されます）" } %>
</div>
<% end %>
<% else %>
<p style="color:#666;">※ この依頼は pending ではないため、反映操作はできません。</p>
<% end %>