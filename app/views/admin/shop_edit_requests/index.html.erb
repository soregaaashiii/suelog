<%# /Users/kawamuratakuya/Desktop/吸えログデータ/dev/suelog/app/views/admin/shop_edit_requests/index.html.erb %>

<h1>編集依頼一覧</h1>

<p style="color:#666; margin-bottom:16px;">
店舗情報の編集依頼を確認できます。
</p>

<div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:16px;">
<%= link_to "承認待ち", admin_shop_edit_requests_path(status: "pending"), style: "padding:8px 12px; border:1px solid #ddd; border-radius:999px; text-decoration:none; color:#111;" %>
<%= link_to "承認済み", admin_shop_edit_requests_path(status: "approved"), style: "padding:8px 12px; border:1px solid #ddd; border-radius:999px; text-decoration:none; color:#111;" %>
<%= link_to "却下", admin_shop_edit_requests_path(status: "rejected"), style: "padding:8px 12px; border:1px solid #ddd; border-radius:999px; text-decoration:none; color:#111;" %>
<%= link_to "すべて", admin_shop_edit_requests_path(status: "all"), style: "padding:8px 12px; border:1px solid #ddd; border-radius:999px; text-decoration:none; color:#111;" %>
</div>

<% if flash[:notice].present? %>
<div style="padding:10px; border:1px solid #b6d7a8; background:#e6f4ea; border-radius:10px; margin:10px 0;">
<%= flash[:notice] %>
</div>
<% end %>

<% if flash[:alert].present? %>
<div style="padding:10px; border:1px solid #f5c2c7; background:#f8d7da; border-radius:10px; margin:10px 0;">
<%= flash[:alert] %>
</div>
<% end %>

<% requests = @requests || @edit_requests || @reqs || @shop_edit_requests || [] %>

<% if requests.present? %>
<div style="display:grid; gap:12px; max-width:1100px;">
<% requests.each do |req| %>
<% next if req.nil? %>

<section style="border:1px solid #ddd; border-radius:12px; padding:16px; background:#fff;">
<div style="display:grid; grid-template-columns:180px 1fr; gap:8px 12px; line-height:1.8;">
<div><strong>依頼ID</strong></div>
<div><%= req.id %></div>

<div><strong>状態</strong></div>
<div><%= req.status.presence || "未設定" %></div>

<div><strong>店舗</strong></div>
<div><%= req.shop&.name || "不明" %></div>

<div><strong>提案者</strong></div>
<div><%= req.respond_to?(:proposer_name) ? (req.proposer_name.presence || "未入力") : "未入力" %></div>

<div><strong>作成日時</strong></div>
<div><%= req.created_at.present? ? req.created_at.strftime("%Y-%m-%d %H:%M") : "未設定" %></div>
</div>

<div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:14px;">
<%= link_to "詳細を見る",
admin_shop_edit_request_path(req, status: params[:status].presence || "pending"),
style: "padding:10px 14px; border:1px solid #ddd; border-radius:10px; text-decoration:none; color:#111;" %>
</div>
</section>
<% end %>
</div>
<% else %>
<div style="border:1px solid #ddd; border-radius:12px; padding:16px; background:#fff;">
現在、編集依頼はありません。
</div>
<% end %>