<h1>編集依頼一覧</h1>

<p style="color:#666; margin-bottom:16px;">
ステータス：
<%= link_to "承認待ち", admin_shop_edit_requests_path(status: "pending") %> /
<%= link_to "承認済み", admin_shop_edit_requests_path(status: "approved") %> /
<%= link_to "却下", admin_shop_edit_requests_path(status: "rejected") %> /
<%= link_to "すべて", admin_shop_edit_requests_path(status: "all") %>
</p>

<% if flash[:notice].present? %>
<div style="padding:10px; border:1px solid #b6d7a8; background:#e6f4ea; border-radius:10px; margin:10px 0;">
<%= flash[:notice] %>
</div>
<% end %>

<% if flash[:alert].present? %>
<div style="padding:10px; border:1px solid #f5c2c7; background:#f8d7da; border-radius:10px; margin:10px 0;">
<%= flash[:alert] %>
</div>
<% end %>

<% if @edit_requests.present? %>
<div style="display:grid; gap:12px;">
<% @edit_requests.each do |req| %>
<div style="border:1px solid #ddd; border-radius:12px; padding:14px; background:#fff;">
<div style="font-weight:800; font-size:18px; margin-bottom:6px;">
<%= req.shop&.name || "店舗名不明" %>
</div>

<div style="color:#666; font-size:13px; margin-bottom:10px;">
ID: <%= req.id %> /
状態: <%= req.status %> /
作成日: <%= req.created_at.strftime("%Y-%m-%d %H:%M") %>
</div>

<div style="line-height:1.8;">
<div><strong>提案者:</strong> <%= req.proposer_name.presence || "未入力" %></div>
<div><strong>店名:</strong> <%= req.proposed_name.presence || "変更なし" %></div>
<div><strong>住所:</strong> <%= req.proposed_address.presence || "変更なし" %></div>
<div><strong>最寄駅:</strong> <%= req.proposed_nearest_station.presence || "変更なし" %></div>
<div><strong>電話:</strong> <%= req.proposed_phone.presence || "変更なし" %></div>
<div><strong>喫煙エリア:</strong> <%= req.proposed_smoking_area.presence || "未入力" %></div>
<div><strong>喫煙タイプ:</strong> <%= req.proposed_smoking_type.presence || "未入力" %></div>
<div><strong>ジャンル:</strong> <%= req.genre.presence || "変更なし" %></div>
<div><strong>ジャンルその他:</strong> <%= req.genre_other.presence || "変更なし" %></div>
</div>

<div style="margin-top:12px;">
<%= link_to "詳細を見る", admin_shop_edit_request_path(req), style: "padding:8px 12px; border:1px solid #111; border-radius:10px; background:#111; color:#fff; text-decoration:none;" %>
</div>
</div>
<% end %>
</div>
<% else %>
<p>編集依頼はありません。</p>
<% end %>