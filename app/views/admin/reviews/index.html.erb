<h1>口コミ（管理）</h1>

<%# ===== 星表示（0〜5） ===== %>
<% def stars(n)
i = n.to_i
i = 0 if i < 0
i = 5 if i > 5
"★" * i + "☆" * (5 - i)
end %>

<%# ===== フィルタ ===== %>
<div style="margin:10px 0; padding:10px; border:1px solid #ddd; border-radius:12px;">
<div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">

<%# 通報フィルタ %>
<div>
<strong>通報：</strong>
<% if params[:filter] == "reported" %>
<strong>通報のみ</strong>
<span style="color:#999;">｜</span>
<%= link_to "全て", admin_reviews_path(status: params[:status]) %>
<% else %>
<strong>全て</strong>
<span style="color:#999;">｜</span>
<%= link_to "通報のみ", admin_reviews_path(filter: "reported", status: params[:status]) %>
<% end %>
</div>

<span style="color:#ddd;">/</span>

<%# 承認待ちフィルタ %>
<div>
<strong>承認：</strong>
<% if params[:status] == "pending" %>
<strong>承認待ちのみ</strong>
<span style="color:#999;">｜</span>
<%= link_to "全て", admin_reviews_path(filter: params[:filter]) %>
<% else %>
<strong>全て</strong>
<span style="color:#999;">｜</span>
<%= link_to "承認待ちのみ", admin_reviews_path(status: "pending", filter: params[:filter]) %>
<% end %>
</div>

<span style="color:#ddd;">/</span>

<%# クリア %>
<div>
<%= link_to "条件クリア", admin_reviews_path, style: "color:#666;" %>
</div>

</div>
</div>

<p style="color:#666; margin:8px 0;">件数：<%= @reviews.count %> 件</p>

<% if @reviews.any? %>
<% @reviews.each do |r| %>
<% pending_reports = r.review_reports.pending.count rescue 0 %>
<% rating = r.respond_to?(:rating) ? r.rating.to_i : 0 %>

<div style="border:1px solid #ccc; padding:12px; margin:12px 0; border-radius:12px; background:#fff;">
<div style="display:flex; justify-content:space-between; gap:10px; flex-wrap:wrap;">
<div>
<p style="margin:0;">
<strong>店舗：</strong>
<%= link_to r.shop.name, shop_path(r.shop), target: "_blank", rel: "noopener" %>
</p>

<p style="margin:6px 0 0; color:#666; font-size:12px;">
投稿：<%= r.created_at.strftime("%Y-%m-%d %H:%M") %>
／ 承認：<%= r.approved? ? "公開" : "承認待ち" %>
</p>
</div>

<div style="text-align:right;">
<p style="margin:0; color:#b00020; font-weight:bold;">
通報：<%= pending_reports %> 件
</p>
</div>
</div>

<hr style="border:none; border-top:1px solid #eee; margin:10px 0;">

<p style="margin:0;">
<strong>評価：</strong>
<span style="font-weight:900;"><%= stars(rating) %></span>
<span style="color:#666; font-size:12px;">（<%= rating %>/5）</span>
</p>

<% if r.comment.present? %>
<div style="margin-top:6px;">
<%= simple_format(h(r.comment.to_s)) %>
</div>
<% else %>
<p style="margin-top:6px; color:#666;">コメントなし</p>
<% end %>

<div style="display:flex; gap:10px; margin-top:12px; flex-wrap:wrap; align-items:center;">
<%# ✅ プレビュー（詳細）＝ 通報理由・店舗情報をここで確認 %>
<%= link_to "プレビュー（詳細）",
admin_review_path(r, filter: params[:filter], status: params[:status]),
style: "padding:10px 14px; border:1px solid #111; border-radius:10px; text-decoration:none; display:inline-block;" %>

<%= link_to "編集",
edit_admin_review_path(r, filter: params[:filter], status: params[:status]),
style: "padding:10px 14px; border:1px solid #ddd; border-radius:10px; text-decoration:none; display:inline-block;" %>

<% unless r.approved? %>
<%= button_to "承認",
approve_admin_review_path(r, filter: params[:filter], status: params[:status]),
method: :patch,
data: { turbo_confirm: "承認しますか？" } %>

<%= button_to "却下（削除）",
reject_admin_review_path(r, filter: params[:filter], status: params[:status]),
method: :patch,
data: { turbo_confirm: "却下して削除します。よろしいですか？" } %>
<% end %>

<% if pending_reports.to_i > 0 %>
<span style="padding:4px 10px; border-radius:999px; background:#fff5f5; border:1px solid #f5c2c7; color:#b00020; font-size:12px; font-weight:bold;">
通報あり
</span>
<% end %>
</div>
</div>
<% end %>
<% else %>
<p>該当する口コミはありません。</p>
<% end %>