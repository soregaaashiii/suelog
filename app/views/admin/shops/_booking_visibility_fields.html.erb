<fieldset style="margin:12px 0; padding:12px; border:1px solid #ddd; border-radius:10px;">
  <legend>予約ボタンの表示設定</legend>
  <label style="display:block; margin:6px 0;"><%= f.check_box :hide_tabelog_booking_button %> 食べログの予約ボタンを非表示にする</label>
  <label style="display:block; margin:6px 0;"><%= f.check_box :hide_hotpepper_booking_button %> ホットペッパーの予約ボタンを非表示にする</label>
  <p style="margin:6px 0 0; font-size:12px; color:#666;">URLを残したまま、公開ページの予約ボタンを切り替えられます。</p>
</fieldset>
