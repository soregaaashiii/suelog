    <div>
      <div style="font-weight:700;">喫煙エリア</div>
      <%= f.select :smoking_area,
      [
        ["席で喫煙可", "all_smoking"],
        ["喫煙所あり", "separated"],
        ["不明", "unknown"]
      ],
      { include_blank: "選択してください" },
      style: "width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;" %>
    </div>

    <div>
      <div style="font-weight:700;">喫煙タイプ</div>
      <%= f.select :smoking_type,
      [
        ["紙・加熱式どちらもOK", "both_ok"],
        ["加熱式タバコのみOK", "electronic_only"],
        ["紙タバコのみOK", "paper_only"],
        ["不明", "unknown"]
      ],
      { include_blank: "選択してください" },
      style: "width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;" %>
    </div>

<% smoking_details_present = @shop.smoking_area_2.present? || @shop.smoking_type_2.present? || @shop.smoking_condition_schedules.to_h.values.any? { |rule| rule.to_h.values.any?(&:present?) } %>
<details <%= "open" if smoking_details_present %> class="smoking-advanced-settings" style="grid-column:1 / -1; margin:12px 0; padding:12px; border:1px solid #ddd; border-radius:12px;">
  <summary style="cursor:pointer; font-weight:700;">もっと詳細に設定（条件の追加・条件ごとの時間）<%= "［詳細設定あり］" if smoking_details_present %></summary>
  <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:12px; margin-top:12px;">
    <div>
      <div style="font-weight:700;">喫煙エリア2（任意）</div>
      <%= f.select :smoking_area_2,
      [["席で喫煙可", "all_smoking"], ["喫煙所あり", "separated"], ["不明", "unknown"]],
      { include_blank: "条件が1つなら空欄" },
      style: "width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;" %>
    </div>

    <div>
      <div style="font-weight:700;">喫煙タイプ2（任意）</div>
      <%= f.select :smoking_type_2,
      [["紙・加熱式どちらもOK", "both_ok"], ["加熱式タバコのみOK", "electronic_only"], ["紙タバコのみOK", "paper_only"], ["不明", "unknown"]],
      { include_blank: "条件が1つなら空欄" },
      style: "width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;" %>
    </div>

  <%= render "admin/shops/smoking_schedule_fields", f: f %>
  </div>
</details>
