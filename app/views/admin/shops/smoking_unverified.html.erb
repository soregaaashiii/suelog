<% content_for :title, "喫煙情報未確認店舗" %>

<style>
  .smoking-check-page {
    max-width: 980px;
    margin: 0 auto;
    padding: 16px;
  }

  .smoking-check-head {
    margin-bottom: 16px;
  }

  .smoking-check-title {
    margin: 0 0 8px;
    font-size: 24px;
    font-weight: 900;
  }

  .smoking-check-lead {
    margin: 0;
    color: #666;
    font-size: 14px;
    line-height: 1.7;
  }

  .smoking-check-meta {
    margin-top: 10px;
    font-size: 13px;
    color: #666;
  }

  .smoking-check-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .smoking-check-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(120px, auto) minmax(390px, auto);
    gap: 10px;
    align-items: center;
    padding: 12px;
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 10px;
  }

  .smoking-check-form {
    display: grid;
    grid-template-columns: 120px 120px 140px;
    gap: 8px;
    align-items: center;
  }

  .smoking-check-select {
    width: 100%;
    min-height: 44px;
    padding: 0 8px;
    border: 1px solid #ddd;
    border-radius: 8px;
    background: #fff;
    font-size: 13px;
    font-weight: 700;
  }

  .smoking-check-shop {
    min-width: 0;
  }

  .smoking-check-name {
    font-size: 15px;
    font-weight: 900;
    line-height: 1.4;
    word-break: break-word;
  }

  .smoking-check-sub {
    margin-top: 4px;
    color: #777;
    font-size: 12px;
    line-height: 1.5;
  }

  .smoking-check-clicks {
    margin-top: 4px;
    color: #7a5a12;
    font-size: 12px;
    font-weight: 800;
  }

  .smoking-check-phone,
  .smoking-check-confirm {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 900;
    text-decoration: none;
    border: 1px solid #111;
    cursor: pointer;
    white-space: nowrap;
  }

  .smoking-check-phone {
    background: #fff;
    color: #111;
  }

  .smoking-check-phone--disabled {
    border-color: #ddd;
    color: #999;
    background: #f7f7f7;
    cursor: default;
  }

  .smoking-check-confirm {
    background: #111;
    color: #fff;
  }

  .smoking-check-hold-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 8px;
  }

  .smoking-check-hold {
    width: 100%;
    min-height: 40px;
    border-radius: 8px;
    border: 1px solid #ddd;
    background: #fff;
    color: #333;
    font-size: 12px;
    font-weight: 900;
    cursor: pointer;
  }

  .smoking-check-hold--danger {
    border-color: #b00020;
    color: #b00020;
  }

  .smoking-check-checkboxes {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }

  .smoking-check-checkbox {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-size: 13px;
    font-weight: 800;
    white-space: nowrap;
  }

  .smoking-check-empty {
    padding: 24px;
    background: #fff;
    border: 1px dashed #ccc;
    border-radius: 10px;
    color: #666;
    text-align: center;
  }

  .smoking-check-pager {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 18px;
  }

  .smoking-check-pager a,
  .smoking-check-pager span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid #ddd;
    background: #fff;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .smoking-check-page {
      padding: 12px;
    }

    .smoking-check-row {
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 12px;
      border-radius: 12px;
    }

    .smoking-check-sub {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .smoking-check-form {
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .smoking-check-form .smoking-check-confirm {
      grid-column: 1 / -1;
    }

    .smoking-check-name {
      font-size: 13px;
      line-height: 1.35;
    }

    .smoking-check-sub {
      font-size: 11px;
      line-height: 1.4;
    }

    .smoking-check-clicks {
      font-size: 11px;
    }

    .smoking-check-phone,
    .smoking-check-confirm {
      min-height: 46px;
      padding: 0 8px;
      font-size: 12px;
      border-radius: 8px;
    }
  }
</style>

<div class="smoking-check-page">
  <div class="smoking-check-head">
    <h1 class="smoking-check-title">喫煙情報未確認店舗</h1>

    <p class="smoking-check-lead">
      アクセスが多い順。電話確認後、その場で喫煙情報を更新できます。
    </p>

    <div class="smoking-check-meta">
      未確認：<strong><%= @total_count %></strong>件 /
      表示：<strong><%= @shops.to_a.length %></strong>件 /
      <%= @page %> / <%= @total_pages %>ページ
    </div>
  </div>

  <% if @shops.present? %>
    <div class="smoking-check-list">
      <% @shops.each do |shop| %>
        <% click_count = shop.respond_to?(:click_count) ? shop.click_count.to_i : 0 %>

        <div class="smoking-check-row">
          <div class="smoking-check-shop">
            <div class="smoking-check-name">
              <%= link_to shop.name, admin_shop_path(shop), target: "_blank", rel: "noopener" %>
            </div>

            <div class="smoking-check-sub">
              <%= [shop.area, shop.nearest_station].compact_blank.join(" / ") %>
            </div>

            <div class="smoking-check-clicks">
              アクセス：<%= click_count %>
            </div>
          </div>

          <div>
            <% if shop.phone.present? %>
              <%= link_to "電話する", "tel:#{shop.phone.to_s.gsub(/[^\d+]/, '')}", class: "smoking-check-phone" %>
            <% else %>
              <span class="smoking-check-phone smoking-check-phone--disabled">電話なし</span>
            <% end %>
          </div>

          <div>
            <%= form_with model: [:admin, shop],
                          url: update_smoking_info_admin_shop_path(shop, per: @per, page: @page),
                          method: :patch,
                          local: true,
                          class: "smoking-check-form" do |f| %>
              <%= f.select :smoking_area,
                           [
                             ["席で喫煙可", "all_smoking"],
                             ["喫煙所あり", "separated"],
                             ["不明", "unknown"]
                           ],
                           {},
                           class: "smoking-check-select" %>

              <%= f.select :smoking_type,
                           [
                             ["紙・加熱式OK", "both_ok"],
                             ["加熱式のみ", "electronic_only"],
                             ["紙タバコのみ", "paper_only"],
                             ["不明", "unknown"]
                           ],
                           {},
                           class: "smoking-check-select" %>

              <div class="smoking-check-checkboxes">
                <label class="smoking-check-checkbox">
                  <%= check_box_tag :confirmed_partitioned, "1", false %>
                  分煙確認
                </label>

                <label class="smoking-check-checkbox">
                  <%= check_box_tag :confirmed_all_smoking, "1", false %>
                  全席確認
                </label>
              </div>

              <%= f.submit "保存して確認済み", class: "smoking-check-confirm" %>
            <% end %>

            <div class="smoking-check-hold-actions">
              <%= button_to "喫煙不可で保留",
                            move_to_hold_from_smoking_check_admin_shop_path(shop, per: @per, page: @page, reason: "喫煙不可"),
                            method: :patch,
                            class: "smoking-check-hold",
                            form: { data: { turbo_confirm: "喫煙不可として保留に移動しますか？" } } %>

              <%= button_to "閉店で保留",
                            move_to_hold_from_smoking_check_admin_shop_path(shop, per: @per, page: @page, reason: "閉店"),
                            method: :patch,
                            class: "smoking-check-hold smoking-check-hold--danger",
                            form: { data: { turbo_confirm: "閉店として保留に移動しますか？" } } %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="smoking-check-pager">
      <% if @page > 1 %>
        <%= link_to "前へ", smoking_unverified_admin_shops_path(page: @page - 1, per: @per) %>
      <% else %>
        <span>前へ</span>
      <% end %>

      <% if @page < @total_pages %>
        <%= link_to "次へ", smoking_unverified_admin_shops_path(page: @page + 1, per: @per) %>
      <% else %>
        <span>次へ</span>
      <% end %>
    </div>
  <% else %>
    <div class="smoking-check-empty">
      喫煙情報未確認の店舗はありません。
    </div>
  <% end %>
</div>