<%# /Users/kawamuratakuya/dev/suelog/app/views/admin/shops/edit.html.erb %>

<h1>店舗編集（管理者用）</h1>

<p style="color:#666;">
  <%= link_to "← 一覧に戻る", admin_shops_path(status: @status, source: @source, per: @per, page: @page) %>
</p>

<% if flash[:alert].present? %>
  <div style="padding:10px; border:1px solid #f5c2c7; background:#f8d7da; border-radius:10px; margin:10px 0;">
    <%= flash[:alert] %>
  </div>
<% end %>

<% if flash[:notice].present? %>
  <div style="padding:10px; border:1px solid #b6d7a8; background:#e6f4ea; border-radius:10px; margin:10px 0;">
    <%= flash[:notice] %>
  </div>
<% end %>

<% rejected = (@shop.respond_to?(:rejected?) && @shop.rejected?) %>

<%= form_with model: [:admin, @shop], method: :patch, local: true, html: { multipart: true } do |f| %>
  <%= hidden_field_tag :status, @status %>
  <%= hidden_field_tag :source, @source %>
  <%= hidden_field_tag :per, @per %>
  <%= hidden_field_tag :page, @page %>
  <%= hidden_field_tag :from, params[:from] %>
  <%= hidden_field_tag :q, params[:q] %>
  <%= hidden_field_tag :sort, params[:sort] %>

  <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; max-width:900px;">

    <div>
      <div style="font-weight:700;">店名</div>
      <%= f.text_field :name, style: "width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;" %>
    </div>

    <div>
      <div style="font-weight:700;">電話</div>
      <%= f.text_field :phone, style: "width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;" %>
    </div>

    <div style="grid-column:1/-1;">
      <div style="font-weight:700;">住所</div>
      <%= f.text_field :address, style: "width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;" %>
    </div>

    <div>
      <div style="font-weight:700;">最寄駅</div>
      <%= f.text_field :nearest_station, style: "width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;" %>
    </div>

    <div>
      <div style="font-weight:700;">エリア</div>
      <p style="margin:4px 0 8px; color:#666; font-size:12px; line-height:1.6;">
        未設定のままでも保存できます。空欄なら住所・最寄駅から自動判定されます。
      </p>
      <%= f.select :area,
      [
        ["未設定", ""],
        ["梅田", "梅田"],
        ["難波", "難波"]
      ],
      {},
      style: "width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;" %>
    </div>

    <div>
      <div style="font-weight:700;">ジャンル</div>
      <%= f.select :genre,
      [
        ["未設定", ""],
        ["居酒屋", "居酒屋"],
        ["焼肉", "焼肉"],
        ["焼鳥", "焼鳥"],
        ["ラーメン", "ラーメン"],
        ["中華", "中華"],
        ["韓国料理", "韓国料理"],
        ["イタリアン", "イタリアン"],
        ["フレンチ", "フレンチ"],
        ["和食", "和食"],
        ["寿司", "寿司"],
        ["バー", "バー"],
        ["カフェ", "カフェ"],
        ["喫茶店", "喫茶店"],
        ["スナック", "スナック"],
        ["ダイニングバー", "ダイニングバー"],
        ["その他", "その他"]
      ],
      {},
      style: "width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;" %>
    </div>

    <div>
      <div style="font-weight:700;">ジャンルその他</div>
      <%= f.text_field :genre_other, style: "width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;" %>
    </div>

    <div>
      <div style="font-weight:700;">最終確認日</div>
      <%= f.date_field :last_confirmed_on,
      style: "width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;" %>
    </div>

    <div>
      <div style="font-weight:700;">食べログURL</div>
      <%= f.url_field :tabelog_url,
      placeholder: "https://tabelog.com/...",
      style: "width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;" %>
    </div>

    <div>
      <div style="font-weight:700;">食べログアフィリエイトURL</div>
      <%= f.url_field :tabelog_affiliate_url,
      placeholder: "https://ck.jp.ap.valuecommerce.com/...",
      style: "width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;" %>
    </div>

    <div>
      <div style="font-weight:700;">独自送客ボタン名</div>
      <%= f.text_field :custom_affiliate_label,
      placeholder: "例：公式サイトで予約する",
      style: "width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;" %>
    </div>

    <div>
      <div style="font-weight:700;">独自送客URL</div>
      <%= f.url_field :custom_affiliate_url,
      placeholder: "https://example.com/...",
      style: "width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;" %>
    </div>

    <div>
      <div style="font-weight:700;">ホットペッパーURL</div>
      <%= f.url_field :hotpepper_url,
      placeholder: "https://www.hotpepper.jp/...",
      style: "width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;" %>
    </div>

    <div style="grid-column:1/-1; margin-top:6px; padding:14px; border:1px solid #eee; border-radius:12px; background:#fffdf8;" data-controller="hours-builder">
  <div style="font-weight:800; font-size:16px; margin-bottom:8px;">営業時間</div>

  <p style="margin:0 0 12px; color:#666; font-size:13px; line-height:1.7;">
    営業日にチェックを入れて、営業時間を選択してください。チェックなしの曜日は定休日として表示されます。<br>
    喫煙時間は未指定なら「営業時間中は喫煙可」として扱います。
  </p>

  <% days = [
    ["mon", "月"], ["tue", "火"], ["wed", "水"], ["thu", "木"], ["fri", "金"],
    ["sat", "土"], ["sun", "日"], ["holiday", "祝日"], ["before_holiday", "祝前"]
  ] %>

  <% time_options = [["未設定", ""]] + (0..96).map { |i| t = "%02d:%02d" % [i / 4, (i % 4) * 15]; [t, t] } %>

  <div style="display:grid; gap:10px;">
    <% days.each do |key, label| %>
      <div data-hours-row="<%= key %>" style="padding:10px; border:1px solid #eadfca; border-radius:12px; background:#fff;">
        <label style="display:flex; align-items:center; gap:8px; font-weight:800; margin-bottom:8px;">
          <input type="checkbox" data-hours-open>
          <span style="width:42px;"><%= label %></span>
          <span style="font-size:12px; color:#777;">営業日</span>
          <button type="button" data-copy-hours-to-all style="margin-left:auto; padding:6px 10px; border:1px solid #ddd; background:#fff; border-radius:999px; cursor:pointer; font-size:12px;">
            他の日に反映
          </button>
        </label>

        <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center; margin-bottom:8px;">
          <span style="font-size:12px; font-weight:700; color:#555;">営業時間1</span>
          <%= select_tag nil, options_for_select(time_options), data: { hours_start1: true }, style: "padding:8px; border:1px solid #ddd; border-radius:10px;" %>
          <span>〜</span>
          <%= select_tag nil, options_for_select(time_options), data: { hours_end1: true }, style: "padding:8px; border:1px solid #ddd; border-radius:10px;" %>

          <span style="font-size:12px; font-weight:700; color:#555;">営業時間2</span>
          <%= select_tag nil, options_for_select(time_options), data: { hours_start2: true }, style: "padding:8px; border:1px solid #ddd; border-radius:10px;" %>
          <span>〜</span>
          <%= select_tag nil, options_for_select(time_options), data: { hours_end2: true }, style: "padding:8px; border:1px solid #ddd; border-radius:10px;" %>
        </div>

        <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
          <label style="display:flex; align-items:center; gap:6px; font-size:12px; font-weight:700;">
            <input type="checkbox" data-smoking-same checked>
            喫煙時間は営業時間と同じ
          </label>

          <span style="font-size:12px; font-weight:700; color:#555;">喫煙可</span>
          <%= select_tag nil, options_for_select(time_options), data: { smoking_start: true }, style: "padding:8px; border:1px solid #ddd; border-radius:10px;" %>
          <span>〜</span>
          <%= select_tag nil, options_for_select(time_options), data: { smoking_end: true }, style: "padding:8px; border:1px solid #ddd; border-radius:10px;" %>
        </div>
      </div>
    <% end %>
  </div>

  <div style="margin-top:12px;">
    <div style="font-weight:700; margin-bottom:4px;">自動生成される営業時間テキスト</div>
    <%= f.text_area :opening_hours_text,
      rows: 4,
      id: "shop_opening_hours_text",
      style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
  </div>

  <div style="margin-top:10px;">
    <div style="font-weight:700; margin-bottom:4px;">自動生成される祝日営業時間</div>
    <%= f.text_area :holiday_hours_text,
      rows: 2,
      id: "shop_holiday_hours_text",
      style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
  </div>

  <div style="margin-top:10px;">
    <div style="font-weight:700; margin-bottom:4px;">自動生成される定休日</div>
    <%= f.text_field :closed_days_text,
      id: "shop_closed_days_text",
      style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
  </div>

  <div style="margin-top:14px;">
    <div style="font-weight:700;">営業時間の補足（ユーザーに表示）</div>
    <p style="margin:4px 0 8px; color:#666; font-size:13px; line-height:1.7;">
      年末年始・ゴールデンウィーク・お盆など、通常と違う営業時間がある場合に入力してください。
    </p>
    <%= f.text_area :special_hours_note,
      rows: 3,
      placeholder: "例：年末年始は営業時間が変更になる場合があります。詳しくは店舗へご確認ください。",
      style: "width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;" %>
  </div>
</div>



    <div>
      <div style="font-weight:700;">喫煙エリア</div>
      <%= f.select :smoking_area,
      [
        ["席で喫煙可", "all_smoking"],
        ["喫煙所あり", "separated"],
        ["不明", "unknown"]
      ],
      { include_blank: "選択してください" },
      style: "width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;" %>
    </div>

    <div>
      <div style="font-weight:700;">喫煙タイプ</div>
      <%= f.select :smoking_type,
      [
        ["紙・加熱式どちらもOK", "both_ok"],
        ["加熱式タバコのみOK", "electronic_only"],
        ["紙タバコのみOK", "paper_only"],
        ["不明", "unknown"]
      ],
      { include_blank: "選択してください" },
      style: "width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;" %>
    </div>

    <div style="grid-column:1/-1; padding:14px; border:1px solid #eee; border-radius:12px; background:#f9fafb;">
      <div style="font-weight:800; font-size:16px; margin-bottom:8px;">喫煙情報ステータス</div>

      <label style="display:flex; align-items:center; gap:8px; font-weight:700; cursor:pointer;">
        <%= f.check_box :smoking_unverified %>
        <span>喫煙情報未確認として扱う</span>
      </label>

      <p style="margin:8px 0 0; color:#666; font-size:13px; line-height:1.7;">
        オンにすると、表側で「未確認」バッジを表示する前提のデータとして扱えます。<br>
        電話確認や現地確認が終わったらオフに戻してください。
      </p>
    </div>

    <div style="grid-column:1/-1;">
      <div style="font-weight:700;">店舗詳細（ユーザーに表示）</div>
      <p style="margin:4px 0 8px; color:#666; font-size:13px; line-height:1.7;">
        来店前にユーザーが知りたい情報を書いてください。<br>
        例）カウンター席あり / テラス席あり / 深夜まで営業 / 1人でも入りやすい など
      </p>
      <%= f.text_area :public_store_details,
      rows: 6,
      placeholder: "例）カウンター席あり。仕事帰りに1人でも入りやすい雰囲気です。",
      style: "width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;" %>
    </div>

    <div style="grid-column:1/-1;">
      <div style="font-weight:700;">管理メモ（管理者のみ表示）</div>
      <p style="margin:4px 0 8px; color:#666; font-size:13px; line-height:1.7;">
        内部確認用のメモです。一般ユーザーには表示しません。
      </p>
      <%= f.text_area :note,
      rows: 6,
      style: "width:100%; padding:8px; border:1px solid #ddd; border-radius:10px;" %>
    </div>

    <div style="grid-column:1/-1; margin-top:6px; padding:14px; border:1px solid #eee; border-radius:12px; background:#fff;">
      <div style="font-weight:800; font-size:16px; margin-bottom:8px;">写真管理</div>
      <p style="margin:0 0 12px; color:#666; font-size:13px; line-height:1.7;">
        写真を追加できます。削除したい写真は「削除」にチェックを入れてから更新してください。
      </p>

      <% {
        food_photos: "料理写真",
        interior_photos: "内観写真",
        exterior_photos: "外観写真",
        menu_photos: "メニュー写真"
      }.each do |field, label| %>
        <div style="margin:0 0 18px; padding:12px; border:1px solid #f1f1f1; border-radius:12px; background:#fafafa;">
          <div style="font-weight:800; margin-bottom:8px;"><%= label %></div>

          <% photos = @shop.public_send(field) %>

          <% if photos.attached? %>
            <div style="display:flex; gap:12px; flex-wrap:wrap; margin-bottom:10px;">
              <% photos.each do |photo| %>
                <div style="width:120px; padding:8px; border:1px solid #e5e7eb; border-radius:10px; background:#fff;">
                  <% begin %>
                    <%= image_tag photo,
                      style: "width:100%; height:86px; object-fit:cover; border-radius:8px; display:block; margin-bottom:6px;" %>
                  <% rescue => e %>
                    <% Rails.logger.warn("[admin shops edit] photo preview failed attachment_id=#{photo.id}: #{e.class}: #{e.message}") %>
                    <div style="width:100%; height:86px; display:flex; align-items:center; justify-content:center; background:#f3f4f6; color:#999; border-radius:8px; font-size:12px; margin-bottom:6px;">
                      画像なし
                    </div>
                  <% end %>

                  <label style="display:flex; align-items:center; gap:6px; font-size:12px; color:#b00020; font-weight:700;">
                    <%= check_box_tag "remove_#{field}_ids[]", photo.id, false %>
                    削除
                  </label>
                </div>
              <% end %>
            </div>
          <% else %>
            <p style="margin:0 0 8px; color:#777; font-size:13px;">現在の写真はありません。</p>
          <% end %>

          <%= file_field_tag "shop[#{field}][]",
            multiple: true,
            accept: "image/*",
            style: "display:block; width:100%;" %>
        </div>
      <% end %>

      <div style="margin-top:14px; padding:12px; border:1px solid #f1f1f1; border-radius:12px; background:#fffdf8;">
        <div style="font-weight:800; margin-bottom:8px;">サムネ設定（一覧に出す写真）</div>
        <p style="margin:0 0 10px; color:#666; font-size:13px; line-height:1.7;">
          一覧カードに出す写真を指定できます。自動の場合は既存ロジックで選ばれます。
        </p>

        <div style="display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end;">
          <div>
            <div style="font-weight:700; margin-bottom:4px;">種類</div>
            <%= f.select :thumbnail_kind,
              [["自動", "auto"], ["料理", "food"], ["外観", "exterior"], ["内観", "interior"], ["メニュー", "menu"]],
              {},
              style: "padding:10px; border:1px solid #ddd; border-radius:12px;" %>
          </div>

          <div>
            <div style="font-weight:700; margin-bottom:4px;">何枚目（1〜）</div>
            <%= f.number_field :thumbnail_index,
              in: 1..20,
              step: 1,
              style: "width:140px; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div style="margin-top:14px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
    <%= f.submit "更新する",
    name: "commit_action",
    value: "update",
    style: "padding:10px 14px; border:1px solid #111; border-radius:10px; background:#111; color:#fff;" %>

    <% if !@shop.approved? && !rejected %>
      <%= f.submit "更新して承認する",
      name: "commit_action",
      value: "approve",
      data: { turbo_confirm: "更新して承認しますか？" },
      style: "padding:10px 14px; border:1px solid #137333; border-radius:10px; background:#e6f4ea; color:#137333; font-weight:700;" %>

      <%= f.submit "更新して保留に移動",
      name: "commit_action",
      value: "hold",
      data: { turbo_confirm: "更新して保留に移動しますか？" },
      style: "padding:10px 14px; border:1px solid #9a6700; border-radius:10px; background:#fff8e1; color:#9a6700; font-weight:700;" %>

      <%= f.submit "更新して却下する",
      name: "commit_action",
      value: "reject",
      data: { turbo_confirm: "更新して却下します。よろしいですか？" },
      style: "padding:10px 14px; border:1px solid #b00020; border-radius:10px; background:#fdecea; color:#b00020; font-weight:700;" %>
    <% end %>

    <%= link_to "キャンセル",
    admin_shops_path(status: @status, source: @source, per: @per, page: @page),
    style: "padding:10px 14px; border:1px solid #ddd; border-radius:10px; text-decoration:none;" %>
  </div>
<% end %>

