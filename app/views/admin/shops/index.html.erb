<%# /Users/kawamuratakuya/dev/suelog/app/views/admin/shops/index.html.erb %>

<h1>店舗管理</h1>

<div style="margin:10px 0; display:flex; gap:10px; flex-wrap:wrap;">
  <%= link_to "＋ 新規店舗を登録",
      new_admin_shop_path,
      style: "display:inline-block; padding:10px 14px; border-radius:10px; background:#111; color:#fff; text-decoration:none; font-weight:700;" %>

  <%= link_to "怪しい食べログ候補",
      admin_shops_path(status: "tabelog_suspect", source: @source, per: @per, page: 1),
      style: "display:inline-block; padding:10px 14px; border-radius:10px; background:#fff3cd; color:#7a4b00; border:1px solid #e0b84f; text-decoration:none; font-weight:700;" %>
</div>

<%# =========================
CSV一括インポート
========================= %>
<div style="margin:10px 0; padding:12px; border:1px solid #ddd; border-radius:12px; background:#fafafa;">
  <div style="font-weight:900; margin-bottom:8px;">CSV一括インポート</div>

  <%= form_with url: import_admin_shops_path,
      multipart: true,
      local: true,
      style: "display:flex; gap:10px; align-items:center; flex-wrap:wrap;" do %>

    <%= file_field_tag :file, accept: ".csv", required: true %>

    <%= submit_tag "インポートする",
        style: "padding:8px 12px; border:1px solid #111; border-radius:10px; background:#111; color:#fff;" %>
  <% end %>

  <div style="color:#666; font-size:12px; margin-top:8px; line-height:1.6;">
    ・phone を数字化して normalized_phone で既存判定 → あれば更新 / なければ新規<br>
    ・喫煙エリア or 喫煙タイプが空なら自動で承認待ち（noteに「未確認」を追記）<br>
  </div>
</div>

<div style="margin:10px 0; padding:10px; border:1px solid #ddd; border-radius:12px;">
  <div style="display:flex; gap:14px; flex-wrap:wrap; align-items:center; justify-content:space-between;">
    <div>
      <strong>表示：</strong>
      <% if @status == "all" %>
        <strong>すべて</strong>｜
        <%= link_to "承認待ち", admin_shops_path(status: "pending", source: @source, per: @per, page: 1) %>｜
        <%= link_to "却下", admin_shops_path(status: "rejected", source: @source, per: @per, page: 1) %>｜
        <%= link_to "未確認のみ", admin_shops_path(status: "unverified", source: @source, per: @per, page: 1) %>｜
        <%= link_to "怪しい食べログ候補", admin_shops_path(status: "tabelog_suspect", source: @source, per: @per, page: 1) %>｜
        <%= link_to "保留一覧", holds_admin_shops_path %>
      <% elsif @status == "rejected" %>
        <%= link_to "すべて", admin_shops_path(status: "all", source: @source, per: @per, page: 1) %>｜
        <%= link_to "承認待ち", admin_shops_path(status: "pending", source: @source, per: @per, page: 1) %>｜
        <strong>却下</strong>｜
        <%= link_to "未確認のみ", admin_shops_path(status: "unverified", source: @source, per: @per, page: 1) %>｜
        <%= link_to "怪しい食べログ候補", admin_shops_path(status: "tabelog_suspect", source: @source, per: @per, page: 1) %>｜
        <%= link_to "保留一覧", holds_admin_shops_path %>
      <% elsif @status == "unverified" %>
        <%= link_to "すべて", admin_shops_path(status: "all", source: @source, per: @per, page: 1) %>｜
        <%= link_to "承認待ち", admin_shops_path(status: "pending", source: @source, per: @per, page: 1) %>｜
        <%= link_to "却下", admin_shops_path(status: "rejected", source: @source, per: @per, page: 1) %>｜
        <strong>未確認のみ</strong>｜
        <%= link_to "保留一覧", holds_admin_shops_path %>
      <% elsif @status == "tabelog_suspect" %>
        <%= link_to "すべて", admin_shops_path(status: "all", source: @source, per: @per, page: 1) %>｜
        <%= link_to "承認待ち", admin_shops_path(status: "pending", source: @source, per: @per, page: 1) %>｜
        <%= link_to "却下", admin_shops_path(status: "rejected", source: @source, per: @per, page: 1) %>｜
        <%= link_to "未確認のみ", admin_shops_path(status: "unverified", source: @source, per: @per, page: 1) %>｜
        <strong>怪しい食べログ候補</strong>｜
        <%= link_to "保留一覧", holds_admin_shops_path %>
      <% elsif @status == "hold" %>
        <%= link_to "すべて", admin_shops_path(status: "all", source: @source, per: @per, page: 1) %>｜
        <%= link_to "承認待ち", admin_shops_path(status: "pending", source: @source, per: @per, page: 1) %>｜
        <%= link_to "却下", admin_shops_path(status: "rejected", source: @source, per: @per, page: 1) %>｜
        <%= link_to "未確認のみ", admin_shops_path(status: "unverified", source: @source, per: @per, page: 1) %>｜
        <strong>保留一覧</strong>
      <% else %>
        <%= link_to "すべて", admin_shops_path(status: "all", source: @source, per: @per, page: 1) %>｜
        <strong>承認待ち</strong>｜
        <%= link_to "却下", admin_shops_path(status: "rejected", source: @source, per: @per, page: 1) %>｜
        <%= link_to "未確認のみ", admin_shops_path(status: "unverified", source: @source, per: @per, page: 1) %>｜
        <%= link_to "怪しい食べログ候補", admin_shops_path(status: "tabelog_suspect", source: @source, per: @per, page: 1) %>｜
        <%= link_to "保留一覧", holds_admin_shops_path %>
      <% end %>
    </div>

    <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
      <div style="display:flex; gap:8px; align-items:center;">
        <strong>表示件数：</strong>
        <form action="<%= admin_shops_path %>" method="get" style="display:flex; gap:8px; align-items:center;">
          <input type="hidden" name="status" value="<%= @status %>">
          <input type="hidden" name="source" value="<%= @source %>">
          <input type="hidden" name="page" value="1">
          <select name="per" style="padding:6px 8px; border:1px solid #ddd; border-radius:10px;">
            <% [50, 100, 200, 500].each do |n| %>
              <option value="<%= n %>" <%= "selected" if @per.to_i == n %>><%= n %></option>
            <% end %>
          </select>
          <button type="submit" style="padding:6px 10px; border:1px solid #ddd; border-radius:10px; background:#fff;">
            反映
          </button>
        </form>
      </div>

      <% if Shop.column_names.include?("source") %>
        <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
          <strong>source：</strong>
          <form action="<%= admin_shops_path %>" method="get" style="display:flex; gap:8px; align-items:center;">
            <input type="hidden" name="status" value="<%= @status %>">
            <input type="hidden" name="per" value="<%= @per %>">
            <input type="hidden" name="page" value="1">
            <select name="source" style="padding:6px 8px; border:1px solid #ddd; border-radius:10px;">
              <option value="" <%= "selected" if @source.blank? %>>すべて</option>
              <option value="google" <%= "selected" if @source == "google" %>>google</option>
            </select>
            <button type="submit" style="padding:6px 10px; border:1px solid #ddd; border-radius:10px; background:#fff;">
              絞り込む
            </button>
          </form>
        </div>
      <% end %>
    </div>
  </div>
</div>

<p style="color:#666; margin:8px 0;">
  件数：<%= (@total_count || @shops.count) %> 件 ／ ページ：<%= (@page || 1) %> / <%= (@total_pages || 1) %>
</p>

<% if (@total_pages || 1) > 1 %>
  <div style="margin:10px 0; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
    <% if (@page || 1) > 1 %>
      <%= link_to "← 前へ",
          admin_shops_path(status: @status, source: @source, per: @per, page: (@page - 1)),
          style: "padding:8px 10px; border:1px solid #ddd; border-radius:10px; text-decoration:none; display:inline-block;" %>
    <% end %>

    <% if (@page || 1) < (@total_pages || 1) %>
      <%= link_to "次へ →",
          admin_shops_path(status: @status, source: @source, per: @per, page: (@page + 1)),
          style: "padding:8px 10px; border:1px solid #ddd; border-radius:10px; text-decoration:none; display:inline-block;" %>
    <% end %>
  </div>
<% end %>

<% if @shops.any? %>
  <%= form_with url: bulk_update_admin_shops_path, method: :patch, local: true, id: "bulk_form" do %>
    <input type="hidden" name="status" value="<%= @status %>">
    <input type="hidden" name="source" value="<%= @source %>">
    <input type="hidden" name="per" value="<%= @per %>">
    <input type="hidden" name="page" value="<%= @page %>">

    <input type="hidden" name="shop_ids_csv" id="shop_ids_csv" value="">

    <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin:10px 0; padding:10px; border:1px solid #eee; border-radius:12px; background:#fafafa;">
      <label style="display:flex; align-items:center; gap:8px;">
        <input type="checkbox" id="select_all">
        <strong>全選択（このページ）</strong>
      </label>

      <span id="selected_count" style="color:#666;">選択：0件</span>

      <button type="submit"
              name="operation"
              value="approve"
              data-turbo="false"
              data-turbo-confirm="選択した店舗を一括承認しますか？"
              style="padding:8px 10px; border:1px solid #ddd; border-radius:10px; background:#fff;">
        一括承認
      </button>

      <button type="submit"
              name="operation"
              value="reject"
              data-turbo="false"
              data-turbo-confirm="選択した店舗を一括却下しますか？"
              style="padding:8px 10px; border:1px solid #ddd; border-radius:10px; background:#fff;">
        一括却下
      </button>

      <button type="submit"
              name="operation"
              value="unverify"
              data-turbo="false"
              data-turbo-confirm="選択した店舗の未確認を解除しますか？"
              style="padding:8px 10px; border:1px solid #ddd; border-radius:10px; background:#fff;">
        未確認を解除
      </button>

      <span style="color:#999; font-size:12px;">
        ※ 一括操作は「このページでチェックされた店舗のみ」
      </span>
    </div>
  <% end %>

  <div class="admin-table-wrap" style="overflow-x:auto; -webkit-overflow-scrolling:touch; padding-bottom:4px;">
    <table style="width:100%; border-collapse:collapse; min-width:1500px; table-layout:auto;">
      <thead>
        <tr style="border-bottom:2px solid #111;">
          <th align="left" style="width:42px;">選択</th>
          <th align="left">店名</th>
          <th align="left">住所</th>
          <th align="left">状態</th>
          <th align="right">合計</th>
          <th align="right">電話</th>
          <th align="right">地図</th>
          <th align="right">アフィリ</th>
          <th align="left" style="padding:8px 0 8px 0; white-space:nowrap; min-width:420px;">操作</th>
        </tr>
      </thead>

      <tbody>
        <% @shops.each do |shop| %>
          <% rejected = (shop.respond_to?(:rejected?) && shop.rejected?) %>

          <% duplicate_state =
              if @status == "pending"
                (@duplicate_states || {})[shop.id] || :none
              else
                :none
              end %>

          <% detail_label, detail_style =
              case duplicate_state
              when :approved_or_rejected
                [
                  "詳細（重複候補あり）",
                  "display:inline-flex; align-items:center; white-space:nowrap; padding:6px 10px; border:1px solid #b00020; background:#fff1f1; color:#b00020; font-weight:700; border-radius:10px; text-decoration:none;"
                ]
              when :pending_only
                [
                  "詳細（承認待ち重複）",
                  "display:inline-flex; align-items:center; white-space:nowrap; padding:6px 10px; border:1px solid #9aa0a6; background:#f5f5f5; color:#555; font-weight:700; border-radius:10px; text-decoration:none;"
                ]
              else
                [
                  "詳細",
                  "display:inline-flex; align-items:center; white-space:nowrap; padding:6px 10px; border:1px solid #137333; background:#eef8f0; color:#137333; font-weight:700; border-radius:10px; text-decoration:none;"
                ]
              end %>

          <% click_counts = (@shop_click_counts || {})[shop.id] || {} %>

          <tr style="border-bottom:1px solid #ddd; vertical-align:top;">
            <td style="padding:10px 0;">
              <input type="checkbox" class="shop_checkbox" value="<%= shop.id %>">
            </td>

            <td style="padding:8px 0;">
              <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                <strong><%= shop.name %></strong>

                <%= link_to "Google検索",
                    "https://www.google.com/search?q=#{ERB::Util.url_encode([shop.name, shop.address].compact.join(' '))}",
                    target: "_blank",
                    rel: "noopener",
                    style: "display:inline-block; padding:4px 8px; border:1px solid #ddd; border-radius:8px; text-decoration:none; font-size:12px; background:#fff;" %>
              </div>

              <% if shop.respond_to?(:smoking_unverified?) && shop.smoking_unverified? %>
                <div style="margin-top:6px;">
                  <span style="display:inline-flex; align-items:center; padding:3px 8px; border-radius:999px; font-size:11px; font-weight:800; background:#fff6db; color:#8a6500; border:1px solid #f0de9c;">
                    未確認
                  </span>
                </div>
              <% end %>

              <% if shop.respond_to?(:on_hold?) && shop.on_hold? %>
                <div style="margin-top:6px;">
                  <span style="display:inline-flex; align-items:center; padding:3px 8px; border-radius:999px; font-size:11px; font-weight:800; background:#ffe9e9; color:#b00020; border:1px solid #f3b2b2;">
                    保留：<%= shop.hold_reason_label %>
                  </span>
                </div>
              <% end %>

              <% if Shop.column_names.include?("source") && shop.respond_to?(:source) && shop.source.present? %>
                <div style="color:#666; font-size:12px; margin-top:4px;">source：<%= shop.source %></div>
              <% end %>
            </td>

            <td style="padding:8px 0;">
              <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                <span><%= shop.address.presence || "未設定" %></span>

                <% if shop.address.present? %>
                  <button type="button"
                          class="copy-address-button"
                          data-address="<%= shop.address %>"
                          style="padding:4px 8px; border:1px solid #ddd; border-radius:8px; background:#fff; font-size:12px; cursor:pointer;">
                    住所コピー
                  </button>
                <% end %>
              </div>
            </td>

            <td style="padding:8px 0;">
              <% if shop.respond_to?(:on_hold?) && shop.on_hold? %>
                <span style="color:#b00020; font-weight:bold;">保留中</span>
              <% elsif shop.approved? %>
                <span style="color:#137333; font-weight:bold;">承認済み</span>
              <% elsif rejected %>
                <span style="color:#b00020; font-weight:bold;">却下</span>
              <% else %>
                <span style="color:#b00020; font-weight:bold;">承認待ち</span>
              <% end %>

              <% if shop.respond_to?(:smoking_unverified?) && shop.smoking_unverified? %>
                <div style="margin-top:4px; color:#8a6500; font-size:12px; font-weight:700;">
                  喫煙情報未確認
                </div>
              <% end %>
            </td>

            <td align="right" style="padding:8px 12px 8px 0; font-weight:700;">
              <%= click_counts[:total].to_i %>
            </td>

            <td align="right" style="padding:8px 12px 8px 0;">
              <%= click_counts[:phone_click].to_i %>
            </td>

            <td align="right" style="padding:8px 12px 8px 0;">
              <%= click_counts[:map_click].to_i %>
            </td>

            <td align="right" style="padding:8px 12px 8px 0;">
              <%= click_counts[:affiliate_click].to_i %>
            </td>

            <td style="padding:10px 0; min-width:420px;">
              <div class="admin-shop-actions" style="display:flex; gap:8px; flex-wrap:wrap; align-items:flex-start; min-width:400px;">
                <% if !shop.approved? && !shop.rejected? %>
                  <%= button_to "承認",
                      approve_admin_shop_path(shop, status: @status, source: @source, per: @per, page: @page),
                      method: :patch,
                      data: { turbo: false, turbo_confirm: "承認しますか？" } %>

                  <%= button_to "却下",
                      reject_admin_shop_path(shop, status: @status, source: @source, per: @per, page: @page),
                      method: :patch,
                      data: { turbo: false, turbo_confirm: "却下します。よろしいですか？" } %>

                  <% if @status == "pending" && duplicate_state == :approved_or_rejected %>
                    <%= button_to "重複として却下",
                        reject_admin_shop_path(shop, status: @status, source: @source, per: @per, page: @page),
                        method: :patch,
                        data: { turbo: false, turbo_confirm: "重複として却下しますか？" },
                        style: "background:#fff1f1; border:1px solid #b00020; color:#b00020;" %>
                  <% end %>
                <% end %>

                <%= link_to detail_label,
                    admin_shop_path(shop, status: @status, source: @source, per: @per, page: @page),
                    style: detail_style %>

                <%= link_to "編集",
                    edit_admin_shop_path(shop, status: @status, source: @source, per: @per, page: @page),
                    style: "display:inline-flex; align-items:center; white-space:nowrap; padding:6px 10px; border:1px solid #ddd; border-radius:10px; text-decoration:none;" %>

                <% candidate_url = shop.respond_to?(:tabelog_candidate_url) ? shop.tabelog_candidate_url : nil %>

                <% if candidate_url.present? %>
                  <%= link_to "食べログ候補",
                      candidate_url,
                      target: "_blank",
                      rel: "noopener nofollow",
                      style: "display:inline-flex; align-items:center; white-space:nowrap; padding:6px 10px; border:1px solid #e0b84f; background:#fff8e1; color:#7a4b00; border-radius:10px; text-decoration:none; font-weight:700;" %>

                  <%= button_to "候補を承認",
                      approve_tabelog_candidate_admin_shop_path(shop, status: @status, source: @source, per: @per, page: @page),
                      method: :patch,
                      data: { turbo: false, turbo_confirm: "この食べログ候補を公開URLとして承認しますか？" },
                      style: "padding:6px 10px; border:1px solid #137333; background:#eef8f0; color:#137333; border-radius:10px; font-weight:700;" %>
                <% elsif shop.tabelog_url.present? %>
                  <%= link_to "食べログ",
                      shop.tabelog_url,
                      target: "_blank",
                      rel: "noopener nofollow",
                      style: "display:inline-flex; align-items:center; white-space:nowrap; padding:6px 10px; border:1px solid #ddd; border-radius:10px; text-decoration:none;" %>
                <% end %>

                <%= form_with model: [:admin, shop],
                    url: admin_shop_path(shop, status: @status, source: @source, per: @per, page: @page),
                    method: :patch,
                    local: true,
                    style: "display:flex; gap:6px; align-items:center; flex-wrap:wrap;" do |f| %>
                  <%= f.url_field :tabelog_candidate_url,
                      value: candidate_url.presence,
                      placeholder: "食べログ候補URL",
                      style: "width:260px; padding:6px 8px; border:1px solid #ddd; border-radius:10px;" %>

                  <%= f.hidden_field :tabelog_candidate_affiliate_url, value: candidate_url.presence %>
                  <%= f.hidden_field :tabelog_candidate_method, value: "admin_manual_candidate" %>

                  <%= f.submit "候補URL更新",
                      style: "padding:6px 10px; border:1px solid #111; border-radius:10px; background:#111; color:#fff; font-weight:700;" %>
                <% end %>

                <%= link_to "公開ページ",
                    shop_path(shop),
                    target: "_blank",
                    rel: "noopener",
                    style: "display:inline-flex; align-items:center; white-space:nowrap; padding:6px 10px; border:1px solid #ddd; border-radius:10px; text-decoration:none;" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if (@total_pages || 1) > 1 %>
    <div style="margin:12px 0; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
      <% if (@page || 1) > 1 %>
        <%= link_to "← 前へ",
            admin_shops_path(status: @status, source: @source, per: @per, page: (@page - 1)),
            style: "padding:8px 10px; border:1px solid #ddd; border-radius:10px; text-decoration:none; display:inline-block;" %>
      <% end %>

      <% if (@page || 1) < (@total_pages || 1) %>
        <%= link_to "次へ →",
            admin_shops_path(status: @status, source: @source, per: @per, page: (@page + 1)),
            style: "padding:8px 10px; border:1px solid #ddd; border-radius:10px; text-decoration:none; display:inline-block;" %>
      <% end %>
    </div>
  <% end %>

  <script>
    (function () {
      const selectAll = document.getElementById("select_all");
      const boxes = Array.from(document.querySelectorAll(".shop_checkbox"));
      const countEl = document.getElementById("selected_count");
      const csvEl = document.getElementById("shop_ids_csv");
      const bulkForm = document.getElementById("bulk_form");
      const copyButtons = Array.from(document.querySelectorAll(".copy-address-button"));

      function selectedIds() {
        return boxes.filter(b => b.checked).map(b => b.value);
      }

      function update() {
        const ids = selectedIds();
        countEl.textContent = `選択：${ids.length}件`;
        csvEl.value = ids.join(",");

        if (selectAll) {
          selectAll.checked = (ids.length > 0 && ids.length === boxes.length);
          selectAll.indeterminate = (ids.length > 0 && ids.length < boxes.length);
        }
      }

      if (selectAll) {
        selectAll.addEventListener("change", () => {
          boxes.forEach(b => b.checked = selectAll.checked);
          update();
        });
      }

      boxes.forEach(b => b.addEventListener("change", update));

      if (bulkForm) {
        bulkForm.addEventListener("submit", (e) => {
          const ids = selectedIds();
          if (ids.length === 0) {
            e.preventDefault();
            alert("店舗が選択されていません");
          }
        });
      }

      copyButtons.forEach((button) => {
        button.addEventListener("click", async () => {
          const address = button.dataset.address || "";
          if (!address) return;

          try {
            await navigator.clipboard.writeText(address);
            const originalText = button.textContent;
            button.textContent = "コピー済み";
            setTimeout(() => {
              button.textContent = originalText;
            }, 1200);
          } catch (error) {
            alert("コピーに失敗しました");
          }
        });
      });

      update();
    })();
  </script>
<% else %>
  <p>該当する店舗はありません。</p>
<% end %>