<%# /Users/kawamuratakuya/dev/suelog/app/views/admin/shops/index.html.erb %>

<% hotpepper_setup = %w[hotpepper_missing hotpepper_configured hotpepper_not_found].include?(@status) %>
<% gurunavi_setup = %w[gurunavi_missing gurunavi_configured gurunavi_not_found].include?(@status) %>
<h1><%= gurunavi_setup ? "ぐるなび アフィリエイト設定" : hotpepper_setup ? "ホットペッパー アフィリエイト設定" : "店舗管理" %></h1>
<% if gurunavi_setup %>
  <p>ぐるなびの店舗URLを入力すると、アフィリエイトURLを自動生成します。空欄でEnterを押すと店舗を検索できます。</p>
<% end %>
<% if hotpepper_setup %>
  <p>ホットペッパーの店舗URLを入力すると、アフィリエイトURLを自動生成します。空欄でEnterを押すと店舗を検索できます。</p>
<% end %>

<% if gurunavi_setup || hotpepper_setup %>
  <p>Google検索は店名＋市区町村で開始します。見つからない場合は電話番号で検索してください。「段階検索・店舗照合」は一致を確認できた店舗詳細URLだけを自動登録します。検索できない店舗は未確認のまま残します。</p>
  <% unless RestaurantUrlSearch::SerpApi.new.available? %>
    <p style="color:#8a6500;">現在は自動検索のAPI設定（SERPAPI_KEY）がありません。Google検索・電話番号での手動確認は利用できます。</p>
  <% end %>
  <%= link_to "検索結果を更新", admin_shops_path(status: @status, q: @q, source: @source, page: @page, per: @per), data: { turbo: false } %>
<% end %>

<% if %w[tabelog_not_found hotpepper_not_found gurunavi_not_found].include?(@status) %>
  <p>「なし」にした店舗の一覧です。「未設定に戻す」で解除すると、未設定一覧からURLを再登録できます。</p>
<% end %>

<%= render "global_booking_visibility" %>
<% if @affiliate_setup %><p>店舗ページのアクセス数が多い順（累計PV・ボット除外）で表示しています。</p><% end %>

<div style="margin:10px 0; display:flex; gap:10px; flex-wrap:wrap;">
  <%= link_to "＋ 新規店舗を登録",
      new_admin_shop_path,
      style: "display:inline-block; padding:10px 14px; border-radius:10px; background:#111; color:#fff; text-decoration:none; font-weight:700;" %>

  <%= link_to "食べログ貼り付けインポート",
      new_admin_shop_import_path,
      style: "display:inline-block; padding:10px 14px; border-radius:10px; background:#fff; color:#111; border:1px solid #111; text-decoration:none; font-weight:700;" %>

  <%= link_to "怪しい食べログ候補",
      admin_shops_path(status: "tabelog_suspect", source: @source, per: @per, page: 1),
      style: "display:inline-block; padding:10px 14px; border-radius:10px; background:#fff3cd; color:#7a4b00; border:1px solid #e0b84f; text-decoration:none; font-weight:700;" %>

  <%= link_to "アフィリエイト未設定",
      admin_shops_path(status: "tabelog_missing", source: @source, per: @per, page: 1),
      style: "display:inline-block; padding:10px 14px; border-radius:10px; background:#eef8f0; color:#137333; border:1px solid #137333; text-decoration:none; font-weight:700;" %>
  <%= link_to "ホットペッパー アフィリエイト設定", admin_shops_path(status: "hotpepper_missing", per: @per, page: 1), style: "display:inline-block; padding:10px 14px; border-radius:10px; background:#fff0f3; color:#a31545; border:1px solid #a31545; text-decoration:none; font-weight:700;" %>
  <%= link_to "ぐるなび アフィリエイト設定", admin_shops_path(status: "gurunavi_missing", per: @per, page: 1) %>
</div>

<div style="margin:10px 0; padding:10px; border:1px solid #ddd; border-radius:12px;">
  <div style="margin-bottom:12px;">
    <form action="<%= admin_shops_path %>" method="get" style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
      <input type="hidden" name="status" value="<%= @status %>">
      <input type="hidden" name="source" value="<%= @source %>">
      <input type="hidden" name="per" value="<%= @per %>">
      <input type="hidden" name="page" value="1">

      <input type="text"
             name="q"
             value="<%= @q %>"
             placeholder="店名・住所・駅名・電話番号で検索"
             style="width:320px; max-width:100%; padding:8px 12px; border:1px solid #ddd; border-radius:10px;">

      <button type="submit"
              style="padding:8px 12px; border:1px solid #111; border-radius:10px; background:#111; color:#fff;">
        検索
      </button>

      <% if @q.present? %>
        <%= link_to "クリア",
            admin_shops_path(status: @status, source: @source, per: @per, page: 1),
            style: "padding:8px 12px; border:1px solid #ddd; border-radius:10px; text-decoration:none; background:#fff;" %>
      <% end %>
    </form>
  </div>

  <div style="display:flex; gap:14px; flex-wrap:wrap; align-items:center; justify-content:space-between;">
    <div>
      <strong>表示：</strong>

      <% if @status == "all" %>
        <strong>すべて</strong>｜
      <% else %>
        <%= link_to "すべて", admin_shops_path(status: "all", source: @source, per: @per, page: 1) %>｜
      <% end %>

      <% if @status == "pending" || @status.blank? %>
        <strong>承認待ち</strong>｜
      <% else %>
        <%= link_to "承認待ち", admin_shops_path(status: "pending", source: @source, per: @per, page: 1) %>｜
      <% end %>

      <% if @status == "rejected" %>
        <strong>却下</strong>｜
      <% else %>
        <%= link_to "却下", admin_shops_path(status: "rejected", source: @source, per: @per, page: 1) %>｜
      <% end %>

      <% if @status == "unverified" %>
        <strong>未確認のみ</strong>｜
      <% else %>
        <%= link_to "未確認のみ", admin_shops_path(status: "unverified", source: @source, per: @per, page: 1) %>｜
      <% end %>

      <% if @status == "tabelog_suspect" %>
        <strong>怪しい食べログ候補</strong>｜
      <% else %>
        <%= link_to "怪しい食べログ候補", admin_shops_path(status: "tabelog_suspect", source: @source, per: @per, page: 1) %>｜
      <% end %>

      <% if @status == "tabelog_missing" %>
        <strong>アフィリエイト未設定</strong>｜
      <% else %>
        <%= link_to "アフィリエイト未設定", admin_shops_path(status: "tabelog_missing", source: @source, per: @per, page: 1) %>｜
      <% end %>

      <% if @status == "tabelog_configured" %>
        <strong>アフィリエイト設定済み</strong>｜
      <% else %>
        <%= link_to "アフィリエイト設定済み", admin_shops_path(status: "tabelog_configured", source: @source, per: @per, page: 1) %>｜
      <% end %>

      <% if @status == "hotpepper_missing" %>
        <strong>ホットペッパー未設定</strong>｜
      <% else %>
        <%= link_to "ホットペッパー未設定", admin_shops_path(status: "hotpepper_missing", source: @source, per: @per, page: 1) %>｜
      <% end %>
      <% if @status == "hotpepper_configured" %>
        <strong>ホットペッパー設定済み</strong>｜
      <% else %>
        <%= link_to "ホットペッパー設定済み", admin_shops_path(status: "hotpepper_configured", source: @source, per: @per, page: 1) %>｜
      <% end %>

      <%= link_to "ぐるなび未登録", admin_shops_path(status: "gurunavi_missing", per: @per, page: 1) %>｜
      <%= link_to "ぐるなび設定済み", admin_shops_path(status: "gurunavi_configured", per: @per, page: 1) %>｜

      <% { "tabelog" => "食べログ", "hotpepper" => "ホットペッパー", "gurunavi" => "ぐるなび" }.each do |provider, label| %>
        <%= link_to "#{label}なし一覧", admin_shops_path(status: "#{provider}_not_found", per: @per, page: 1) %>｜
      <% end %>

      <% if @status == "hold" %>
        <strong>保留一覧</strong>
      <% else %>
        <%= link_to "保留一覧", holds_admin_shops_path %>
      <% end %>
    </div>

    <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
      <div style="display:flex; gap:8px; align-items:center;">
        <strong>表示件数：</strong>
        <form action="<%= admin_shops_path %>" method="get" style="display:flex; gap:8px; align-items:center;">
          <input type="hidden" name="status" value="<%= @status %>">
          <input type="hidden" name="source" value="<%= @source %>">
          <input type="hidden" name="page" value="1">
          <select name="per" style="padding:6px 8px; border:1px solid #ddd; border-radius:10px;">
            <% [50, 100, 200, 500].each do |n| %>
              <option value="<%= n %>" <%= "selected" if @per.to_i == n %>><%= n %></option>
            <% end %>
          </select>
          <button type="submit" style="padding:6px 10px; border:1px solid #ddd; border-radius:10px; background:#fff;">
            反映
          </button>
        </form>
      </div>

      <% if Shop.column_names.include?("source") %>
        <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
          <strong>source：</strong>
          <form action="<%= admin_shops_path %>" method="get" style="display:flex; gap:8px; align-items:center;">
            <input type="hidden" name="status" value="<%= @status %>">
            <input type="hidden" name="per" value="<%= @per %>">
            <input type="hidden" name="page" value="1">
            <select name="source" style="padding:6px 8px; border:1px solid #ddd; border-radius:10px;">
              <option value="" <%= "selected" if @source.blank? %>>すべて</option>
              <option value="google" <%= "selected" if @source == "google" %>>google</option>
            </select>
            <button type="submit" style="padding:6px 10px; border:1px solid #ddd; border-radius:10px; background:#fff;">
              絞り込む
            </button>
          </form>
        </div>
      <% end %>
    </div>
  </div>
</div>

<p data-shop-count style="color:#666; margin:8px 0;">
  件数：<span data-shop-total><%= (@total_count || @shops.count) %></span> 件 ／ ページ：<%= (@page || 1) %> / <%= (@total_pages || 1) %>
</p>

<div data-shop-pagination><%= render "pagination" %></div>

<div data-url-update-notice role="status" hidden style="margin:12px 0; color:#137333;"></div>

<% if @shops.any? %>
  <%= form_with url: bulk_update_admin_shops_path, method: :patch, local: true, id: "bulk_form" do %>
    <input type="hidden" name="status" value="<%= @status %>">
    <input type="hidden" name="source" value="<%= @source %>">
    <input type="hidden" name="per" value="<%= @per %>">
    <input type="hidden" name="page" value="<%= @page %>">
    <input type="hidden" name="shop_ids_csv" id="shop_ids_csv" value="">

    <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin:10px 0; padding:10px; border:1px solid #eee; border-radius:12px; background:#fafafa;">
      <label style="display:flex; align-items:center; gap:8px;">
        <input type="checkbox" id="select_all">
        <strong>全選択（このページ）</strong>
      </label>

      <span id="selected_count" style="color:#666;">選択：0件</span>

      <button type="submit"
              name="operation"
              value="approve"
              data-turbo="false"
              data-turbo-confirm="選択した店舗を一括承認しますか？"
              style="padding:8px 10px; border:1px solid #ddd; border-radius:10px; background:#fff;">
        一括承認
      </button>

      <button type="submit"
              name="operation"
              value="reject"
              data-turbo="false"
              data-turbo-confirm="選択した店舗を一括却下しますか？"
              style="padding:8px 10px; border:1px solid #ddd; border-radius:10px; background:#fff;">
        一括却下
      </button>

      <button type="submit"
              name="operation"
              value="unverify"
              data-turbo="false"
              data-turbo-confirm="選択した店舗の未確認を解除しますか？"
              style="padding:8px 10px; border:1px solid #ddd; border-radius:10px; background:#fff;">
        未確認を解除
      </button>

      <span style="color:#999; font-size:12px;">
        ※ 一括操作は「このページでチェックされた店舗のみ」
      </span>
    </div>
  <% end %>

  <div class="admin-table-wrap" style="overflow-x:auto; -webkit-overflow-scrolling:touch; padding-bottom:4px;">
    <table style="width:100%; border-collapse:collapse; min-width:1500px; table-layout:auto;">
      <thead>
        <tr style="border-bottom:2px solid #111;">
          <th align="left" style="width:42px;">選択</th>
          <th align="left">店名</th>
          <th align="left">住所</th>
          <th align="left">状態</th>
          <% if @affiliate_setup %><th align="right">アクセス（累計PV）</th><% end %>
          <th align="right">合計</th>
          <th align="right">電話</th>
          <th align="right">地図</th>
          <th align="right">アフィリ</th>
          <th align="left" style="padding:8px 0 8px 0; white-space:nowrap; min-width:420px;">操作</th>
        </tr>
      </thead>

      <tbody data-shop-rows>
        <%= render partial: "row", collection: @shops, as: :shop %>
      </tbody>
    </table>
  </div>

  <div data-shop-pagination><%= render "pagination" %></div>

  <script>
    (function () {
      const selectAll = document.getElementById("select_all");
      let boxes = Array.from(document.querySelectorAll(".shop_checkbox"));
      const countEl = document.getElementById("selected_count");
      const csvEl = document.getElementById("shop_ids_csv");
      const bulkForm = document.getElementById("bulk_form");

      function selectedIds() {
        return boxes.filter(b => b.checked).map(b => b.value);
      }

      function update() {
        const ids = selectedIds();
        countEl.textContent = `選択：${ids.length}件`;
        csvEl.value = ids.join(",");

        if (selectAll) {
          selectAll.checked = (ids.length > 0 && ids.length === boxes.length);
          selectAll.indeterminate = (ids.length > 0 && ids.length < boxes.length);
        }
      }

      if (selectAll) {
        selectAll.addEventListener("change", () => {
          boxes.forEach(b => b.checked = selectAll.checked);
          update();
        });
      }

      boxes.forEach(b => { b.dataset.bound = "true"; b.addEventListener("change", update); });

      if (bulkForm) {
        bulkForm.addEventListener("submit", (e) => {
          const ids = selectedIds();
          if (ids.length === 0) {
            e.preventDefault();
            alert("店舗が選択されていません");
          }
        });
      }

      function bindCopyButtons() {
      document.querySelectorAll(".copy-address-button").forEach((button) => {
        if (button.dataset.bound) return;
        button.dataset.bound = "true";
        button.addEventListener("click", async () => {
          const address = button.dataset.address || "";
          if (!address) return;

          try {
            await navigator.clipboard.writeText(address);
            const originalText = button.textContent;
            button.textContent = "コピー済み";
            setTimeout(() => {
              button.textContent = originalText;
            }, 1200);
          } catch (error) {
            alert("コピーに失敗しました");
          }
        });
      });

      }
      bindCopyButtons();

      function focusTabelogInput(form) {
        const input = form?.querySelector('[type="url"]');
        if (!input || input.readOnly) return;
        input.focus();
        input.select();
      }

      const csrfMeta = document.querySelector('meta[name="csrf-token"]');
      async function saveTabelogForm(form, retry = true) {
        const body = new FormData(form);
        if (csrfMeta?.content) body.set("authenticity_token", csrfMeta.content);
        const response = await fetch(form.action, {
          method: "PATCH", body, credentials: "same-origin",
          headers: { "Accept": "application/json", "X-CSRF-Token": csrfMeta?.content || "" }
        });
        const result = await response.json().catch(() => ({ error: "登録できませんでした。画面を再読み込みして再度お試しください。" }));
        if (result.code === "invalid_csrf" && retry) {
          const refreshed = await fetch("<%= refresh_form_token_admin_shops_path %>", { credentials: "same-origin", cache: "no-store", headers: { "Accept": "application/json" } });
          if (refreshed.ok) {
            const token = await refreshed.json();
            csrfMeta.content = token.csrf_token;
            return saveTabelogForm(form, false);
          }
        }
        if (!response.ok) throw new Error(result.error || "登録できませんでした");
        return result;
      }

      let refillQueue = Promise.resolve();
      function refillShopRows() {
        refillQueue = refillQueue.catch(() => {}).then(async () => {
          const url = new URL(window.location.href);
          url.searchParams.set("format", "json");
          url.searchParams.delete("visible_ids[]");
          document.querySelectorAll("[data-shop-row-id]").forEach(row => url.searchParams.append("visible_ids[]", row.dataset.shopRowId));
          const response = await fetch(url, { credentials: "same-origin", cache: "no-store", headers: { "Accept": "application/json" } });
          if (!response.ok) throw new Error("保存は完了しましたが、次の店舗を補充できませんでした。再読み込みしてください。");
          const result = await response.json();
          const tbody = document.querySelector("[data-shop-rows]");
          const template = document.createElement("template");
          template.innerHTML = `<table><tbody>${result.rows_html}</tbody></table>`;
          template.content.querySelectorAll("tr[data-shop-row-id]").forEach(row => {
            if (!document.querySelector(`[data-shop-row-id="${row.dataset.shopRowId}"]`)) tbody.appendChild(row);
          });
          if (csrfMeta && result.csrf_token) csrfMeta.content = result.csrf_token;
          document.querySelectorAll("[data-shop-pagination]").forEach(container => { container.innerHTML = result.pagination_html; });
          boxes = Array.from(document.querySelectorAll(".shop_checkbox"));
          boxes.forEach(box => {
            if (box.dataset.bound) return;
            box.dataset.bound = "true";
            box.addEventListener("change", update);
          });
          bindCopyButtons();
          bindTabelogRows();
          bindSearchLinks();
          update();
          document.querySelector("[data-shop-count]").innerHTML = `件数：<span data-shop-total>${result.total_count}</span> 件 ／ ページ：${result.page} / ${result.total_pages}`;
        });
        return refillQueue;
      }

      function bindTabelogRows() {
      document.querySelectorAll("[data-inline-tabelog-form]").forEach((form) => {
        if (form.dataset.bound) return;
        form.dataset.bound = "true";
        const urlInput = form.querySelector('[type="url"]');
        urlInput.addEventListener("keydown", (event) => {
          if (event.key !== "Enter" || event.isComposing || urlInput.readOnly || urlInput.value.trim()) return;
          const searchLink = form.closest("tr").querySelector("[data-tabelog-search-shop-id]");
          if (!searchLink) return;
          event.preventDefault();
          searchLink.click();
        });
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          if (form.dataset.saving === "true") return;
          const status = form.querySelector("[data-url-save-status]");
          const button = form.querySelector('[type="submit"]');
          const input = form.querySelector('[type="url"]');
          const body = new FormData(form);
          form.dataset.saving = "true";
          button.disabled = true;
          input.readOnly = true;
          status.textContent = "保存中…";
          status.style.color = "#666";
          try {
            const result = await saveTabelogForm(form);
            input.value = result.url;
            const row = form.closest("tr");
            const checkbox = row.querySelector(".shop_checkbox");
            if (checkbox) checkbox.checked = false;
            boxes = boxes.filter(box => box !== checkbox);
            const forms = Array.from(document.querySelectorAll("[data-inline-tabelog-form]"));
            const index = forms.indexOf(form);
            const nextForm = forms.slice(index + 1).concat(forms.slice(0, index))
              .find(candidate => candidate.dataset.saving !== "true");
            const advanceFocus = form.contains(document.activeElement);
            row.remove();
            if (advanceFocus) focusTabelogInput(nextForm);
            update();
            const total = document.querySelector("[data-shop-total]");
            if (total) total.textContent = String(Math.max(0, Number(total.textContent) - 1));
            const notice = document.querySelector("[data-url-update-notice]");
            notice.hidden = false;
            notice.textContent = result.completion_message || `${result.shop_name || "店舗"}を設定済みへ移動しました。`;
            notice.style.color = "#137333";
            try {
              await refillShopRows();
              if (advanceFocus && !nextForm) focusTabelogInput(document.querySelector("[data-inline-tabelog-form]"));
            } catch (error) { notice.textContent = error.message; notice.style.color = "#b00020"; }
          } catch (error) {
            status.textContent = error.message || "通信に失敗しました。再度更新してください";
            status.style.color = "#b00020";
          } finally {
            form.dataset.saving = "false";
            button.disabled = false;
            input.readOnly = false;
          }
        });
      });

      document.querySelectorAll("[data-booking-visibility-form]").forEach((form) => {
        if (form.dataset.bound) return;
        form.dataset.bound = "true";
        form.addEventListener("submit", async event => {
          event.preventDefault();
          if (form.dataset.saving === "true") return;
          form.dataset.saving = "true";
          const button = form.querySelector('[type="submit"]');
          const status = form.querySelector("[data-booking-visibility-status]");
          button.disabled = true;
          status.textContent = "保存中…";
          try {
            const result = await saveTabelogForm(form);
            form.querySelector('[name="hidden"]').value = result.hidden ? "0" : "1";
            button.value = result.hidden ? "予約ボタンを表示" : "予約ボタンを非表示";
            status.textContent = result.hidden ? "非表示中" : "表示中";
            status.style.color = "#137333";
          } catch (error) {
            status.textContent = error.message;
            status.style.color = "#b00020";
          } finally {
            form.dataset.saving = "false";
            button.disabled = false;
          }
        });
      });

      document.querySelectorAll("[data-tabelog-not-found-form]").forEach((form) => {
        if (form.dataset.bound) return;
        form.dataset.bound = "true";
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          if (form.dataset.saving === "true") return;
          const provider = form.dataset.bookingProvider || "食べログ";
          if (!window.confirm(`${provider}なしとして登録しますか？`)) return;
          const button = form.querySelector('[type="submit"]');
          const originalLabel = button.textContent;
          const notice = document.querySelector("[data-url-update-notice]");
          form.dataset.saving = "true";
          button.disabled = true;
          button.textContent = "保存中…";
          try {
            const result = await saveTabelogForm(form);
            const row = form.closest("tr");
            const checkbox = row.querySelector(".shop_checkbox");
            if (checkbox) checkbox.checked = false;
            boxes = boxes.filter(box => box !== checkbox);
            row.remove();
            update();
            const total = document.querySelector("[data-shop-total]");
            if (total) total.textContent = String(Math.max(0, Number(total.textContent) - 1));
            notice.textContent = `${result.shop_name || "店舗"}を${provider}なしとして登録しました。`;
            notice.style.color = "#137333";
            await refillShopRows();
          } catch (error) {
            notice.textContent = error.message || "通信に失敗しました。再度登録してください";
            notice.style.color = "#b00020";
          } finally {
            notice.hidden = false;
            form.dataset.saving = "false";
            button.disabled = false;
            button.textContent = originalLabel;
          }
        });
      });

      }
      bindTabelogRows();

      const focusStorageKey = "suelog-tabelog-search-shop";
      function restoreSearchFocus() {
        if (document.visibilityState !== "visible") return;
        let shopId;
        try { shopId = sessionStorage.getItem(focusStorageKey); } catch (_) { return; }
        if (!shopId || !/^\d+$/.test(shopId)) return;
        const form = document.querySelector(`[data-inline-tabelog-form][data-shop-id="${shopId}"]`);
        if (form) focusTabelogInput(form);
        try { sessionStorage.removeItem(focusStorageKey); } catch (_) {}
      }
      function bindSearchLinks() {
      document.querySelectorAll("[data-tabelog-search-shop-id]").forEach((link) => {
        if (link.dataset.bound) return;
        link.dataset.bound = "true";
        link.addEventListener("click", () => {
          const shopId = link.dataset.tabelogSearchShopId;
          const form = document.querySelector(`[data-inline-tabelog-form][data-shop-id="${shopId}"]`);
          if (!form) return;
          try { sessionStorage.setItem(focusStorageKey, shopId); } catch (_) {}
          focusTabelogInput(form);
        });
      });
      }
      bindSearchLinks();
      window.addEventListener("focus", restoreSearchFocus);
      document.addEventListener("visibilitychange", restoreSearchFocus);
      restoreSearchFocus();

      update();
    })();
  </script>
<% else %>
  <p>該当する店舗はありません。</p>
<% end %>

<div style="margin:10px 0; padding:12px; border:1px solid #ddd; border-radius:12px; background:#fafafa;">
  <div style="font-weight:900; margin-bottom:8px;">CSV一括インポート</div>

  <%= form_with url: import_admin_shops_path,
      multipart: true,
      local: true,
      style: "display:flex; gap:10px; align-items:center; flex-wrap:wrap;" do %>

    <%= file_field_tag :file, accept: ".csv", required: true %>

    <%= submit_tag "インポートする",
        style: "padding:8px 12px; border:1px solid #111; border-radius:10px; background:#111; color:#fff;" %>
  <% end %>

  <div style="color:#666; font-size:12px; margin-top:8px; line-height:1.6;">
    ・phone を数字化して normalized_phone で既存判定 → あれば更新 / なければ新規<br>
    ・喫煙エリア or 喫煙タイプが空なら自動で承認待ち（noteに「未確認」を追記）<br>
  </div>
</div>
