<% gurunavi_setup = %w[gurunavi_missing gurunavi_configured].include?(@status) %>
<% hotpepper_setup = %w[hotpepper_missing hotpepper_configured].include?(@status) %>
          <% rejected = (shop.respond_to?(:rejected?) && shop.rejected?) %>

          <% duplicate_state =
              if @status == "pending"
                (@duplicate_states || {})[shop.id] || :none
              else
                :none
              end %>

          <% detail_label, detail_style =
              case duplicate_state
              when :approved_or_rejected
                [
                  "詳細（重複候補あり）",
                  "display:inline-flex; align-items:center; white-space:nowrap; padding:6px 10px; border:1px solid #b00020; background:#fff1f1; color:#b00020; font-weight:700; border-radius:10px; text-decoration:none;"
                ]
              when :pending_only
                [
                  "詳細（承認待ち重複）",
                  "display:inline-flex; align-items:center; white-space:nowrap; padding:6px 10px; border:1px solid #9aa0a6; background:#f5f5f5; color:#555; font-weight:700; border-radius:10px; text-decoration:none;"
                ]
              else
                [
                  "詳細",
                  "display:inline-flex; align-items:center; white-space:nowrap; padding:6px 10px; border:1px solid #137333; background:#eef8f0; color:#137333; font-weight:700; border-radius:10px; text-decoration:none;"
                ]
              end %>

          <% click_counts = (@shop_click_counts || {})[shop.id] || {} %>
          <% candidate_url = shop.respond_to?(:tabelog_candidate_url) ? shop.tabelog_candidate_url : nil %>

          <tr data-shop-row-id="<%= shop.id %>" style="border-bottom:1px solid #ddd; vertical-align:top;">
            <td style="padding:10px 0;">
              <input type="checkbox" class="shop_checkbox" value="<%= shop.id %>">
            </td>

            <td style="padding:8px 0;">
              <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                <strong><%= shop.name %></strong>

                <%= link_to "Google検索",
                    "https://www.google.com/search?q=#{ERB::Util.url_encode([shop.name, shop.address, gurunavi_setup ? 'ぐるなび -site:tabelog.com' : hotpepper_setup ? 'ホットペッパーグルメ -site:tabelog.com' : '食べログ'].compact.join(' '))}",
                    data: { tabelog_search_shop_id: shop.id },
                    target: "_blank",
                    rel: "noopener",
                    style: "display:inline-block; padding:4px 8px; border:1px solid #ddd; border-radius:8px; text-decoration:none; font-size:12px; background:#fff;" %>
              </div>

              <% if shop.respond_to?(:smoking_unverified?) && shop.smoking_unverified? %>
                <div style="margin-top:6px;">
                  <span style="display:inline-flex; align-items:center; padding:3px 8px; border-radius:999px; font-size:11px; font-weight:800; background:#fff6db; color:#8a6500; border:1px solid #f0de9c;">
                    未確認
                  </span>
                </div>
              <% end %>

              <% if shop.respond_to?(:on_hold?) && shop.on_hold? %>
                <div style="margin-top:6px;">
                  <span style="display:inline-flex; align-items:center; padding:3px 8px; border-radius:999px; font-size:11px; font-weight:800; background:#ffe9e9; color:#b00020; border:1px solid #f3b2b2;">
                    保留：<%= shop.hold_reason_label %>
                  </span>
                </div>
              <% end %>

              <% if Shop.column_names.include?("source") && shop.respond_to?(:source) && shop.source.present? %>
                <div style="color:#666; font-size:12px; margin-top:4px;">source：<%= shop.source %></div>
              <% end %>

              <% if @status == "hotpepper_missing" %>
                <div style="color:#b00020; font-size:12px; margin-top:6px; font-weight:700;">ホットペッパーアフィリエイト未設定</div>
              <% end %>
              <% if @status == "tabelog_missing" %>
                <div data-affiliate-missing style="color:#b00020; font-size:12px; margin-top:6px; font-weight:700;">
                  食べログアフィリエイト未設定
                </div>
              <% end %>
            </td>

            <td style="padding:8px 0;">
              <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                <span><%= shop.address.presence || "未設定" %></span>

                <% if shop.address.present? %>
                  <button type="button"
                          class="copy-address-button"
                          data-address="<%= shop.address %>"
                          style="padding:4px 8px; border:1px solid #ddd; border-radius:8px; background:#fff; font-size:12px; cursor:pointer;">
                    住所コピー
                  </button>
                <% end %>
              </div>
            </td>

            <td style="padding:8px 0;">
              <% if shop.respond_to?(:on_hold?) && shop.on_hold? %>
                <span style="color:#b00020; font-weight:bold;">保留中</span>
              <% elsif shop.approved? %>
                <span style="color:#137333; font-weight:bold;">承認済み</span>
              <% elsif rejected %>
                <span style="color:#b00020; font-weight:bold;">却下</span>
              <% else %>
                <span style="color:#b00020; font-weight:bold;">承認待ち</span>
              <% end %>

              <% if shop.respond_to?(:smoking_unverified?) && shop.smoking_unverified? %>
                <div style="margin-top:4px; color:#8a6500; font-size:12px; font-weight:700;">
                  喫煙情報未確認
                </div>
              <% end %>
            </td>

            <% if @affiliate_setup %>
              <td align="right" style="padding:8px 12px 8px 0; font-weight:700;" data-affiliate-access-count><%= shop.affiliate_access_count.to_i %></td>
            <% end %>

            <td align="right" style="padding:8px 12px 8px 0; font-weight:700;">
              <%= click_counts[:total].to_i %>
            </td>

            <td align="right" style="padding:8px 12px 8px 0;">
              <%= click_counts[:phone_click].to_i %>
            </td>

            <td align="right" style="padding:8px 12px 8px 0;">
              <%= click_counts[:map_click].to_i %>
            </td>

            <td align="right" style="padding:8px 12px 8px 0;">
              <%= click_counts[:affiliate_click].to_i %>
            </td>

            <td style="padding:10px 0; min-width:420px;">
              <div class="admin-shop-actions" style="display:flex; gap:8px; flex-wrap:wrap; align-items:flex-start; min-width:400px;">
                <% if !shop.approved? && !shop.rejected? %>
                  <%= button_to "承認",
                      approve_admin_shop_path(shop, status: @status, source: @source, per: @per, page: @page),
                      method: :patch,
                      data: { turbo: false, turbo_confirm: "承認しますか？" } %>

                  <%= button_to "却下",
                      reject_admin_shop_path(shop, status: @status, source: @source, per: @per, page: @page),
                      method: :patch,
                      data: { turbo: false, turbo_confirm: "却下します。よろしいですか？" } %>

                  <% if @status == "pending" && duplicate_state == :approved_or_rejected %>
                    <%= button_to "重複として却下",
                        reject_admin_shop_path(shop, status: @status, source: @source, per: @per, page: @page),
                        method: :patch,
                        data: { turbo: false, turbo_confirm: "重複として却下しますか？" },
                        style: "background:#fff1f1; border:1px solid #b00020; color:#b00020;" %>
                  <% end %>
                <% end %>

                <%= link_to detail_label,
                    admin_shop_path(shop, status: @status, source: @source, per: @per, page: @page),
                    style: detail_style %>

                <%= link_to "編集",
                    edit_admin_shop_path(shop, status: @status, source: @source, per: @per, page: @page),
                    style: "display:inline-flex; align-items:center; white-space:nowrap; padding:6px 10px; border:1px solid #ddd; border-radius:10px; text-decoration:none;" %>

                <% if gurunavi_setup %>
                  <% if @status == "gurunavi_missing" %>
                    <%= button_to "ぐるなびなし", mark_gurunavi_not_found_admin_shop_path(shop, status: @status, per: @per, page: @page), method: :patch, form: { data: { turbo: false, tabelog_not_found_form: true, booking_provider: "ぐるなび" } }, style: "padding:6px 10px; border:1px solid #b00020; background:#fff1f1; color:#b00020; border-radius:10px; font-weight:700;" %>
                  <% end %>
                  <% if shop.gurunavi_url.present? && !shop.gurunavi_url.start_with?("https://not-found.local/") %>
                    <%= link_to "ぐるなび", shop.gurunavi_url, target: "_blank", rel: "noopener nofollow" %>
                    <span><%= shop.gurunavi_affiliate_url.present? ? "アフィリエイト設定済み" : "URL要確認（アフィリエイト未生成）" %></span>
                  <% end %>
                <% elsif hotpepper_setup %>
                  <% if @status == "hotpepper_missing" %>
                    <%= button_to "ホットペッパーなし",
                        mark_hotpepper_not_found_admin_shop_path(shop, status: @status, source: @source, per: @per, page: @page),
                        method: :patch,
                        form: { data: { turbo: false, tabelog_not_found_form: true, booking_provider: "ホットペッパー" } },
                        data: { turbo: false },
                        style: "padding:6px 10px; border:1px solid #b00020; background:#fff1f1; color:#b00020; border-radius:10px; font-weight:700;" %>
                  <% end %>
                  <% if shop.hotpepper_url.present? && !shop.hotpepper_url.start_with?("https://not-found.local/") %>
                    <%= link_to "ホットペッパー", shop.hotpepper_url, target: "_blank", rel: "noopener nofollow", style: "display:inline-flex; padding:6px 10px; border:1px solid #ddd; border-radius:10px; text-decoration:none;" %>
                  <% end %>
                <% elsif candidate_url.present? %>
                  <%= link_to "食べログ候補",
                      candidate_url,
                      target: "_blank",
                      rel: "noopener nofollow",
                      style: "display:inline-flex; align-items:center; white-space:nowrap; padding:6px 10px; border:1px solid #e0b84f; background:#fff8e1; color:#7a4b00; border-radius:10px; text-decoration:none; font-weight:700;" %>

                  <%= button_to "候補を承認",
                      approve_tabelog_candidate_admin_shop_path(shop, status: @status, source: @source, per: @per, page: @page),
                      method: :patch,
                      data: { turbo: false, turbo_confirm: "この食べログ候補を公開URLとして承認しますか？" },
                      style: "padding:6px 10px; border:1px solid #137333; background:#eef8f0; color:#137333; border-radius:10px; font-weight:700;" %>

                  <%= button_to "食べログなし",
                      mark_tabelog_not_found_admin_shop_path(shop, status: @status, source: @source, per: @per, page: @page),
                      method: :patch,
                      form: { data: { turbo: false, tabelog_not_found_form: true } },
                      data: { turbo: false },
                      style: "padding:6px 10px; border:1px solid #b00020; background:#fff1f1; color:#b00020; border-radius:10px; font-weight:700;" %>
                <% elsif @status == "tabelog_missing" %>
                  <%= button_to "食べログなし",
                      mark_tabelog_not_found_admin_shop_path(shop, status: @status, source: @source, per: @per, page: @page),
                      method: :patch,
                      form: { data: { turbo: false, tabelog_not_found_form: true } },
                      data: { turbo: false },
                      style: "padding:6px 10px; border:1px solid #b00020; background:#fff1f1; color:#b00020; border-radius:10px; font-weight:700;" %>
                <% elsif shop.tabelog_url.present? %>
                  <%= link_to "食べログ",
                      shop.tabelog_url,
                      target: "_blank",
                      rel: "noopener nofollow",
                      style: "display:inline-flex; align-items:center; white-space:nowrap; padding:6px 10px; border:1px solid #ddd; border-radius:10px; text-decoration:none;" %>
                <% end %>

                <%= form_with model: [:admin, shop],
                    url: admin_shop_path(shop, status: @status, source: @source, per: @per, page: @page),
                    method: :patch,
                    local: true,
                    data: { turbo: false, inline_tabelog_form: (%w[tabelog_missing hotpepper_missing gurunavi_missing].include?(@status) ? true : nil), shop_id: shop.id },
                    style: "display:flex; gap:6px; align-items:center; flex-wrap:wrap;" do |f| %>
                  <%= hidden_field_tag(gurunavi_setup ? :inline_gurunavi_update : hotpepper_setup ? :inline_hotpepper_update : :inline_tabelog_update, "1") %>
                  <span data-url-save-status role="status" style="font-size:12px;"></span>
                  <% if gurunavi_setup %>
                    <%= f.url_field :gurunavi_url, placeholder: "ぐるなびURL（空欄でEnter→検索）", style: "width:260px; padding:6px 8px;" %>
                    <%= f.submit "URL更新", style: "padding:6px 10px; border:1px solid #111; border-radius:10px; background:#111; color:#fff; font-weight:700;" %>
                  <% elsif hotpepper_setup %>
                    <%= f.url_field :hotpepper_url, value: shop.hotpepper_url.presence,
                        placeholder: "ホットペッパーURL（空欄でEnter→検索）",
                        style: "width:260px; padding:6px 8px; border:1px solid #ddd; border-radius:10px;" %>
                    <%= f.submit "URL更新", style: "padding:6px 10px; border:1px solid #111; border-radius:10px; background:#111; color:#fff; font-weight:700;" %>
                  <% elsif %w[tabelog_missing tabelog_configured].include?(@status) %>
                    <%= f.url_field :tabelog_url,
                        value: shop.tabelog_url.presence,
                        placeholder: "食べログURL（空欄でEnter→検索）",
                        style: "width:260px; padding:6px 8px; border:1px solid #ddd; border-radius:10px;" %>

                    <%= f.hidden_field :tabelog_match_method, value: "admin_manual" %>

                    <%= f.submit "URL更新",
                        style: "padding:6px 10px; border:1px solid #111; border-radius:10px; background:#111; color:#fff; font-weight:700;" %>
                  <% else %>
                    <%= f.url_field :tabelog_candidate_url,
                        value: candidate_url.presence,
                        placeholder: "食べログ候補URL",
                        style: "width:260px; padding:6px 8px; border:1px solid #ddd; border-radius:10px;" %>

                    <%= f.hidden_field :tabelog_candidate_affiliate_url, value: candidate_url.presence %>
                    <%= f.hidden_field :tabelog_candidate_method, value: "admin_manual_candidate" %>

                    <%= f.submit "候補URL更新",
                        style: "padding:6px 10px; border:1px solid #111; border-radius:10px; background:#111; color:#fff; font-weight:700;" %>
                  <% end %>
                <% end %>

                <% if gurunavi_setup || hotpepper_setup || %w[tabelog_missing tabelog_configured].include?(@status) %>
                  <% provider = gurunavi_setup ? "gurunavi" : hotpepper_setup ? "hotpepper" : "tabelog" %>
                  <% hidden = shop.public_send("hide_#{provider}_booking_button?") %>
                  <%= form_with url: booking_visibility_admin_shop_path(shop, status: @status, per: @per, page: @page), method: :patch,
                      local: true, data: { turbo: false, booking_visibility_form: true }, style: "display:flex; align-items:center; gap:6px;" do %>
                    <%= hidden_field_tag :provider, provider %>
                    <%= hidden_field_tag :hidden, hidden ? "0" : "1" %>
                    <%= submit_tag(hidden ? "予約ボタンを表示" : "予約ボタンを非表示", style: "padding:6px 10px; border:1px solid #777; border-radius:10px; background:#fff; color:#333;") %>
                    <span data-booking-visibility-status role="status" style="font-size:12px;"><%= "非表示中" if hidden %></span>
                  <% end %>
                <% end %>

                <%= link_to "公開ページ",
                    shop_path(shop),
                    target: "_blank",
                    rel: "noopener",
                    style: "display:inline-flex; align-items:center; white-space:nowrap; padding:6px 10px; border:1px solid #ddd; border-radius:10px; text-decoration:none;" %>
              </div>
            </td>
          </tr>
