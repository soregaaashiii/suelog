<%# /Users/kawamuratakuya/dev/suelog/app/views/admin/shops/clicks.html.erb %>

<h1>送客一覧</h1>

<div style="margin:10px 0; padding:10px; border:1px solid #ddd; border-radius:12px;">
  <div style="display:flex; gap:14px; flex-wrap:wrap; align-items:center; justify-content:space-between;">
    <div>
      <strong>表示：</strong>
      <% if @status == "approved" %>
        <strong>承認済み</strong>｜
        <%= link_to "すべて", admin_shop_clicks_path(status: "all", source: @source, per: @per, page: 1, q: @q) %>｜
        <%= link_to "承認待ち", admin_shop_clicks_path(status: "pending", source: @source, per: @per, page: 1, q: @q) %>｜
        <%= link_to "却下", admin_shop_clicks_path(status: "rejected", source: @source, per: @per, page: 1, q: @q) %>｜
        <%= link_to "未確認のみ", admin_shop_clicks_path(status: "unverified", source: @source, per: @per, page: 1, q: @q) %>｜
        <%= link_to "保留一覧", admin_shop_clicks_path(status: "hold", source: @source, per: @per, page: 1, q: @q) %>
      <% elsif @status == "all" %>
        <%= link_to "承認済み", admin_shop_clicks_path(status: "approved", source: @source, per: @per, page: 1, q: @q) %>｜
        <strong>すべて</strong>｜
        <%= link_to "承認待ち", admin_shop_clicks_path(status: "pending", source: @source, per: @per, page: 1, q: @q) %>｜
        <%= link_to "却下", admin_shop_clicks_path(status: "rejected", source: @source, per: @per, page: 1, q: @q) %>｜
        <%= link_to "未確認のみ", admin_shop_clicks_path(status: "unverified", source: @source, per: @per, page: 1, q: @q) %>｜
        <%= link_to "保留一覧", admin_shop_clicks_path(status: "hold", source: @source, per: @per, page: 1, q: @q) %>
      <% elsif @status == "rejected" %>
        <%= link_to "承認済み", admin_shop_clicks_path(status: "approved", source: @source, per: @per, page: 1, q: @q) %>｜
        <%= link_to "すべて", admin_shop_clicks_path(status: "all", source: @source, per: @per, page: 1, q: @q) %>｜
        <%= link_to "承認待ち", admin_shop_clicks_path(status: "pending", source: @source, per: @per, page: 1, q: @q) %>｜
        <strong>却下</strong>｜
        <%= link_to "未確認のみ", admin_shop_clicks_path(status: "unverified", source: @source, per: @per, page: 1, q: @q) %>｜
        <%= link_to "保留一覧", admin_shop_clicks_path(status: "hold", source: @source, per: @per, page: 1, q: @q) %>
      <% elsif @status == "unverified" %>
        <%= link_to "承認済み", admin_shop_clicks_path(status: "approved", source: @source, per: @per, page: 1, q: @q) %>｜
        <%= link_to "すべて", admin_shop_clicks_path(status: "all", source: @source, per: @per, page: 1, q: @q) %>｜
        <%= link_to "承認待ち", admin_shop_clicks_path(status: "pending", source: @source, per: @per, page: 1, q: @q) %>｜
        <%= link_to "却下", admin_shop_clicks_path(status: "rejected", source: @source, per: @per, page: 1, q: @q) %>｜
        <strong>未確認のみ</strong>｜
        <%= link_to "保留一覧", admin_shop_clicks_path(status: "hold", source: @source, per: @per, page: 1, q: @q) %>
      <% elsif @status == "hold" %>
        <%= link_to "承認済み", admin_shop_clicks_path(status: "approved", source: @source, per: @per, page: 1, q: @q) %>｜
        <%= link_to "すべて", admin_shop_clicks_path(status: "all", source: @source, per: @per, page: 1, q: @q) %>｜
        <%= link_to "承認待ち", admin_shop_clicks_path(status: "pending", source: @source, per: @per, page: 1, q: @q) %>｜
        <%= link_to "却下", admin_shop_clicks_path(status: "rejected", source: @source, per: @per, page: 1, q: @q) %>｜
        <%= link_to "未確認のみ", admin_shop_clicks_path(status: "unverified", source: @source, per: @per, page: 1, q: @q) %>｜
        <strong>保留一覧</strong>
      <% else %>
        <strong>承認済み</strong>｜
        <%= link_to "すべて", admin_shop_clicks_path(status: "all", source: @source, per: @per, page: 1, q: @q) %>｜
        <%= link_to "承認待ち", admin_shop_clicks_path(status: "pending", source: @source, per: @per, page: 1, q: @q) %>｜
        <%= link_to "却下", admin_shop_clicks_path(status: "rejected", source: @source, per: @per, page: 1, q: @q) %>｜
        <%= link_to "未確認のみ", admin_shop_clicks_path(status: "unverified", source: @source, per: @per, page: 1, q: @q) %>｜
        <%= link_to "保留一覧", admin_shop_clicks_path(status: "hold", source: @source, per: @per, page: 1, q: @q) %>
      <% end %>
    </div>

    <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
      <form action="<%= admin_shop_clicks_path %>" method="get" style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
        <input type="hidden" name="status" value="<%= @status %>">
        <input type="hidden" name="source" value="<%= @source %>">
        <input type="hidden" name="per" value="<%= @per %>">
        <input type="hidden" name="page" value="1">

        <input type="text"
               name="q"
               value="<%= @q %>"
               placeholder="店名・住所・駅で検索"
               style="padding:6px 10px; border:1px solid #ddd; border-radius:10px; width:220px;">

        <button type="submit"
                style="padding:6px 10px; border:1px solid #111; border-radius:10px; background:#111; color:#fff;">
          検索
        </button>

        <% if @q.present? %>
          <%= link_to "クリア",
              admin_shop_clicks_path(status: @status, source: @source, per: @per, page: 1),
              style: "padding:6px 10px; border:1px solid #ddd; border-radius:10px; text-decoration:none; background:#fff; color:#111;" %>
        <% end %>
      </form>

      <div style="display:flex; gap:8px; align-items:center;">
        <strong>表示件数：</strong>
        <form action="<%= admin_shop_clicks_path %>" method="get" style="display:flex; gap:8px; align-items:center;">
          <input type="hidden" name="status" value="<%= @status %>">
          <input type="hidden" name="source" value="<%= @source %>">
          <input type="hidden" name="q" value="<%= @q %>">
          <input type="hidden" name="page" value="1">
          <select name="per" style="padding:6px 8px; border:1px solid #ddd; border-radius:10px;">
            <% [50, 100, 200, 500].each do |n| %>
              <option value="<%= n %>" <%= "selected" if @per.to_i == n %>><%= n %></option>
            <% end %>
          </select>
          <button type="submit" style="padding:6px 10px; border:1px solid #ddd; border-radius:10px; background:#fff;">
            反映
          </button>
        </form>
      </div>

      <% if Shop.column_names.include?("source") %>
        <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
          <strong>source：</strong>
          <form action="<%= admin_shop_clicks_path %>" method="get" style="display:flex; gap:8px; align-items:center;">
            <input type="hidden" name="status" value="<%= @status %>">
            <input type="hidden" name="per" value="<%= @per %>">
            <input type="hidden" name="q" value="<%= @q %>">
            <input type="hidden" name="page" value="1">
            <select name="source" style="padding:6px 8px; border:1px solid #ddd; border-radius:10px;">
              <option value="" <%= "selected" if @source.blank? %>>すべて</option>
              <option value="google" <%= "selected" if @source == "google" %>>google</option>
            </select>
            <button type="submit" style="padding:6px 10px; border:1px solid #ddd; border-radius:10px; background:#fff;">
              絞り込む
            </button>
          </form>
        </div>
      <% end %>
    </div>
  </div>
</div>

<p style="color:#666; margin:8px 0;">
  件数：<%= (@total_count || @shops.count) %> 件 ／ ページ：<%= (@page || 1) %> / <%= (@total_pages || 1) %>
</p>

<% if (@total_pages || 1) > 1 %>
  <div style="margin:10px 0; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
    <% if (@page || 1) > 1 %>
      <%= link_to "← 前へ",
          admin_shop_clicks_path(status: @status, source: @source, per: @per, page: (@page - 1), q: @q),
          style: "padding:8px 10px; border:1px solid #ddd; border-radius:10px; text-decoration:none; display:inline-block;" %>
    <% end %>

    <% if (@page || 1) < (@total_pages || 1) %>
      <%= link_to "次へ →",
          admin_shop_clicks_path(status: @status, source: @source, per: @per, page: (@page + 1), q: @q),
          style: "padding:8px 10px; border:1px solid #ddd; border-radius:10px; text-decoration:none; display:inline-block;" %>
    <% end %>
  </div>
<% end %>

<% if @shops.any? %>
  <div style="overflow-x:auto;">
    <table style="width:100%; border-collapse:collapse; min-width:1200px;">
      <thead>
        <tr style="border-bottom:2px solid #111;">
          <th align="left">店名</th>
          <th align="left">エリア</th>
          <th align="left">住所</th>
          <th align="left">確認</th>
          <th align="right">合計</th>
          <th align="right">電話</th>
          <th align="right">地図</th>
          <th align="right">アフィリ</th>
          <th align="right">記事</th>
          <th align="right">記事流入率</th>
          <th align="left">主な記事</th>
          <th align="left">操作</th>
        </tr>
      </thead>

      <tbody>
        <% @shops.each do |shop| %>
          <% click_counts = (@shop_click_counts || {})[shop.id] || {} %>

          <tr style="border-bottom:1px solid #ddd; vertical-align:top;">
            <td style="padding:8px 0;">
              <strong><%= shop.name %></strong>
            </td>

            <td style="padding:8px 0;">
              <%= shop.area.presence || "なし" %>
            </td>

            <td style="padding:8px 0;">
              <%= shop.address.presence || "なし" %>
            </td>

            <td style="padding:8px 10px 8px 0; white-space:nowrap;">
              <% if shop.respond_to?(:smoking_unverified) && shop.smoking_unverified? %>
                <span style="display:inline-block; padding:4px 8px; border-radius:999px; background:#fdecea; color:#b00020; font-size:12px; font-weight:700; border:1px solid #f5c2c7;">
                  未確認
                </span>
              <% else %>
                <span style="display:inline-block; padding:4px 8px; border-radius:999px; background:#e6f4ea; color:#137333; font-size:12px; font-weight:700; border:1px solid #b7dfc2;">
                  確認済
                </span>
              <% end %>
            </td>

            <td align="right" style="padding:8px 12px 8px 0; font-weight:700;">
              <%= click_counts[:total].to_i %>
            </td>

            <td align="right" style="padding:8px 12px 8px 0;">
              <%= click_counts[:phone_click].to_i %>
            </td>

            <td align="right" style="padding:8px 12px 8px 0;">
              <%= click_counts[:map_click].to_i %>
            </td>

            <td align="right" style="padding:8px 12px 8px 0;">
              <%= click_counts[:affiliate_click].to_i %>
            </td>

            <td align="right" style="padding:8px 12px 8px 0;">
              <%= click_counts[:article_shop_click].to_i %>
            </td>

            <td align="right" style="padding:8px 12px 8px 0; color:#7a5a12; font-weight:700;">
              <%= click_counts[:article_flow_rate].to_f %>%
            </td>

            <td style="padding:8px 12px 8px 0; min-width:220px;">
              <% article_clicks = (@article_shop_clicks_by_shop_id || {})[shop.id] || [] %>

              <% if article_clicks.present? %>
                <% article_clicks.group_by(&:article).sort_by { |_article, clicks| -clicks.size }.first(3).each do |article, clicks| %>
                  <div style="font-size:12px; line-height:1.5; margin-bottom:4px;">
                    <% if article.present? %>
                      <%= link_to article.title,
                                  article_path(article),
                                  target: "_blank",
                                  rel: "noopener",
                                  style: "color:#111; font-weight:700;" %>
                    <% else %>
                      <span style="color:#777;">記事不明</span>
                    <% end %>
                    <span style="color:#777;">（<%= clicks.size %>件）</span>
                  </div>
                <% end %>
              <% else %>
                <span style="color:#999; font-size:12px;">なし</span>
              <% end %>
            </td>

            <td style="padding:8px 0;">
              <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
                <%= link_to "詳細",
                    admin_shop_path(shop, status: @status, source: @source, per: @per, page: @page),
                    style: "padding:6px 10px; border:1px solid #137333; background:#eef8f0; color:#137333; font-weight:700; border-radius:10px; text-decoration:none;" %>

                <%= link_to "編集",
                    edit_admin_shop_path(
                      shop,
                      from: "clicks",
                      status: @status,
                      source: @source,
                      per: @per,
                      page: @page,
                      q: @q,
                      sort: @sort
                    ),
                    style: "padding:6px 10px; border:1px solid #ddd; border-radius:10px; text-decoration:none;" %>

                <%= link_to "公開ページ",
                    shop_path(shop),
                    target: "_blank",
                    rel: "noopener",
                    style: "padding:6px 10px; border:1px solid #ddd; border-radius:10px; text-decoration:none;" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p>該当する店舗はありません。</p>
<% end %>