<%# /Users/kawamuratakuya/dev/suelog/app/views/admin/shops/new.html.erb %>

<h1>店舗登録（管理者用）</h1>

<p style="color:#666; line-height:1.6;">
  管理画面から直接店舗を登録できます。<br>
  <strong>店名・ジャンル・住所・最終確認日・喫煙ステータス</strong> は必須です。
</p>

<p style="color:#666;">
  <%= link_to "← 一覧に戻る", admin_shops_path(status: @status, source: @source, per: @per, page: @page) %>
</p>

<% req = '<span style="color:#b00020; font-weight:900; font-size:12px; margin-left:6px;">※必須</span>'.html_safe %>

<% if flash.now[:alert].present? %>
  <div style="border:1px solid #f5c2c7; background:#fdecea; padding:12px; border-radius:10px; margin:12px 0;">
    <p style="margin:0; font-weight:900; color:#b00020;"><%= flash.now[:alert] %></p>
  </div>
<% end %>

<% if @shop.errors.any? %>
  <div style="border:1px solid #f5c2c7; background:#f8d7da; padding:12px; border-radius:10px; margin:12px 0;">
    <div style="font-weight:800; margin-bottom:6px;">入力エラーがあります：</div>
    <ul style="margin:0; padding-left:18px;">
      <% @shop.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: [:admin, @shop], local: true, html: { novalidate: true, multipart: true } do |f| %>
  <%= hidden_field_tag :status, @status %>
  <%= hidden_field_tag :source, @source %>
  <%= hidden_field_tag :per, @per %>
  <%= hidden_field_tag :page, @page %>

  <div style="margin:12px 0;">
    <div style="font-weight:700;">店名 <%= req %></div>
    <%= f.text_field :name,
      required: true,
      style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
  </div>

  <div style="margin:12px 0;">
    <div style="font-weight:700;">ジャンル <%= req %></div>
    <%= f.select :genre,
      ["居酒屋", "バー / パブ", "喫茶店 / カフェ", "焼肉", "ラーメン", "中華", "和食", "洋食", "立ち飲み", "スナック", "その他"],
      { include_blank: "選択してください" },
      { required: true, style: "width:100%; max-width:420px; padding:10px; border:1px solid #ddd; border-radius:12px;" } %>
  </div>

  <div style="margin:12px 0;">
    <div style="font-weight:700;">その他（任意）</div>
    <%= f.text_field :genre_other,
      placeholder: "例：シーシャバー、ダーツバー",
      style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
  </div>

  <div style="margin:12px 0;">
    <div style="font-weight:700;">住所 <%= req %></div>
    <%= f.text_field :address,
      placeholder: "例：大阪市北区梅田1-1-1 / 〇〇店 梅田",
      required: true,
      style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
  </div>

  <hr>

  <h3>基本情報</h3>

  <div style="margin:12px 0;">
    <div style="font-weight:700;">最寄駅（任意）</div>
    <%= f.text_field :nearest_station,
      placeholder: "例：梅田駅 徒歩5分",
      style: "width:100%; max-width:420px; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
  </div>

  <div style="margin:12px 0;">
    <div style="font-weight:700;">エリア（管理者入力可）</div>
    <p style="margin:4px 0 8px; color:#666; font-size:12px; line-height:1.6;">
      空欄なら住所・最寄駅から自動判定されます。必要な場合だけ手動で指定してください。
    </p>
    <%= f.select :area,
      [["未設定", ""], ["梅田", "梅田"], ["難波", "難波"]],
      {},
      { style: "width:100%; max-width:420px; padding:10px; border:1px solid #ddd; border-radius:12px;" } %>
  </div>

  <div style="margin:12px 0; padding:14px; border:1px solid #eee; border-radius:12px; background:#fffdf8;">
    <div style="font-weight:800; font-size:16px; margin-bottom:8px;">営業時間</div>
    <p style="margin:0 0 10px; color:#666; font-size:13px; line-height:1.7;">
      曜日ごとの細かい入力はやめて、見たまま入れてください。<br>
      例）月-木 17:00-23:00 / 金土 17:00-02:00 / 日 15:00-22:00<br>
      例）11:30-14:00, 17:00-23:00 のように中休みもそのまま書けます。
    </p>

    <div style="margin-bottom:8px;">
      <div style="font-weight:700; margin-bottom:6px;">定型文</div>
      <div style="display:flex; gap:8px; flex-wrap:wrap;">
        <button type="button" class="hours-preset-btn" data-target="shop_opening_hours_text" data-value="毎日 17:00-23:00" style="padding:6px 10px; border:1px solid #ddd; background:#fff; border-radius:999px; cursor:pointer;">毎日 夜営業</button>
        <button type="button" class="hours-preset-btn" data-target="shop_opening_hours_text" data-value="月-金 11:30-14:00, 17:00-23:00 / 土日 12:00-23:00" style="padding:6px 10px; border:1px solid #ddd; background:#fff; border-radius:999px; cursor:pointer;">ランチ＋ディナー</button>
        <button type="button" class="hours-preset-btn" data-target="shop_opening_hours_text" data-value="火-日 18:00-24:00" style="padding:6px 10px; border:1px solid #ddd; background:#fff; border-radius:999px; cursor:pointer;">夜のみ</button>
        <button type="button" class="hours-preset-btn" data-target="shop_holiday_hours_text" data-value="通常営業と同じ" style="padding:6px 10px; border:1px solid #ddd; background:#fff; border-radius:999px; cursor:pointer;">祝日=通常営業</button>
        <button type="button" class="hours-preset-btn" data-target="shop_holiday_hours_text" data-value="休業" style="padding:6px 10px; border:1px solid #ddd; background:#fff; border-radius:999px; cursor:pointer;">祝日休業</button>
        <button type="button" class="hours-preset-btn" data-target="shop_closed_days_text" data-value="なし" style="padding:6px 10px; border:1px solid #ddd; background:#fff; border-radius:999px; cursor:pointer;">定休日なし</button>
        <button type="button" class="hours-preset-btn" data-target="shop_closed_days_text" data-value="不定休" style="padding:6px 10px; border:1px solid #ddd; background:#fff; border-radius:999px; cursor:pointer;">不定休</button>
        <button type="button" class="hours-preset-btn" data-target="shop_closed_days_text" data-value="月曜" style="padding:6px 10px; border:1px solid #ddd; background:#fff; border-radius:999px; cursor:pointer;">月曜休み</button>
        <button type="button" class="hours-preset-btn" data-target="shop_closed_days_text" data-value="水曜" style="padding:6px 10px; border:1px solid #ddd; background:#fff; border-radius:999px; cursor:pointer;">水曜休み</button>
      </div>
    </div>

    <div style="margin-bottom:10px;">
      <div style="font-weight:700; margin-bottom:4px;">通常営業時間</div>
      <%= f.text_area :opening_hours_text,
        rows: 3,
        placeholder: "例）月-金 11:30-14:00, 17:00-23:00 / 土日 12:00-23:00",
        id: "shop_opening_hours_text",
        style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
    </div>

    <div style="margin-bottom:10px;">
      <div style="font-weight:700; margin-bottom:4px;">祝日営業時間</div>
      <%= f.text_area :holiday_hours_text,
        rows: 2,
        placeholder: "例）12:00-23:00 / 通常営業と同じ / 休業",
        id: "shop_holiday_hours_text",
        style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
    </div>

    <div>
      <div style="font-weight:700; margin-bottom:4px;">定休日</div>
      <%= f.text_field :closed_days_text,
        placeholder: "例）水曜 / 不定休 / なし",
        id: "shop_closed_days_text",
        style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
    </div>

    <% if @shop.opening_hours_json.present? %>
      <p style="margin:10px 0 0; color:#8a6d3b; font-size:12px;">
        ※ 以前の曜日別データはDBに残っていますが、今後の編集はこの簡易入力を優先します。
      </p>
    <% end %>
  </div>

  <div style="margin:12px 0;">
    <div style="font-weight:700;">電話番号（任意）</div>
    <%= f.telephone_field :phone,
      placeholder: "例：06-1234-5678",
      style: "width:100%; max-width:420px; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
  </div>

  <div style="margin:12px 0;">
    <div style="font-weight:700;">最終確認日 <%= req %></div>
    <%= f.date_field :last_confirmed_on,
      max: Date.current,
      required: true,
      style: "padding:10px; border:1px solid #ddd; border-radius:12px;" %>
  </div>

  <div style="margin:12px 0;">
    <div style="font-weight:700;">店舗詳細</div>
    <%= f.text_area :public_store_details,
      rows: 5,
      placeholder: "例：席で吸える / 21時以降だけOK / カウンター席あり / 1人でも入りやすい など",
      style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
  </div>

  <div style="margin:12px 0;">
    <div style="font-weight:700;">食べログURL（任意）</div>
    <%= f.url_field :tabelog_url,
      placeholder: "https://tabelog.com/...",
      style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
  </div>

  <div style="margin:12px 0;">
    <div style="font-weight:700;">ホットペッパーURL（任意）</div>
    <%= f.url_field :hotpepper_url,
      placeholder: "https://www.hotpepper.jp/...",
      style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
  </div>

  <div style="margin:12px 0;">
    <div style="font-weight:700;">管理メモ（管理者のみ表示）</div>
    <p style="margin:4px 0 8px; color:#666; font-size:13px; line-height:1.7;">
      内部確認用のメモです。一般ユーザーには表示しません。
    </p>
    <%= f.text_area :note,
      rows: 6,
      style: "width:100%; padding:10px; border:1px solid #ddd; border-radius:12px;" %>
  </div>

  <hr>

  <h3>喫煙ステータス</h3>
  <p style="color:#666; font-size:12px; line-height:1.6;">
    ※ 喫煙エリア / 喫煙タイプは必須です
  </p>

  <div style="margin:12px 0;">
    <div style="font-weight:700;">喫煙エリア <%= req %></div>
    <%= f.select :smoking_area,
      [["選択してください", ""], ["喫煙所あり", "separated"], ["席で喫煙可", "all_smoking"], ["不明", "unknown"]],
      {},
      { required: true, style: "width:100%; max-width:420px; padding:10px; border:1px solid #ddd; border-radius:12px;" } %>
  </div>

  <div style="margin:12px 0;">
    <div style="font-weight:700;">喫煙タイプ <%= req %></div>
    <%= f.select :smoking_type,
      [["選択してください", ""], ["紙・加熱式どちらもOK", "both_ok"], ["加熱式タバコのみOK", "electronic_only"], ["紙タバコのみOK", "paper_only"], ["不明", "unknown"]],
      {},
      { required: true, style: "width:100%; max-width:420px; padding:10px; border:1px solid #ddd; border-radius:12px;" } %>
  </div>

  <div style="margin:12px 0; padding:14px; border:1px solid #eee; border-radius:12px; background:#f9fafb;">
    <div style="font-weight:800; font-size:16px; margin-bottom:8px;">喫煙情報ステータス</div>

    <label style="display:flex; align-items:center; gap:8px; font-weight:700; cursor:pointer;">
      <%= f.check_box :smoking_unverified %>
      <span>喫煙情報未確認として扱う</span>
    </label>

    <p style="margin:8px 0 0; color:#666; font-size:13px; line-height:1.7;">
      オンにすると、表側で「未確認」バッジを表示する前提のデータとして扱えます。<br>
      電話確認や現地確認が終わったらオフに戻してください。
    </p>
  </div>

  <hr>

  <h3>写真（任意）</h3>
  <p style="color:#666; font-size:12px; line-height:1.6;">
    ※ 写真は未登録でもOKです（あとから追加できます）
  </p>

  <div style="margin:12px 0;">
    <div style="font-weight:700;">料理の写真（複数OK）</div>
    <%= f.file_field :food_photos, multiple: true, accept: "image/*", class: "shop-photo-input" %>
  </div>

  <div style="margin:12px 0;">
    <div style="font-weight:700;">内観の写真（複数OK）</div>
    <%= f.file_field :interior_photos, multiple: true, accept: "image/*", class: "shop-photo-input" %>
  </div>

  <div style="margin:12px 0;">
    <div style="font-weight:700;">外観の写真（複数OK）</div>
    <%= f.file_field :exterior_photos, multiple: true, accept: "image/*", class: "shop-photo-input" %>
  </div>

  <div style="margin:12px 0;">
    <div style="font-weight:700;">メニューの写真（複数OK）</div>
    <%= f.file_field :menu_photos, multiple: true, accept: "image/*", class: "shop-photo-input" %>
  </div>

  <div style="margin-top:18px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
    <%= f.submit "登録する",
      name: "commit_action",
      value: "create",
      style: "padding:10px 14px; border:1px solid #111; border-radius:12px; background:#111; color:#fff; font-weight:700;" %>

    <%= f.submit "登録して承認",
      name: "commit_action",
      value: "approve",
      style: "padding:10px 14px; border:1px solid #137333; border-radius:12px; background:#e6f4ea; color:#137333; font-weight:700;" %>

    <%= f.submit "登録して保留",
      name: "commit_action",
      value: "hold",
      style: "padding:10px 14px; border:1px solid #9a6700; border-radius:12px; background:#fff8e1; color:#9a6700; font-weight:700;" %>

    <%= f.submit "登録して却下",
      name: "commit_action",
      value: "reject",
      style: "padding:10px 14px; border:1px solid #b00020; border-radius:12px; background:#fdecea; color:#b00020; font-weight:700;" %>

    <%= link_to "キャンセル",
      admin_shops_path(status: @status, source: @source, per: @per, page: @page),
      style: "padding:10px 14px; border:1px solid #ddd; border-radius:12px; text-decoration:none;" %>
  </div>
<% end %>

<script>
(function() {
  function bindHoursPresetButtons() {
    document.querySelectorAll(".hours-preset-btn").forEach(function(button) {
      if (button.dataset.bound === "1") return;
      button.dataset.bound = "1";

      button.addEventListener("click", function(event) {
        event.preventDefault();

        var targetId = button.dataset.target;
        var value = button.dataset.value;
        var target = document.getElementById(targetId);

        if (!target) return;

        target.value = value;
        target.dispatchEvent(new Event("input", { bubbles: true }));
        target.dispatchEvent(new Event("change", { bubbles: true }));
      });
    });
  }

  document.addEventListener("DOMContentLoaded", bindHoursPresetButtons);
  document.addEventListener("turbo:load", bindHoursPresetButtons);
})();
</script>