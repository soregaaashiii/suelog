<p>最新版の店舗一覧CSVを読み込みます（CP932・25MB以下）。読み込みだけでは店舗URLを更新しません。</p>
<%= form_with url: admin_gurunavi_csv_batches_path, multipart: true, local: true, data: { turbo: false } do %>
  <p><%= file_field_tag :file, accept: ".csv", required: true %>（25MB・最大10万行）</p>
  <p><label>対象の市区町村（前方一致、空欄で全エリア）：<%= text_field_tag :area_filter, "", placeholder: "例：大阪市北区" %></label></p>
  <p><label><%= check_box_tag :trial_mode, "1", false %> 試行モード：吸えログの公開中店舗をエリア内で先頭100店舗まで照合する</label></p>
  <%= submit_tag "アップロードして照合する", style: "padding:10px 16px;" %>
<% end %>
