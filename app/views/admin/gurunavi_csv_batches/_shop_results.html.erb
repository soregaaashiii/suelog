<h1>吸えログ店舗からぐるなびCSVを照合 #<%= @batch.id %></h1>
<p><%= link_to "ぐるなび設定に戻る", admin_gurunavi_csv_batches_path %> ｜ <%= link_to "新しいCSVを読み込む", admin_gurunavi_csv_batches_path %> ｜ <%= link_to "進捗・結果を更新", admin_gurunavi_csv_batch_path(@batch, classification: @classification, state: @state, q: @q, page: @page) %></p>
<p><strong><%= @batch.state %> / <%= @batch.phase %></strong>：<%= @batch.message %><br>
参照CSV：<%= @batch.filename %>・全<%= @batch.total_rows %>行 ／ <strong>対象：吸えログ <%= @batch.target_rows %>店舗</strong> ／ <%= @batch.phase == "parse" ? "CSV読込済み #{@batch.processed_rows}行" : "照合済み #{@batch.processed_rows}店舗" %><br>
<%= @batch.trial_mode? ? "試行：吸えログ側の先頭100店舗まで" : "全件：吸えログ側の対象店舗すべて" %> ／ エリア：<%= @batch.area_filter.presence || "全エリア" %></p>
<div data-csv-confidence-summary style="padding:10px;border:1px solid #ddd;background:#fff;margin:10px 0;">
  <strong>候補：全体 <%= number_with_delimiter(@candidate_confidence_counts.values.sum) %>店舗 ／ 未登録 <span data-csv-confidence-remaining-total><%= number_with_delimiter(@remaining_confidence_counts.values.sum) %></span>店舗</strong>
  <table style="margin-top:8px;border-collapse:collapse;" cellpadding="5">
    <thead><tr><th style="text-align:left;">確度</th><th>候補全体</th><th>未登録</th></tr></thead>
    <tbody>
      <% [400, 300, 200, 100, 50, 0].each do |score| %>
        <% next if score.zero? && @candidate_confidence_counts[score].to_i.zero? %>
        <tr><td><%= score.zero? ? "未評価" : GurunaviCsv::Confidence.label(score) %></td><td><%= number_with_delimiter(@candidate_confidence_counts[score].to_i) %>店舗</td><td><span data-csv-confidence-remaining="<%= score %>"><%= number_with_delimiter(@remaining_confidence_counts[score].to_i) %></span>店舗</td></tr>
      <% end %>
    </tbody>
  </table>
  <small>店舗単位で集計。複数候補は最も高い確度で1店舗と数えます。候補全体には登録・除外・保留・競合済みも含みます。</small>
</div>
<p>対象は吸えログの公開中店舗（承認済み・保留ではない店舗）です。各店舗について<strong>CSV全体</strong>からぐるなび候補を探します。CSVにしか存在しない店舗は通常一覧と判定件数に含めません。</p>
<p><strong>一覧を表示しただけではURLを更新しません。</strong>候補の「登録する」で確認と登録が完了し、間違えた場合は「取り消す」で戻せます。「CSV内に候補なし」は、このCSVから候補が見つからなかった意味です。ぐるなび未掲載とは断定しません。</p>
<%= render "admin/affiliate_registration/tabs", prefix: "gurunavi_csv", target_class: GurunaviCsvTarget %>
<p>登録済みの店舗は作業一覧から外れ、「登録済み」に移ります。取り消すと未登録へ戻ります。</p>
<% if @batch.state == "ready" && (@batch.trial_mode? || @batch.area_filter.present?) %>
  <%= button_to "100店舗・エリア制限を外して全店舗を照合", refresh_candidates_admin_gurunavi_csv_batch_path(@batch), params: { all_shops: "1" }, method: :post, form: { data: { turbo: false } } %>
<% end %>
<%= button_to "候補を追加照合・確度順に更新", refresh_candidates_admin_gurunavi_csv_batch_path(@batch), method: :post, form: { data: { turbo: false } } if @batch.state == "ready" %>
<p><span style="color:#b42318;border-bottom:2px solid #b42318;">赤い下線</span>は双方の表記が異なる部分です。一致箇所や同じ店舗であることを示す印ではありません。</p>
<p><%= @classification == "excluded" ? "表示順：最近除外した店舗が上です。" : @classification == "registered" ? "表示順：最近登録した店舗が上です。" : "表示順：候補あり → 照合の確度が高い順 → 同じ確度ではアクセス数の多い順です。" %></p>
<p>参照CSVの検証：<%= link_to "不正・欠損行（#{@invalid_count}行）", admin_gurunavi_csv_batch_path(@batch, classification: "invalid") %>（店舗の判定件数とは別集計）</p>
<%= form_with url: admin_gurunavi_csv_batch_path(@batch), method: :get, local: true do %>
  <%= hidden_field_tag :classification, @classification %>
  <%= text_field_tag :q, @q, placeholder: "吸えログ・候補CSVの店名や住所", aria: { label: "店舗名・住所を検索" } %>
  <%= submit_tag "検索" %>
  <% if @q.present? %><%= link_to "検索をクリア", admin_gurunavi_csv_batch_path(@batch, classification: @classification.presence) %><% end %>
<% end %>
<% if @batch.state == "ready" %>
  <details style="margin:14px 0; padding:12px; border:1px solid #137333; border-radius:8px;">
    <summary data-csv-registration-ready>まとめて登録する（登録可能 <%= @ready_count %>店舗）</summary>
    <p>登録可能：<strong><%= @ready_count %>店舗</strong>。一括登録候補と、同一店舗と確定した候補が対象です。</p>
    <%= form_with url: apply_admin_gurunavi_csv_batch_path(@batch), id: "bulk-apply", local: true, data: { turbo: false } do %>
      <label><%= check_box_tag :reviewed, "1", false, required: true %> 店舗名・住所・URLと判定理由を確認しました</label><br>
      <%= button_tag "選択した候補を登録する", name: "mode", value: "selected" %>
      <%= button_tag "この取り込みの登録可能候補をすべて登録する", name: "mode", value: "all_ready" %>
    <% end %>
  </details>
  <details style="margin:14px 0; padding:12px; border:1px solid #b00020;">
    <summary>今回の登録を取り消す</summary>
    <p>今回変更したURL項目だけを戻します。登録後に別の更新があれば競合として停止します。</p>
    <%= form_with url: rollback_admin_gurunavi_csv_batch_path(@batch), id: "bulk-rollback", local: true, data: { turbo: false } do %>
      <label><%= check_box_tag :reviewed, "1", false, required: true %> 取り消す対象を確認しました</label><br>
      <%= button_tag "選択した登録を取り消す", name: "mode", value: "selected" %>
      <%= button_tag "今回更新した登録をすべて取り消す", name: "mode", value: "all_applied" %>
    <% end %>
  </details>
<% end %>
<p data-csv-registration-pagination><%= @total %><%= @classification == "invalid" ? "行" : "店舗" %> ／ <%= @page %> / <%= @pages %>ページ（50<%= @classification == "invalid" ? "行" : "店舗" %>ずつ）</p>
<% if @page > 1 %><%= link_to "← 前へ", admin_gurunavi_csv_batch_path(@batch, classification: @classification, state: @state, q: @q, page: @page - 1) %><% end %>
<% if @page < @pages %><%= link_to "次へ →", admin_gurunavi_csv_batch_path(@batch, classification: @classification, state: @state, q: @q, page: @page + 1) %><% end %>
<% if @classification == "invalid" %>
  <h2>CSVの不正・欠損行</h2>
  <% @invalid_rows.each do |row| %>
    <div style="border:1px solid #ccc; padding:12px; margin:12px 0;"><strong>CSV行 <%= row.line_number %></strong><p><%= row.reason %></p><details><summary>元行を見る</summary><pre style="white-space:pre-wrap;"><%= row.raw_row %></pre></details></div>
  <% end %>
<% else %>
  <%= render "admin/affiliate_registration/cards", prefix: "gurunavi_csv", registration_namespace: GurunaviCsv, target_class: GurunaviCsvTarget, match_class: GurunaviCsvMatch, provider: "gurunavi", provider_label: "ぐるなび", source_label: "CSV行", source_minimum: 2 %>
<% end %>
<details><summary>処理履歴・監査ログ</summary><%= render "execution_history" %></details>
