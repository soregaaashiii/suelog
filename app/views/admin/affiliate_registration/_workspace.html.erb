  <div data-controller="csv-registration" data-registration-spec="shared" data-snapshot-validation="registration-fields" data-csv-registration-group="<%= %w[registered excluded held].include?(@classification) ? @classification : @classification == 'url_conflict' ? 'conflict' : 'unregistered' %>" data-action="submit->csv-registration#submit change->csv-registration#refreshShortcut keydown@window->csv-registration#registerFirst keyup@window->csv-registration#stopHeldEnter blur@window->csv-registration#stopHeldEnter visibilitychange@document->csv-registration#stopHeldEnter focusin@window->csv-registration#stopOnEditing">
    <div data-csv-registration-status role="status" aria-live="polite" style="position:fixed;bottom:16px;right:16px;z-index:1000;background:white;padding:12px;border:1px solid #aaa;" hidden></div>
    <% unless %w[registered excluded held invalid url_conflict].include?(@classification) %>
      <div style="position:sticky;top:8px;z-index:900;background:white;border:1px solid #aaa;padding:10px;" data-csv-shortcut>
        <button type="button" data-csv-shortcut-button data-action="click->csv-registration#registerFirst">Enterで先頭を登録・長押しで連続登録</button>
        <span data-csv-shortcut-name></span>
        <small>（入力中は無効・複数候補は先頭・既存URLは置き換え登録）</small>
      </div>
    <% end %>
    <%= yield %>
  </div>
