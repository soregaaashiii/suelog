<h1>食べログ貼り付けインポート</h1>

<% if flash[:admin_notice].present? %>
  <div style="padding:12px; border:1px solid #d8e7d7; background:#eef7ee; border-radius:12px; margin:10px 0; color:#2f6b3b;">
    <%= flash[:admin_notice] %>
  </div>
<% end %>

<% if flash[:admin_alert].present? %>
  <div style="padding:12px; border:1px solid #f5c2c7; background:#fff5f5; border-radius:12px; margin:10px 0; color:#b00020;">
    <%= flash[:admin_alert] %>
  </div>
<% end %>

<p style="color:#666; line-height:1.7;">
  食べログ店舗詳細ページのテキストをそのまま貼り付けると、店舗情報を自動整形して仮登録します。<br>
  登録後は編集画面で内容を確認してから承認してください。
</p>

<%= form_with url: preview_admin_shop_import_path, method: :post, local: true, data: { turbo: false } do %>
  <div>
    <label style="font-weight:700;">貼り付け本文</label><br>
    <%= text_area_tag :raw_text,
                      @raw_text,
                      rows: 18,
                      style: "width:100%; max-width:900px;",
                      placeholder: "食べログの店舗詳細テキストを貼り付け" %>
  </div>

  <div style="margin-top:10px;">
    <%= submit_tag "解析する", class: "nav-btn" %>
  </div>
<% end %>

<% if @parsed_attrs.present? %>
  <hr>

  <h2>解析結果</h2>

  <table style="border-collapse:collapse; width:100%; max-width:900px;">
    <% {
      "店名" => @parsed_attrs[:name],
      "住所" => @parsed_attrs[:address],
      "電話番号" => @parsed_attrs[:phone],
      "ジャンル" => @parsed_attrs[:genre],
      "ジャンルその他" => @parsed_attrs[:genre_other],
      "営業時間" => @parsed_attrs[:opening_hours_text],
      "定休日" => @parsed_attrs[:closed_days_text],
      "平均予算" => @parsed_attrs[:budget_range],
      "LO" => @parsed_attrs[:last_order_text],
      "個室" => @parsed_attrs[:private_room_type],
      "席タイプ" => Array(@parsed_attrs[:seat_type_tags]).join(" / "),
      "飲み放題" => @parsed_attrs[:all_you_can_drink_type],
      "喫煙エリア" => @parsed_attrs[:smoking_area],
      "喫煙タイプ" => @parsed_attrs[:smoking_type]
    }.each do |label, value| %>
      <tr>
        <th style="border:1px solid #ddd; background:#f8f8f8; padding:8px; width:160px; text-align:left;"><%= label %></th>
        <td style="border:1px solid #ddd; padding:8px; white-space:pre-wrap;"><%= value.presence || "未取得" %></td>
      </tr>
    <% end %>
  </table>

  <% if @duplicate_candidates.present? %>
    <div style="margin-top:16px; padding:12px; border:1px solid #f0de9c; background:#fffaf0; border-radius:12px;">
      <h3 style="margin-top:0;">重複候補があります</h3>
      <ul>
        <% @duplicate_candidates.each do |shop| %>
          <li>
            <%= link_to shop.name, edit_admin_shop_path(shop), target: "_blank", rel: "noopener" %>
            / <%= shop.address %>
            / <%= shop.phone %>
          </li>
        <% end %>
      </ul>
      <p style="margin-bottom:0; color:#8a6500;">
        同じ店舗の可能性がある場合は、新規登録せず既存店舗を編集してください。
      </p>
    </div>
  <% end %>

<%= form_with url: admin_shop_import_path, method: :post, local: true, data: { turbo: false } do %>
    <%= hidden_field_tag :raw_text, @raw_text %>

    <div style="margin-top:14px;">
      <%= submit_tag "この内容で仮登録する", class: "nav-btn", data: { confirm: "重複候補を確認しましたか？この内容で仮登録します。" } %>
    </div>
  <% end %>
<% end %>

<div style="margin-top:20px; display:flex; gap:10px; flex-wrap:wrap;">
  <%= link_to "店舗一覧に戻る", admin_shops_path, class: "nav-btn" %>
  <%= link_to "通常の店舗登録へ", new_admin_shop_path, class: "nav-btn" %>
</div>