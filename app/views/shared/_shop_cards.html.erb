<%# /Users/kawamuratakuya/dev/suelog/app/views/shared/_shop_cards.html.erb %>

<% shops ||= [] %>

<% if shops.present? %>
  <div class="shop-grid">
    <% shops.each do |shop| %>
      <% confirmed = shop.last_confirmed_on %>
      <% very_old = confirmed.present? && confirmed < 2.years.ago.to_date %>
      <% thumb = nil %>
      <% thumb_variant = nil %>
      <% area_text = [shop.address, shop.nearest_station, shop.name].compact.join(" ") %>
      <% is_umeda_shop = area_text.include?("梅田") %>
      <% is_namba_shop = area_text.include?("難波") || area_text.include?("なんば") %>

      <% card_avg_rating =
           if shop.respond_to?(:avg_rating) && shop.avg_rating.present?
             shop.avg_rating.to_f
           else
             nil
           end %>

      <% card_reviews_count =
           if shop.respond_to?(:reviews_count) && shop.reviews_count.present?
             shop.reviews_count.to_i
           else
             0
           end %>

      <% card_star_count =
           if card_avg_rating.present?
             rounded = card_avg_rating.round
             rounded = 0 if rounded < 0
             rounded = 5 if rounded > 5
             rounded
           else
             0
           end %>

      <% if shop.respond_to?(:thumbnail_attachment) %>
        <% begin %>
          <% candidate = shop.thumbnail_attachment %>
          <% if candidate.present? %>
            <% thumb = candidate %>
            <% if thumb.variable? %>
              <% thumb_variant = thumb.variant(resize_to_limit: [480, 320]) %>
            <% end %>
          <% end %>
        <% rescue StandardError %>
          <% thumb = nil %>
          <% thumb_variant = nil %>
        <% end %>
      <% end %>

      <%
      fallback_map = {
        "居酒屋" => "yakitori.jpg",
        "バー・パブ" => "bar.jpg",
        "ラウンジ" => "lounge.jpg",
        "スナック" => "snack.jpg",
        "カフェ" => "cafe.jpg",
        "喫茶店" => "cafe.jpg",
        "焼肉" => "yakiniku.jpg",
        "バーベキュー" => "yakiniku.jpg",
        "寿司" => "sushi.jpg",
        "和食" => "washoku.jpg",
        "海鮮" => "sushi.jpg",
        "中華" => "chinese.jpg",
        "韓国料理" => "korean.jpg",
        "エスニック" => "ethnic.jpg",
        "洋食" => "western.jpg",
        "レストラン" => "western.jpg",
        "フレンチ" => "french.jpg",
        "イタリアン" => "italian.jpg",
        "アメリカ料理" => "american.jpg",
        "ステーキ" => "steak.jpg",
        "ラーメン" => "ramen.jpg",
        "串カツ" => "kushikatsu.jpg",
        "たこ焼き" => "takoyaki.jpg",
        "お好み焼き" => "okonomiyaki.jpg",
        "天ぷら" => "tempura.jpg"
      }
      %>

      <% fallback_image = fallback_map[shop.display_genre] || "other.jpg" %>

      <% card_photos = [] %>
      <% card_photos << thumb if thumb.present? %>
      <% [:food_photos, :interior_photos, :exterior_photos, :menu_photos].each do |photo_field| %>
        <% next unless shop.respond_to?(photo_field) %>
        <% shop.public_send(photo_field).each do |photo| %>
          <% next if thumb.present? && photo.id == thumb.id %>
          <% card_photos << photo %>
        <% end %>
      <% end %>
      <% card_photos = card_photos.compact.uniq { |photo| photo.id } %>

      <article
        class="shop-card <%= "shop-card--stale" if very_old %> shop-card--clickable"
        onclick="if (!event.target.closest('a, button')) { window.location.href='<%= shop_path(shop) %>'; }"
        role="link"
        tabindex="0"
        onkeydown="if ((event.key === 'Enter' || event.key === ' ') && !event.target.closest('a, button')) { event.preventDefault(); window.location.href='<%= shop_path(shop) %>'; }">
        <%= link_to shop_path(shop), class: "shop-card__mediaLink" do %>
          <div class="shop-card__media">

            <% if card_photos.present? %>
              <div style="display:flex; overflow-x:auto; scroll-snap-type:x mandatory; width:100%; height:100%; -webkit-overflow-scrolling:touch;">
                <% card_photos.each do |photo| %>
                  <div style="flex:0 0 100%; width:100%; height:100%; scroll-snap-align:start;">
                    <% begin %>
                      <% photo_variant = photo.variable? ? photo.variant(resize_to_limit: [480, 320]) : photo %>
                      <%= image_tag(photo_variant,
                            class: "shop-card__img",
                            alt: shop.name,
                            loading: "lazy",
                            decoding: "async") %>
                    <% rescue StandardError %>
                      <%= image_tag "fallbacks/#{fallback_image}",
                            class: "shop-card__img",
                            alt: shop.name,
                            loading: "lazy",
                            decoding: "async" %>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% else %>
              <%= image_tag "fallbacks/#{fallback_image}",
                    class: "shop-card__img",
                    alt: shop.name,
                    loading: "lazy",
                    decoding: "async" %>
            <% end %>

           <% unless card_photos.present? %>
  <!-- ▼画像が無いときだけ表示 -->
  <div class="shop-card__overlay">

    <!-- ▼これを追加 -->
    <div class="shop-card__imageNote">※画像はイメージです</div>

    <div class="shop-card__overlayTitle"><%= shop.name %></div>
    <div class="shop-card__overlaySub">
      このお店の最新情報・写真を募集中！
    </div>
  </div>
<% end %>

          </div>
        <% end %>

        <div class="shop-card__body">
          <div class="shop-card__meta">
            <span class="shop-card__genre">
              <%= shop.display_genre.presence || "未設定" %>
            </span>

            <% if confirmed.present? %>
              <span class="shop-card__confirmed">
                最終確認：<%= confirmed.strftime("%Y.%m.%d") %>
              </span>
            <% end %>
          </div>

          <h3 class="shop-card__title">
            <%= link_to shop.name, shop_path(shop), class: "shop-card__titleLink text-outline" %>

            <% shop_open_now = defined?(open_now_map) && open_now_map.present? ? open_now_map[shop.id] : shop.open_now? %>

            <% if shop_open_now %>
              <span class="badge badge--open-inline">営業中</span>
            <% else %>
              <span class="badge badge--closed-inline">営業終了</span>
            <% end %>
          </h3>

          <% if card_avg_rating.present? && card_reviews_count.positive? %>
            <div class="shop-card__rating">
              <span class="shop-card__ratingStars">
                <%= "★" * card_star_count %><%= "☆" * (5 - card_star_count) %>
              </span>
              <span class="shop-card__ratingValue"><%= card_avg_rating.round(1) %></span>
              <span class="shop-card__ratingCount">（<%= card_reviews_count %>件）</span>
            </div>
          <% else %>
            <div class="shop-card__rating shop-card__rating--empty">
              まだ評価なし
            </div>
          <% end %>

          <p class="shop-card__address">
            <%= shop.nearest_station.presence || "最寄駅未設定" %>
          </p>

          <div class="shop-card__badges">
            <% if shop.smoking_area == "all_smoking" %>
              <span class="badge badge--dark">席で喫煙可</span>
            <% elsif shop.smoking_area == "separated" %>
              <span class="badge badge--line">喫煙所あり</span>
            <% elsif shop.smoking_area == "unknown" %>
              <span class="badge badge--type-unknown">喫煙エリア不明</span>
            <% end %>

            <% if shop.smoking_type == "both_ok" %>
              <span class="badge badge--type-both">紙・加熱式OK</span>
            <% elsif shop.smoking_type == "paper_only" %>
              <span class="badge badge--type-paper">紙のみ</span>
            <% elsif shop.smoking_type == "electronic_only" %>
              <span class="badge badge--type-electronic">加熱式のみ</span>
            <% elsif shop.smoking_type == "unknown" %>
              <span class="badge badge--type-unknown">喫煙タイプ不明</span>
            <% end %>

            <% if shop.respond_to?(:smoking_unverified?) && shop.smoking_unverified? %>
              <span class="badge badge--unverified">喫煙情報未確認</span>
            <% elsif confirmed.present? %>
              <span class="badge badge--confirmed">喫煙情報確認済</span>
            <% end %>

            <% if very_old %>
              <span class="badge badge--muted">確認日が古い可能性</span>
            <% end %>
          </div>

          <% if is_umeda_shop || is_namba_shop %>
            <div class="shop-card__areaLinks">
              <% if is_umeda_shop %>
                <%= link_to "梅田の一覧へ", umeda_path, class: "shop-card__areaLink" %>
              <% end %>

              <% if is_namba_shop %>
                <%= link_to "難波の一覧へ", namba_path, class: "shop-card__areaLink" %>
              <% end %>
            </div>
          <% end %>
        </div>
      </article>
    <% end %>
  </div>

<% else %>
  <div class="empty-state">
    <p>該当する店舗がありません。</p>
  </div>
<% end %>