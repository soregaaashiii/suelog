<%# /Users/kawamuratakuya/dev/suelog/app/views/shared/_hero.html.erb %>

<%
raw_hero_query = request.query_parameters.to_h.deep_dup.except("page", "commit")

hero_query = raw_hero_query.each_with_object({}) do |(key, value), hash|
  next if value.blank?
  hash[key] = value
end
%>

<% smoking_area_label = {
  "separated" => "喫煙所あり",
  "all_smoking" => "席で喫煙可",
  "smoking_allowed" => "席で喫煙可"
} %>

<% smoking_type_label = {
  "both_ok" => "紙・加熱式OK",
  "electronic_only" => "加熱式のみ",
  "paper_only" => "紙のみ"
} %>

<% genre_label = {} %>
<% Shop.genre_options.each { |g| genre_label[g] = g } %>
<% genre_label["izakaya"] = "居酒屋" %>
<% genre_label["bar"] = "バー・パブ" %>
<% genre_label["cafe"] = "カフェ" %>
<% genre_label["yakiniku"] = "焼肉" %>

<% genre_select_options = [["指定なし", ""]] %>
<% canonical_genres = [
  ["居酒屋", "izakaya"],
  ["バー・パブ", "bar"],
  ["カフェ", "cafe"],
  ["焼肉", "yakiniku"]
] %>
<% genre_select_options.concat(canonical_genres) %>

<% Shop.genre_options.each do |g| %>
  <% next if %w[izakaya bar cafe yakiniku].include?(g.to_s) %>
  <% label = genre_label[g] || g %>
  <% next if genre_select_options.any? { |existing_label, existing_value| existing_label == label || existing_value == g } %>
  <% genre_select_options << [label, g] %>
<% end %>

<% current_genre_value =
  if params[:genre].present?
    params[:genre]
  elsif @forced_genre_slug.present?
    @forced_genre_slug
  end %>

<% current_smoking_area_value =
  if request.path_parameters[:smoking_area].present?
    request.path_parameters[:smoking_area]
  else
    params[:smoking_area]
  end %>

<% current_station_value =
  if @forced_station_label.present?
    @forced_station_label
  elsif params[:station].present?
    params[:station]
  end %>

<% hero_chips = [] %>

<% if @forced_area_label.present? %>
  <% hero_chips << ["エリア：#{@forced_area_label}", :forced_area] %>
<% end %>

<% if current_smoking_area_value.present? %>
  <% label = smoking_area_label[current_smoking_area_value] || current_smoking_area_value %>
  <% hero_chips << ["喫煙エリア：#{label}", :smoking_area] %>
<% end %>

<% if params[:smoking_type].present? %>
  <% label = smoking_type_label[params[:smoking_type]] || params[:smoking_type] %>
  <% hero_chips << ["喫煙タイプ：#{label}", :smoking_type] %>
<% end %>

<% if current_station_value.present? %>
  <% hero_chips << ["最寄駅：#{current_station_value}", :station] %>
<% end %>

<% genre_chip_label =
  if params[:genre].present?
    genre_label[params[:genre]] || params[:genre]
  elsif @forced_genre_label.present?
    @forced_genre_label
  end %>

<% if genre_chip_label.present? %>
  <% hero_chips << ["ジャンル：#{genre_chip_label}", :genre] %>
<% end %>

<% hero_chips << ["キーワード：#{params[:q]}", :q] if params[:q].present? %>

<section class="hero hero--fullbleed">
  <div class="hero__inner">
    <div class="hero__content hero__content--single">
      <div class="hero__topline">
        <div class="hero__eyebrow">SMOKING MAP OSAKA</div>
      </div>

      <h1 class="hero-title">今、吸える店。</h1>
      <p class="hero-sub">大阪で喫煙可能な飲食店をすぐ検索</p>

      <div class="hero__search">
        <%= form_with url: (@search_form_url || root_path), method: :get, local: true, class: "search-form" do %>
          <%= hidden_field_tag :per, (@per.presence || 30) %>
          <%# ホームでは area を持たせない（404防止） %>
<% unless request.path == root_path %>
  <%= hidden_field_tag :area, @current_area_key if @current_area_key.present? && !@forced_area_label.present? %>
<% end %>

          <div class="search-grid">
            <div class="search-field">
              <%= label_tag :smoking_area, "喫煙エリア" %>

              <% if request.path_parameters[:smoking_area].present? %>
                <div class="search-input" style="display:flex; align-items:center; color:#111; background:#f7f4ea;">
                  <%= smoking_area_label[current_smoking_area_value] || current_smoking_area_value %>
                </div>
              <% else %>
                <%= select_tag :smoking_area,
                    options_for_select([
                      ["指定なし", ""],
                      ["喫煙所あり", "separated"],
                      ["席で喫煙可", "all_smoking"]
                    ], current_smoking_area_value),
                    class: "search-select" %>
              <% end %>
            </div>

            <div class="search-field">
              <%= label_tag :smoking_type, "喫煙タイプ" %>
              <%= select_tag :smoking_type,
                  options_for_select([
                    ["指定なし", ""],
                    ["紙・加熱式OK", "both_ok"],
                    ["加熱式のみ", "electronic_only"],
                    ["紙のみ", "paper_only"]
                  ], params[:smoking_type]),
                  class: "search-select" %>
            </div>

            <div class="search-field">
              <%= label_tag :station, "最寄駅" %>

              <% if @forced_station_label.present? %>
                <div class="search-input" style="display:flex; align-items:center; color:#111; background:#f7f4ea;">
                  <%= @forced_station_label %>
                </div>
              <% else %>
                <%= text_field_tag :station, current_station_value, placeholder: "指定なし", class: "search-input" %>
              <% end %>
            </div>

            <div class="search-field">
              <%= label_tag :genre, "ジャンル" %>

              <% if @forced_genre_label.present? && params[:genre].blank? %>
                <div class="search-input" style="display:flex; align-items:center; color:#111; background:#f7f4ea;">
                  <%= @forced_genre_label %>
                </div>
              <% else %>
                <%= select_tag :genre,
                    options_for_select(genre_select_options, current_genre_value),
                    class: "search-select" %>
              <% end %>
            </div>

            <div class="search-field">
              <%= label_tag :q, "キーワード" %>
              <%= text_field_tag :q, params[:q], placeholder: "店名・住所など", class: "search-input" %>
            </div>
          </div>

          <div class="search-actions">
            <%= submit_tag "検索する", class: "btn btn--dark search-btn" %>
          </div>
        <% end %>

        <% if hero_chips.any? %>
          <div class="active-filters">
            <div class="active-filters__label">検索条件</div>
            <div class="active-filters__list">
              <% hero_chips.each do |text, key| %>
                <% new_q = hero_query.deep_dup %>
                <% new_q.delete(key.to_s) %>

                <% if key.to_sym == :forced_area %>
                  <% area_clear_query = hero_query.deep_dup %>
                  <% area_clear_query.delete("smoking_area") if request.path.include?("/smoking/") %>
                  <% area_clear_query.delete("genre") if request.path.include?("/genre/") %>
                  <% area_clear_query.delete("station") if request.path.include?("/station/") %>

                  <%= link_to "#{root_path}?#{area_clear_query.merge(per: (@per.presence || 30)).compact_blank.to_query}",
                      class: "filter-chip",
                      style: "background:#e8f1ff; border:1px solid #87aef5; color:#1d4ed8;" do %>
                    <span><%= text %></span>
                    <span>×</span>
                  <% end %>

                <% elsif @forced_station_label.present? && key.to_sym == :station %>
                  <% station_clear_url =
                    if @current_area_key.to_s == "umeda"
                      umeda_path
                    elsif @current_area_key.to_s == "namba"
                      namba_path
                    else
                      (@search_form_url || root_path)
                    end %>

                  <%= link_to "#{station_clear_url}?#{new_q.merge(per: (@per.presence || 30)).compact_blank.to_query}", class: "filter-chip" do %>
                    <span><%= text %></span>
                    <span>×</span>
                  <% end %>

                <% elsif @forced_genre_label.present? && key.to_sym == :genre && params[:genre].blank? %>
                  <% genre_clear_url =
                    if @current_area_key.to_s == "umeda"
                      umeda_path
                    elsif @current_area_key.to_s == "namba"
                      namba_path
                    else
                      (@search_form_url || root_path)
                    end %>

                  <%= link_to "#{genre_clear_url}?#{new_q.merge(per: (@per.presence || 30)).compact_blank.to_query}", class: "filter-chip" do %>
                    <span><%= text %></span>
                    <span>×</span>
                  <% end %>

                <% elsif request.path_parameters[:smoking_area].present? && key.to_sym == :smoking_area %>
                  <% smoking_clear_url =
                    if @current_area_key.to_s == "umeda"
                      umeda_path
                    elsif @current_area_key.to_s == "namba"
                      namba_path
                    else
                      (@search_form_url || root_path)
                    end %>

                  <%= link_to "#{smoking_clear_url}?#{new_q.merge(per: (@per.presence || 30)).compact_blank.to_query}", class: "filter-chip" do %>
                    <span><%= text %></span>
                    <span>×</span>
                  <% end %>

                <% else %>
                  <%= link_to "#{(@search_form_url || root_path)}?#{new_q.merge(per: (@per.presence || 30)).compact_blank.to_query}", class: "filter-chip" do %>
                    <span><%= text %></span>
                    <span>×</span>
                  <% end %>
                <% end %>
              <% end %>

              <% station_slug = request.path_parameters[:station].presence %>
              <% genre_slug = request.path_parameters[:genre].presence %>
              <% smoking_slug = request.path_parameters[:smoking_area].presence %>

              <% clear_base_url =
                if station_slug.present? && @current_area_key.to_s == "umeda"
                  umeda_station_path(station_slug)
                elsif station_slug.present? && @current_area_key.to_s == "namba"
                  namba_station_path(station_slug)
                elsif genre_slug.present? && @current_area_key.to_s == "umeda"
                  umeda_genre_path(genre_slug)
                elsif genre_slug.present? && @current_area_key.to_s == "namba"
                  namba_genre_path(genre_slug)
                elsif smoking_slug.present? && @current_area_key.to_s == "umeda"
                  umeda_smoking_path(smoking_slug)
                elsif smoking_slug.present? && @current_area_key.to_s == "namba"
                  namba_smoking_path(smoking_slug)
                else
                  (@clear_filters_url || @search_form_url || root_path)
                end %>

              <%= link_to "すべてクリア",
    root_path(per: (@per.presence || 30)),
    class: "filter-chip filter-chip--clear" %>
            </div>
          </div>
        <% end %>
      </div>

      <div class="hero__actions hero__actions--ctaRow">
        <%= link_to "近くで探す", map_path, class: "btn btn--dark hero__cta hero__cta--primary" %>
        <%= link_to "お店を登録", new_shop_path, class: "btn btn--gold hero__cta hero__cta--secondary" %>
      </div>

      <div class="hero__stats hero__stats--inline">
        <div class="hero-stat hero-stat--inline">
          <span class="hero-stat__label">掲載件数</span>
          <span class="hero-stat__value"><%= @shops_count || 0 %>件</span>
        </div>

        <div class="hero-stat hero-stat--inline">
          <span class="hero-stat__label">更新形式</span>
          <span class="hero-stat__value">ユーザー投稿型</span>
        </div>
      </div>
    </div>
  </div>
</section>