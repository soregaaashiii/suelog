<section class="hero">
  <div class="hero__inner" style="display:grid; grid-template-columns:1fr; gap:0; width:100%; max-width:1180px; margin:0 auto; padding:0 16px;">
    <div class="hero__content hero__content--single" style="width:100%; max-width:none; margin:0;">
      <div class="hero__topline">
        <div class="hero__eyebrow">SMOKING MAP OSAKA</div>
      </div>

      <h1 class="hero__title">
        大阪で「今」吸える店を、<br>
        すばやく探せる。
      </h1>

      <p class="hero__lead">
        喫煙可能な飲食店だけを集めた大阪特化の検索サービス。
        地図・エリア・喫煙条件から、今すぐ行ける店を見つけられます。
      </p>

      <div class="hero__actions">
        <%= link_to "近くで探す", map_path, class: "btn btn--dark" %>
        <%= link_to "お店を登録", new_shop_path, class: "btn btn--gold" %>
      </div>

      <div class="hero__featureChips">
        <span class="hero__featureChip">席で喫煙可 / 喫煙所あり を判別</span>
        <span class="hero__featureChip">紙・加熱式・電子のみ を区別</span>
        <span class="hero__featureChip">地図・駅で絞り込み</span>
      </div>

      <div class="hero__stats">
        <div class="hero-stat">
          <div class="hero-stat__label">掲載件数</div>
          <div class="hero-stat__value"><%= @shops_count || 0 %>件</div>
        </div>

        <div class="hero-stat">
          <div class="hero-stat__label">対象エリア</div>
          <div class="hero-stat__value">大阪中心</div>
        </div>

        <div class="hero-stat">
          <div class="hero-stat__label">更新形式</div>
          <div class="hero-stat__value">ユーザー投稿型</div>
        </div>
      </div>
    </div>
  </div>
</section>