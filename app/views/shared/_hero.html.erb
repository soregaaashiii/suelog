<%# /Users/kawamuratakuya/dev/suelog/app/views/shared/_hero.html.erb %>

<%
raw_hero_query = request.query_parameters.to_h.deep_dup.except("page", "commit")

hero_query = raw_hero_query.each_with_object({}) do |(key, value), hash|
  next if value.blank?
  hash[key] = value
end
%>

<% smoking_area_label = {
  "separated" => "喫煙所あり",
  "all_smoking" => "席で喫煙可",
  "smoking_allowed" => "席で喫煙可"
} %>

<% smoking_type_label = {
  "both_ok" => "紙・加熱式OK",
  "electronic_only" => "加熱式のみ",
  "paper_only" => "紙のみ"
} %>

<% genre_label = {} %>
<% Shop.genre_options.each { |g| genre_label[g] = g } %>
<% genre_label["izakaya"] = "居酒屋" %>
<% genre_label["bar"] = "バー・パブ" %>
<% genre_label["cafe"] = "カフェ" %>
<% genre_label["yakiniku"] = "焼肉" %>

<% genre_select_options = [["ジャンル", ""]] %>
<% genre_select_options.concat(Shop.genre_options.map { |g| [genre_label[g] || g, g] }) %>

<% legacy_genre_labels = {
  "izakaya" => "居酒屋",
  "bar" => "バー・パブ",
  "cafe" => "カフェ",
  "yakiniku" => "焼肉"
} %>

<% if params[:genre].present? && genre_select_options.none? { |_label, value| value.to_s == params[:genre].to_s } %>
  <% genre_select_options << [legacy_genre_labels[params[:genre].to_s] || params[:genre].to_s, params[:genre].to_s] %>
<% end %>

<% current_genre_value =
  if params[:genre].present?
    params[:genre]
  elsif @forced_genre_slug.present?
    @forced_genre_slug
  end %>

<% current_smoking_area_value =
  if request.path_parameters[:smoking_area].present?
    request.path_parameters[:smoking_area]
  else
    params[:smoking_area]
  end %>

<% current_station_value =
  if @forced_station_label.present?
    @forced_station_label
  elsif params[:station].present?
    params[:station]
  end %>

<% hero_chips = [] %>

<% if @forced_area_label.present? %>
  <% hero_chips << ["エリア：#{@forced_area_label}", :forced_area] %>
<% end %>

<% if current_smoking_area_value.present? %>
  <% label = smoking_area_label[current_smoking_area_value] || current_smoking_area_value %>
  <% hero_chips << ["喫煙エリア：#{label}", :smoking_area] %>
<% end %>

<% if params[:smoking_type].present? %>
  <% label = smoking_type_label[params[:smoking_type]] || params[:smoking_type] %>
  <% hero_chips << ["喫煙タイプ：#{label}", :smoking_type] %>
<% end %>

<% if current_station_value.present? %>
  <% hero_chips << ["最寄駅：#{current_station_value}", :station] %>
<% end %>

<% genre_chip_label =
  if params[:genre].present?
    genre_label[params[:genre]] || params[:genre]
  elsif @forced_genre_label.present?
    @forced_genre_label
  end %>

<% if genre_chip_label.present? %>
  <% hero_chips << ["ジャンル：#{genre_chip_label}", :genre] %>
<% end %>

<% hero_chips << ["キーワード：#{params[:q]}", :q] if params[:q].present? %>

<section class="hero hero--fullbleed hero--visual">
  <div class="hero__bg" aria-hidden="true">
    <%= image_tag "hero/hero-bg.png", class: "hero__bg-image", alt: "" %>
  </div>

  <div class="hero__shade" aria-hidden="true"></div>

  <div class="hero__inner">
    <div class="hero__content hero__content--single hero__content--visual">
      <div class="hero__brand">
        <%= image_tag "hero/hero-logo.png",
            class: "hero__logo",
            alt: "今、吸える店。" %>

        <p class="hero-copy hero-copy--overlay">大阪で喫煙できる飲食店をすぐ検索</p>
      </div>

      <div class="hero__search hero__search--glass">
        <%= form_with url: (@search_form_url || root_path), method: :get, local: true, class: "search-form" do %>
          <%= hidden_field_tag :per, (@per.presence || 30) %>

          <%# ホームでは area を持たせない（404防止） %>
          <% unless request.path == root_path %>
            <%= hidden_field_tag :area, @current_area_key if @current_area_key.present? && !@forced_area_label.present? %>
          <% end %>

          <div class="search-grid search-grid--compact-hero">
            <div class="search-field">
              <% if request.path_parameters[:smoking_area].present? %>
                <div class="search-input search-input--locked">
                  <%= smoking_area_label[current_smoking_area_value] || current_smoking_area_value %>
                </div>
              <% else %>
                <%= select_tag :smoking_area,
                    options_for_select([
                      ["喫煙エリア", ""],
                      ["喫煙所あり", "separated"],
                      ["席で喫煙可", "all_smoking"]
                    ], current_smoking_area_value),
                    class: "search-select" %>
              <% end %>
            </div>

            <div class="search-field">
              <%= select_tag :smoking_type,
                  options_for_select([
                    ["喫煙タイプ", ""],
                    ["紙・加熱式OK", "both_ok"],
                    ["加熱式のみ", "electronic_only"],
                    ["紙のみ", "paper_only"]
                  ], params[:smoking_type]),
                  class: "search-select" %>
            </div>

            <div class="search-field">
              <% if @forced_station_label.present? %>
                <div class="search-input search-input--locked">
                  <%= @forced_station_label %>
                </div>
              <% else %>
                <%= text_field_tag :station, current_station_value, placeholder: "最寄駅", class: "search-input" %>
              <% end %>
            </div>

            <div class="search-field">
              <% if @forced_genre_label.present? && params[:genre].blank? %>
                <div class="search-input search-input--locked">
                  <%= @forced_genre_label %>
                </div>
              <% else %>
                <%= select_tag :genre,
                    options_for_select(genre_select_options, current_genre_value),
                    class: "search-select" %>
              <% end %>
            </div>

            <div class="search-field search-field--with-button">
              <%= text_field_tag :q, params[:q],
                  placeholder: "キーワード（店名・住所など）",
                  class: "search-input search-input--with-button" %>

              <%= submit_tag "検索",
                  class: "search-inline-btn" %>
            </div>
          </div>
        <% end %>


        <% if hero_chips.any? %>
          <div class="active-filters active-filters--hero">
            <div class="active-filters__label active-filters__label--hero">検索条件</div>
            <div class="active-filters__list active-filters__list--hero">
              <% hero_chips.each do |text, key| %>
                <% new_q = hero_query.deep_dup %>
                <% new_q.delete(key.to_s) %>

                <% if key.to_sym == :forced_area %>
                  <% area_clear_query = hero_query.deep_dup %>
                  <% area_clear_query["smoking_area"] = request.path_parameters[:smoking_area] if request.path_parameters[:smoking_area].present? %>
                  <% area_clear_query["genre"] = request.path_parameters[:genre] if request.path_parameters[:genre].present? %>
                  <% area_clear_query["station"] = current_station_value if current_station_value.present? %>

                  <%= link_to "#{root_path}?#{area_clear_query.merge(per: (@per.presence || 30)).compact_blank.to_query}",
                      class: "filter-chip",
                      style: "background:#e8f1ff; border:1px solid #87aef5; color:#1d4ed8;" do %>
                    <span><%= text %></span>
                    <span>×</span>
                  <% end %>

                <% elsif @forced_station_label.present? && key.to_sym == :station %>
                  <% station_clear_url =
                    if @current_area_key.to_s == "umeda"
                      umeda_path
                    elsif @current_area_key.to_s == "namba"
                      namba_path
                    else
                      (@search_form_url || root_path)
                    end %>

                  <%= link_to "#{station_clear_url}?#{new_q.merge(per: (@per.presence || 30)).compact_blank.to_query}", class: "filter-chip" do %>
                    <span><%= text %></span>
                    <span>×</span>
                  <% end %>

                <% elsif @forced_genre_label.present? && key.to_sym == :genre && params[:genre].blank? %>
                  <% genre_clear_url =
                    if @current_area_key.to_s == "umeda"
                      umeda_path
                    elsif @current_area_key.to_s == "namba"
                      namba_path
                    else
                      (@search_form_url || root_path)
                    end %>

                  <%= link_to "#{genre_clear_url}?#{new_q.merge(per: (@per.presence || 30)).compact_blank.to_query}", class: "filter-chip" do %>
                    <span><%= text %></span>
                    <span>×</span>
                  <% end %>

                <% elsif request.path_parameters[:smoking_area].present? && key.to_sym == :smoking_area %>
                  <% smoking_clear_url =
                    if @current_area_key.to_s == "umeda"
                      umeda_path
                    elsif @current_area_key.to_s == "namba"
                      namba_path
                    else
                      (@search_form_url || root_path)
                    end %>

                  <%= link_to "#{smoking_clear_url}?#{new_q.merge(per: (@per.presence || 30)).compact_blank.to_query}", class: "filter-chip" do %>
                    <span><%= text %></span>
                    <span>×</span>
                  <% end %>

                <% else %>
                  <%= link_to "#{(@search_form_url || root_path)}?#{new_q.merge(per: (@per.presence || 30)).compact_blank.to_query}", class: "filter-chip" do %>
                    <span><%= text %></span>
                    <span>×</span>
                  <% end %>
                <% end %>
              <% end %>

              <%= link_to "すべてクリア",
                  root_path(per: (@per.presence || 30)),
                  class: "filter-chip filter-chip--clear" %>
            </div>
          </div>
        <% end %>

        <div class="hero__meta-bar">
          掲載<%= @total_shops_count || @shops_count || 0 %>件｜みんなで更新中
        </div>

        <div class="hero__actions hero__actions--ctaRow">
          <%= link_to "近くで探す", map_path, class: "btn btn--dark hero__cta hero__cta--primary" %>
          <%= link_to "お店を登録", new_shop_path, class: "btn btn--gold hero__cta hero__cta--secondary" %>
        </div>
      </div>


    </div>
  </div>
</section>