<%# app/views/shared/_opening_hours_fields.html.erb %>

<% param_prefix = local_assigns[:param_prefix].presence || "shop[opening_hours_json]" %>
<% data ||= {} %>

<div style="border:1px solid #ddd; padding:14px; border-radius:14px;">

<div style="font-weight:800; margin-bottom:10px;">
営業時間
</div>

<% days = {
"monday" => "月",
"tuesday" => "火",
"wednesday" => "水",
"thursday" => "木",
"friday" => "金",
"saturday" => "土",
"sunday" => "日",
"pre_holiday" => "祝前",
"post_holiday" => "祝後"
} %>

<p style="color:#666; font-size:13px;">
祝前・祝後は未設定なら通常の曜日営業時間として扱います。特別営業時間がある場合だけ入力してください。
</p>

<% days.each do |key, label| %>
<% d = data[key] || {} %>
<% closed = d["closed"] %>

<div style="margin-bottom:14px; padding:10px; border:1px solid #eee; border-radius:10px;">

<label style="font-weight:700;">
<%= %w[pre_holiday post_holiday].include?(key) ? "#{label}の特別営業時間" : "#{label}曜営業" %>
</label>

<div style="margin-top:6px;">
<label>
<%= check_box_tag "#{param_prefix}[#{key}][closed]", "1", closed %>
定休日
</label>
</div>

<div style="margin-top:6px;">
開店：
<%= time_field_tag "#{param_prefix}[#{key}][open]", d["open"], style:"width:120px;" %>
〜
閉店：
<%= time_field_tag "#{param_prefix}[#{key}][close]", d["close"], style:"width:120px;" %>
</div>

<div style="margin-top:6px;">
<label>
<%= check_box_tag "#{param_prefix}[#{key}][break_enabled]", "1", d["break_enabled"] %>
中休みあり
</label>
</div>

<div style="margin-top:6px;">
<%= time_field_tag "#{param_prefix}[#{key}][break_start]", d["break_start"], style:"width:120px;" %>
〜
<%= time_field_tag "#{param_prefix}[#{key}][break_end]", d["break_end"], style:"width:120px;" %>
</div>

</div>
<% end %>

</div>
