<h1>通報：<%= @shop.name %></h1>

<p style="color:#666;">※ 通報は管理者が確認して対応します</p>

<%= form_with model: [@shop, @report], local: true do |f| %>
  <p>あなたの名前（任意）：<br><%= f.text_field :reporter_name %></p>

  <p>理由：<br>
    <%= f.select :reason, ["禁煙になった", "閉店した", "場所が違う", "店名が違う", "その他"], include_blank: "選択してください" %>
  </p>

  <p>詳細（任意）：<br><%= f.text_area :detail, rows: 4 %></p>

  <%= f.submit "通報する" %>
<% end %>

<p style="margin-top:12px;"><%= link_to "戻る", shop_path(@shop) %></p>
