<% content_for :title, @page_title %>
<% content_for :meta_description, @page_description %>
<% content_for :canonical_url, @canonical_url if @canonical_url.present? %>

<%= render "shared/hero" %>

<section class="home-section">
<div class="section-head">
<div>
<h2 class="section-title">人気エリアから探す</h2>
<p class="section-subtitle">まずは梅田エリアの喫煙可能店から探せます</p>
</div>
</div>

<div class="panel">
<div style="display:flex; gap:10px; flex-wrap:wrap;">
<%= link_to "梅田で喫煙できる店", umeda_path, class: "btn btn--ghost" %>
<%= link_to "梅田で席で喫煙可", umeda_smoking_path("all_smoking"), class: "btn btn--ghost" %>
<%= link_to "梅田で喫煙所あり", umeda_smoking_path("separated"), class: "btn btn--ghost" %>
<%= link_to "梅田の居酒屋", umeda_genre_path("izakaya"), class: "btn btn--ghost" %>
</div>
</div>
</section>

<% q = request.query_parameters.to_h.deep_dup %>

<% smoking_area_label = {
"separated" => "喫煙所あり",
"all_smoking" => "席で喫煙可",
"smoking_allowed" => "席で喫煙可"
} %>

<% smoking_type_label = {
"both_ok" => "紙・加熱式OK",
"electronic_only" => "加熱式のみ",
"paper_only" => "紙のみ"
} %>

<% chips = [] %>
<% chips << ["キーワード：#{params[:q]}", :q] if params[:q].present? %>
<% chips << ["ジャンル：#{params[:genre]}", :genre] if params[:genre].present? && @forced_genre.blank? %>
<% chips << ["最寄駅：#{params[:station]}", :station] if params[:station].present? %>

<% if @forced_genre.present? %>
<% chips << ["ジャンル：#{@forced_genre}", :forced_genre] %>
<% end %>

<% if params[:smoking_area].present? %>
<% label = smoking_area_label[params[:smoking_area]] || params[:smoking_area] %>
<% chips << ["喫煙エリア：#{label}", :smoking_area] %>
<% end %>

<% if params[:smoking_type].present? %>
<% label = smoking_type_label[params[:smoking_type]] || params[:smoking_type] %>
<% chips << ["喫煙タイプ：#{label}", :smoking_type] %>
<% end %>

<div class="home-page">
<% if @is_area_page %>
<section class="home-section">
<div class="panel" style="margin-bottom:16px;">
<h2 class="section-title" style="margin-bottom:8px;"><%= @area_intro_title %></h2>
<p class="section-subtitle" style="margin:0 0 14px;"><%= @area_intro_text %></p>

<% if @area_nav_links.present? %>
<div style="display:flex; gap:8px; flex-wrap:wrap;">
<% @area_nav_links.each do |item| %>
<%= link_to item[:label], item[:path], class: "btn btn--ghost" %>
<% end %>
</div>
<% end %>
</div>
</section>
<% end %>

<section class="home-section">
<div class="section-head">
<div>
<h2 class="section-title">条件から探す</h2>
<p class="section-subtitle">喫煙条件・最寄駅・キーワードで絞り込めます</p>
</div>
</div>

<div class="panel">
<%= form_with url: @search_form_url, method: :get, local: true, html: { class: "search-form" } do %>
<%= hidden_field_tag :per, @per %>

<div class="search-grid">
<div class="field">
<label class="field-label">ジャンル</label>
<%= select_tag :genre,
options_for_select(
[["指定なし", ""]] + ["居酒屋", "バー / パブ", "喫茶店 / カフェ", "焼肉", "ラーメン", "中華", "和食", "洋食", "立ち飲み", "スナック", "その他"],
@forced_genre.presence || params[:genre]
),
class: "field-input",
disabled: @forced_genre.present? %>

<% if @forced_genre.present? %>
<%= hidden_field_tag :genre, @forced_genre %>
<% end %>
</div>

<div class="field">
<label class="field-label">最寄駅</label>
<%= text_field_tag :station,
params[:station],
placeholder: "指定なし",
class: "field-input" %>
</div>

<div class="field">
<label class="field-label">喫煙エリア</label>
<%= select_tag :smoking_area,
options_for_select([["指定なし", ""], ["喫煙所あり", "separated"], ["席で喫煙可", "all_smoking"]], params[:smoking_area]),
class: "field-input" %>
</div>

<div class="field">
<label class="field-label">喫煙タイプ</label>
<%= select_tag :smoking_type,
options_for_select([["指定なし", ""], ["紙・加熱式OK", "both_ok"], ["加熱式のみ", "electronic_only"], ["紙のみ", "paper_only"]], params[:smoking_type]),
class: "field-input" %>
</div>

<div class="field field--wide">
<label class="field-label">キーワード</label>
<%= text_field_tag :q,
params[:q],
placeholder: "店名・住所など",
class: "field-input" %>
</div>
</div>

<div class="search-actions">
<%= submit_tag "検索する", class: "btn btn--primary" %>
<%= link_to "条件をクリア", @search_form_url + "?per=#{@per}", class: "btn btn--ghost" %>
</div>
<% end %>

<% if chips.any? %>
<div class="active-filters">
<div class="active-filters__label">検索条件</div>
<div class="active-filters__list">
<% chips.each do |text, key| %>
<% if key == :forced_genre %>
<%= link_to @search_form_url + "?per=#{@per}", class: "filter-chip" do %>
<span><%= text %></span>
<span>×</span>
<% end %>
<% else %>
<% new_q = q.deep_dup %>
<% new_q.delete(key.to_s) %>

<%= link_to "#{@search_form_url}?#{new_q.to_query}", class: "filter-chip" do %>
<span><%= text %></span>
<span>×</span>
<% end %>
<% end %>
<% end %>

<%= link_to "すべてクリア",
@search_form_url + "?per=#{@per}",
class: "filter-chip filter-chip--clear" %>
</div>
</div>
<% end %>
</div>
</section>

<section class="home-section">
<div class="section-head">
<div>
<h2 class="section-title"><%= @page_heading %></h2>
<p class="section-subtitle"><%= @page_subtitle %></p>
</div>

<div class="result-count">
<span class="result-count__num"><%= @shops_count %></span>
<span class="result-count__text">件</span>
</div>
</div>

<div class="panel" style="margin-bottom:16px;">
<div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
<span style="font-size:13px; color:#666; font-weight:700;">表示件数</span>

<% current_query = request.query_parameters.except(:page).to_h %>

<%= link_to "30件",
@search_form_url + "?" + current_query.merge(per: 30).to_query,
class: "btn #{(@per == 30 ? 'btn--dark' : 'btn--ghost')}" %>

<%= link_to "50件",
@search_form_url + "?" + current_query.merge(per: 50).to_query,
class: "btn #{(@per == 50 ? 'btn--dark' : 'btn--ghost')}" %>

<%= link_to "100件",
@search_form_url + "?" + current_query.merge(per: 100).to_query,
class: "btn #{(@per == 100 ? 'btn--dark' : 'btn--ghost')}" %>
</div>
</div>

<% if @shops.present? && @shops.any? %>
<%= render partial: "shared/shop_cards", locals: { shops: @shops } %>

<div style="margin-top:20px; display:flex; justify-content:center;">
<%= paginate @shops, params: request.query_parameters.except(:page) %>
</div>
<% else %>
<div class="empty-state">
<p>該当する店舗はありません。</p>
</div>
<% end %>
</section>

<section class="home-section">
<div class="info-note">
※ 情報はユーザー投稿を含みます。最新状況は来店前に店舗へご確認ください。
</div>
</section>
</div>