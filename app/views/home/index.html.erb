<%= render "shared/hero" %>

<hr>

<h2 style="margin-top:12px;">検索</h2>

<%= form_with url: root_path, method: :get, local: true do %>
<div style="display:flex; gap:10px; flex-wrap:wrap; align-items:flex-end; margin:10px 0;">

<% q = request.query_parameters.to_h.deep_dup %>

<% smoking_area_label = {
"separated" => "喫煙所あり",
"all_smoking" => "席で喫煙可",
"smoking_allowed" => "席で喫煙可" # ✅ 旧値も表示崩れしないように
} %>

<% smoking_type_label = {
"both_ok" => "紙・電子OK",
"electronic_only" => "電子のみ",
"paper_only" => "紙のみ"
} %>

<% chips = [] %>
<% chips << ["キーワード：#{params[:q]}", :q] if params[:q].present? %>
<% chips << ["ジャンル：#{params[:genre]}", :genre] if params[:genre].present? %>
<% chips << ["エリア：#{params[:area]}", :area] if params[:area].present? %>
<% chips << ["最寄駅：#{params[:station]}", :station] if params[:station].present? %>

<% if params[:smoking_area].present? %>
<% label = smoking_area_label[params[:smoking_area]] || params[:smoking_area] %>
<% chips << ["喫煙エリア：#{label}", :smoking_area] %>
<% end %>

<% if params[:smoking_type].present? %>
<% label = smoking_type_label[params[:smoking_type]] || params[:smoking_type] %>
<% chips << ["喫煙タイプ：#{label}", :smoking_type] %>
<% end %>

<% if chips.any? %>
<div style="width:100%; margin:10px 0;">
<div style="color:#666; font-size:12px;">検索条件（タップで解除）</div>
<div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:6px;">
<% chips.each do |text, key| %>
<% new_q = q.deep_dup; new_q.delete(key.to_s) %>
<%= link_to root_path(new_q),
style: "padding:8px 10px; border:1px solid #ddd; border-radius:999px; text-decoration:none;" do %>
<%= text %> ×
<% end %>
<% end %>

<%= link_to "条件をすべてクリア", root_path,
style: "padding:8px 10px; border:1px solid #ddd; border-radius:999px; text-decoration:none; color:#666;" %>
</div>
</div>
<% end %>

<!-- ✅ NEW: キーワード検索 -->
<!-- <div>
<label>キーワード</label><br>
<%= text_field_tag :q,
params[:q],
placeholder: "店名・住所・メモ・電話・営業時間など",
style: "min-width:280px;" %>
</div> -->



<div>
<label>ジャンル</label><br>
<%= select_tag :genre,
options_for_select(
[["指定なし",""]] + ["居酒屋","バー / パブ","喫茶店 / カフェ","焼肉","ラーメン","中華","和食","洋食","立ち飲み","スナック","その他"],
params[:genre]
) %>
</div>

<% areas = ["阿倍野","阿倍野橋","旭区清水","朝潮橋","淡路","石橋阪大前","泉大津","泉ヶ丘","泉佐野","和泉中央","今里","茨木","茨木市","梅田","江坂","難波","大阪阿部野橋","大阪上本町","大阪狭山市","大阪天満宮","大日","大東市","大正","岡町","貝塚","香里園","柏原","門真市","岸和田","京橋","喜連瓜破","九条","河内小阪","河内国分","河内長野","河内松原","岸辺","北新地","北千里","北花田","布施","堺","堺東","桜川","新金岡","新今宮","新大阪","心斎橋","住道","千里中央","千林大宮","高槻","高槻市","玉造","天下茶屋","天王寺","天満橋","豊中","中百舌鳥","長居","西梅田","西九条","野田","東岸和田","東三国","東梅田","東大阪市","東花園","枚方市","平野","深井","藤井寺","古市","弁天町","本町","松原","箕面","都島","守口市","八尾","山田","淀屋橋","四ツ橋"] %>

<div>
<label>エリア</label><br>
<%= select_tag :area,
options_for_select([["指定なし",""]] + areas.map { |a| [a, a] }, params[:area]) %>
</div>

<div>
<label>最寄駅</label><br>
<%= text_field_tag :station,
params[:station],
placeholder: "指定なし",
style: "color:#111;" %>
</div>




<div>
<label>喫煙エリア</label><br>
<%= select_tag :smoking_area,
options_for_select([["指定なし",""],["喫煙所あり","separated"],["席で喫煙可","all_smoking"]], params[:smoking_area]) %>
</div>

<div>
<label>喫煙タイプ</label><br>
<%= select_tag :smoking_type,
options_for_select([["指定なし",""],["紙・電子OK","both_ok"],["電子のみ","electronic_only"],["紙のみ","paper_only"]], params[:smoking_type]) %>
</div>

<div style="width:100%; margin-top:6px;">
<label style="font-size:12px; color:#666;">キーワード（補助）</label><br>
<%= text_field_tag :q,
params[:q],
placeholder: "店名・住所など",
style: "width:220px; font-size:13px; padding:6px 10px; border:1px solid #ddd; border-radius:10px;" %>
</div>


<div>
<%= submit_tag "検索", class: "nav-btn" %>
<%= link_to "クリア", root_path, class: "nav-btn" %>
</div>

</div>
<% end %>

<hr>

<h2 style="margin-top:20px;">店舗</h2>
<p style="color:#666; margin:6px 0 12px;">
件数：<%= @shops_count %> 件
</p>

<% if @shops.any? %>
<%= render "shared/shop_cards", shops: @shops %>
<% else %>
<p style="color:#666;">該当する店舗はありません。</p>
<% end %>

<hr>

<p style="color:#666; font-size:12px;">
※ 情報はユーザー投稿です。最新状況は店舗にてご確認ください。
</p>