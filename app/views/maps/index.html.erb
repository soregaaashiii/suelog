<%# /Users/kawamuratakuya/dev/suelog/app/views/maps/index.html.erb %>

<%
map_shops = @shops.select { |s| s.latitude.present? && s.longitude.present? }
%>

<% content_for :title, "大阪で喫煙できる店を地図検索｜電話・ルート・空席確認【吸えログ】" %>
<% content_for :meta_description, "大阪で喫煙できる飲食店を地図から探せます。梅田・難波周辺で席で喫煙可、喫煙所あり、営業中の店舗を絞り込み、電話・ルート・食べログなどの行動導線へ進めます。" %>
<% content_for :canonical_url, map_url %>

<h1>大阪で喫煙できる店を地図から探す</h1>

<p style="color:#666; font-size:12px; line-height:1.7;">
  梅田・難波を中心に、大阪で喫煙できる飲食店を地図で探せます。席で喫煙可・喫煙所あり・営業中などで絞り込み、気になる店舗は地図上の吹き出しから電話、ルート確認、空席確認へ進めます。<br>
  初回は現在地から半径800mの店舗を表示します。地図を移動・拡大縮小すると、新しい表示範囲の店舗を自動で読み込みます。
</p>

<p id="shops-summary" style="margin:6px 0; color:#666; font-size:12px;">
  掲載店舗数：<%= @shops_count %> ／ この範囲の表示中：<span id="visible-shops-count">0</span>
</p>

<div class="map-filter-panel">
  <div class="map-filter-panel__title">地図の絞り込み</div>

  <div class="map-filter-grid-fallback">
    <div>
      <label for="map-smoking-area" class="map-filter-label">
        喫煙エリア
      </label>
      <select id="map-smoking-area" class="map-filter-input">
        <option value="">すべて</option>
        <option value="all_smoking">席で喫煙可</option>
        <option value="separated">喫煙所あり</option>
      </select>
    </div>

    <div>
      <label for="map-smoking-type" class="map-filter-label">
        喫煙タイプ
      </label>
      <select id="map-smoking-type" class="map-filter-input">
        <option value="">すべて</option>
        <option value="both_ok">紙・加熱式OK</option>
        <option value="electronic_only">加熱式のみ</option>
        <option value="paper_only">紙のみ</option>
      </select>
    </div>

    <div>
      <label for="map-station" class="map-filter-label">
        最寄駅
      </label>
      <input
        type="text"
        id="map-station"
        placeholder="梅田 / なんば など"
        class="map-filter-input"
      >
    </div>

    <div>
      <label for="map-genre" class="map-filter-label">
        ジャンル
      </label>
      <select id="map-genre" class="map-filter-input">
        <option value="">すべて</option>
        <% @genres.each do |genre| %>
          <option value="<%= genre %>"><%= genre %></option>
        <% end %>
      </select>
    </div>

    <div class="map-filter-grid-fallback__full">
      <label for="map-keyword" class="map-filter-label">
        キーワード
      </label>
      <input
        type="text"
        id="map-keyword"
        placeholder="店名・住所で検索"
        class="map-filter-input"
      >
    </div>
  </div>

  <div class="map-open-now-row">
    <label class="map-open-now-toggle">
      <input type="checkbox" id="map-open-now-only" checked>
      <span>営業中のみ表示</span>
    </label>
  </div>

  <div id="map-active-filters" class="map-active-filters" style="display:none;">
    <div class="map-active-filters__title">検索条件</div>
    <div id="map-active-filters-list" class="map-active-filters__list"></div>
  </div>
</div>

<div class="map-actions">
  <button
    type="button"
    id="show-my-location-btn"
    class="map-pill-btn map-pill-btn--ghost">
    現在地を表示
  </button>
</div>

<button type="button" id="reload-map-shops" class="btn btn--dark">この範囲を再読み込み</button>
<p id="map-status" style="margin:0 0 12px; color:#666; font-size:12px;"></p>

<section class="map-quick-actions" aria-labelledby="map-quick-actions-title">
  <div class="map-quick-actions__head">
    <div>
      <h2 id="map-quick-actions-title">表示中の店舗からすぐ行動</h2>
      <p>気になる店舗は、地図を拡大しなくても電話・ルート・空席確認へ進めます。</p>
    </div>
    <span id="map-quick-actions-count" class="map-quick-actions__count"></span>
  </div>
  <div id="map-quick-actions-list" class="map-quick-actions__list"></div>
</section>

<div id="map" style="width:100%; height:70vh; min-height:520px; border:1px solid #ddd; border-radius:12px;"></div>

<div style="margin-top:12px;">
  <%= link_to "一覧に戻る", root_path, style: "color:#666; text-decoration:none; font-weight:700;" %>
</div>

<style>
@media (max-width: 768px) {
  #map {
    min-height: 460px !important;
  }
}

.map-quick-actions {
  margin: 0 0 14px;
  padding: 12px;
  border: 1px solid #e8e3d7;
  border-radius: 12px;
  background: #fffdf8;
}

.map-quick-actions__head {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: flex-start;
  margin-bottom: 10px;
}

.map-quick-actions__head h2 {
  margin: 0 0 4px;
  font-size: 16px;
}

.map-quick-actions__head p {
  margin: 0;
  color: #666;
  font-size: 12px;
  line-height: 1.6;
}

.map-quick-actions__count {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  min-height: 26px;
  padding: 0 10px;
  border-radius: 999px;
  background: #f7f4ee;
  color: #444;
  font-size: 12px;
  font-weight: 800;
}

.map-quick-actions__list {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.map-quick-card {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 10px;
  border: 1px solid #eee5d6;
  border-radius: 10px;
  background: #fff;
}

.map-quick-card__title {
  color: #111;
  text-decoration: none;
  font-weight: 900;
  line-height: 1.4;
}

.map-quick-card__meta {
  color: #666;
  font-size: 12px;
  line-height: 1.5;
}

.map-quick-card__actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 6px;
  margin-top: auto;
}

.map-quick-card__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 34px;
  padding: 7px 8px;
  border: 1px solid #d7d2c8;
  border-radius: 8px;
  color: #111;
  background: #fff;
  text-align: center;
  text-decoration: none;
  font-size: 12px;
  font-weight: 900;
}

.map-quick-card__btn--primary {
  grid-column: 1 / -1;
  border-color: #b42318;
  background: #b42318;
  color: #fff;
}

.map-quick-card__btn--dark {
  border-color: #111;
  background: #111;
  color: #fff;
}

@media (max-width: 900px) {
  .map-quick-actions__list {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
(() => {
let allShops = <%= raw @map_shops_payload.to_json %>;
let smokingBadges = <%= raw @map_smoking_badges_payload.to_json %>;
function smokingBadgesFor(shop) { return smokingBadges[`${shop.smoking_area}:${shop.smoking_type}`] || ""; }
let map;
let infoWindow;
let markers = [];
let myLocationMarker = null;
let initialSearchCenter = null;
let initialSearchCircle = null;
let firstRangeRendered = false;
let filteredShops = [...allShops];

const initialParams = new URLSearchParams(window.location.search);
const initialLat = parseFloat(initialParams.get("lat"));
const initialLng = parseFloat(initialParams.get("lng"));
const hasInitialLocation = Number.isFinite(initialLat) && Number.isFinite(initialLng) && Math.abs(initialLat) < 85 && Math.abs(initialLng) <= 180;

const smokingAreaLabels = {
  all_smoking: "席で喫煙可",
  separated: "喫煙所あり"
};

const smokingTypeLabels = {
  both_ok: "紙・加熱式OK",
  electronic_only: "加熱式のみ",
  paper_only: "紙のみ"
};

function setStatus(text) {
  const el = document.getElementById("map-status");
  if (el) el.textContent = text || "";
}

function escapeHtml(str) {
  return String(str || "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}

function markerIconFor(shop) {
  const isOpen = shop.open_now === true;

  return {
    path: google.maps.SymbolPath.CIRCLE,
    scale: 9,
    fillColor: isOpen ? "#16a34a" : "#6b7280",
    fillOpacity: 1,
    strokeColor: "#ffffff",
    strokeWeight: 2
  };
}

function buildStatusBadgeHtml(shop) {
  const state = shop.open_now === true ? "open" : "outside";
  const icon = shop.open_now === true ? "●" : "◷";
  const label = shop.open_now === true ? "営業中" : "営業時間外";
  return `<span class="refine-business-status refine-business-status--${state}"><span aria-hidden="true">${icon}</span><span>${label}</span></span>`;
}

function walkingMinutesFromCurrentLocation(shop) {
  if (!myLocationMarker) return null;

  const current = myLocationMarker.getPosition();
  if (!current || !shop.lat || !shop.lng) return null;

  const currentLatLng = new google.maps.LatLng(current.lat(), current.lng());
  const shopLatLng = new google.maps.LatLng(Number(shop.lat), Number(shop.lng));
  const distanceMeters = google.maps.geometry.spherical.computeDistanceBetween(currentLatLng, shopLatLng);

  return Math.max(1, Math.round((distanceMeters / 1000) * 12));
}

function buildInfoHtml(shop) {
  return `
    <div style="min-width:220px; line-height:1.7;">
      ${buildStatusBadgeHtml(shop)}
      ${smokingBadgesFor(shop)}
      <div style="font-weight:800; margin-bottom:6px;">${escapeHtml(shop.name)}</div>
      ${shop.address ? `<div style="font-size:12px; color:#444;">住所：${escapeHtml(shop.address)}</div>` : ""}
      ${shop.nearest_station ? `<div style="font-size:12px; color:#444;">最寄駅：${escapeHtml(shop.nearest_station)}</div>` : ""}
      ${walkingMinutesFromCurrentLocation(shop) ? `<div style="font-size:12px; color:#7a5a12; font-weight:800;">現在地から徒歩${walkingMinutesFromCurrentLocation(shop)}分</div>` : ""}
      ${shop.genre_label ? `<div style="font-size:12px; color:#444;">ジャンル：${escapeHtml(shop.genre_label)}</div>` : ""}
      ${shop.smoking_area_label ? `<div style="font-size:12px; color:#444;">喫煙エリア：${escapeHtml(shop.smoking_area_label)}</div>` : ""}
      ${shop.smoking_type_label ? `<div style="font-size:12px; color:#444;">喫煙タイプ：${escapeHtml(shop.smoking_type_label)}</div>` : ""}
      <div style="margin-top:10px; display:grid; grid-template-columns:1fr 1fr; gap:8px;">
        ${shop.booking_url ? `
          <a href="${escapeHtml(shop.booking_url)}"
             data-map-link
             style="grid-column:1 / -1; display:block; padding:10px 12px; background:#b42318; color:#fff; border-radius:8px; text-align:center; text-decoration:none; font-weight:800; font-size:13px;">
            ${escapeHtml(shop.booking_label || "空席を確認")}
          </a>
        ` : ""}
        ${shop.phone_url ? `
          <a href="${escapeHtml(shop.phone_url)}"
             data-map-link
             style="display:block; padding:9px 10px; background:#111; color:#fff; border-radius:8px; text-align:center; text-decoration:none; font-weight:800; font-size:12px;">
            電話する
          </a>
        ` : ""}
        ${shop.map_url ? `
          <a href="${escapeHtml(shop.map_url)}"
             data-map-link
             style="display:block; padding:9px 10px; background:#fff; color:#111; border:1px solid #d7d2c8; border-radius:8px; text-align:center; text-decoration:none; font-weight:800; font-size:12px;">
            ルートを見る
          </a>
        ` : ""}
        <a href="${escapeHtml(shop.url)}"
   data-map-link
   style="grid-column:1 / -1; display:block; padding:9px 12px; background:#f7f4ee; color:#111; border:1px solid #e8e3d7; border-radius:8px; text-align:center; text-decoration:none; font-weight:800; font-size:12px;">
  詳細を見る
</a>
      </div>
    </div>
  `;
}

function updateVisibleCount(count) {
  const el = document.getElementById("visible-shops-count");
  if (el) el.textContent = String(count);
}

function renderQuickActions(shops) {
  const list = document.getElementById("map-quick-actions-list");
  const count = document.getElementById("map-quick-actions-count");
  if (!list) return;

  if (count) {
    count.textContent = `${shops.length}件表示中`;
  }

  const actionableShops = shops
    .filter((shop) => shop.booking_url || shop.phone_url || shop.map_url)
    .slice(0, 6);

  if (actionableShops.length === 0) {
    list.innerHTML = `
      <div class="map-quick-card">
        <div class="map-quick-card__title">すぐ行動できる店舗がありません</div>
        <div class="map-quick-card__meta">条件を変えるか、地図上の店舗詳細を確認してください。</div>
      </div>
    `;
    return;
  }

  list.innerHTML = actionableShops.map((shop) => {
    const booking = shop.booking_url ? `
      <a href="${escapeHtml(shop.booking_url)}" data-map-link class="map-quick-card__btn map-quick-card__btn--primary">
        ${escapeHtml(shop.booking_label || "空席を確認")}
      </a>
    ` : "";
    const phone = shop.phone_url ? `
      <a href="${escapeHtml(shop.phone_url)}" data-map-link class="map-quick-card__btn map-quick-card__btn--dark">
        電話する
      </a>
    ` : "";
    const route = shop.map_url ? `
      <a href="${escapeHtml(shop.map_url)}" data-map-link class="map-quick-card__btn">
        ルート
      </a>
    ` : "";

    return `
      <article class="map-quick-card">
        <a href="${escapeHtml(shop.url)}" data-map-link class="map-quick-card__title">${escapeHtml(shop.name)}</a>
        <div class="map-quick-card__meta">
          ${shop.nearest_station ? `${escapeHtml(shop.nearest_station)} ／ ` : ""}
          ${shop.genre_label ? `${escapeHtml(shop.genre_label)} ／ ` : ""}
          ${escapeHtml(shop.smoking_area_label || "喫煙情報あり")}
        </div>
        <div>${smokingBadgesFor(shop)}</div>
        <div class="map-quick-card__actions">
          ${booking}
          ${phone}
          ${route}
        </div>
      </article>
    `;
  }).join("");
}

function clearMarkers() {
  markers.forEach((marker) => marker.setMap(null));
  markers = [];
}

function renderMarkers(shops) {
  clearMarkers();

  shops.forEach((shop) => {
    const marker = new google.maps.Marker({
      map: map,
      position: { lat: Number(shop.lat), lng: Number(shop.lng) },
      title: shop.name,
      icon: markerIconFor(shop)
    });

    marker.addListener("click", () => {
      infoWindow.setContent(buildInfoHtml(shop));
      infoWindow.open(map, marker);
    });

    markers.push(marker);
  });

  updateVisibleCount(shops.length);
}

function fitMarkersToBounds() {
  if (!map) return;

  if (markers.length === 0) {
    map.setCenter({ lat: 34.7025, lng: 135.4959 });
    map.setZoom(13);
    setStatus("条件に一致する店舗がありません。");
    return;
  }

  const bounds = new google.maps.LatLngBounds();

  markers.forEach((marker) => {
    bounds.extend(marker.getPosition());
  });

  if (myLocationMarker) {
    bounds.extend(myLocationMarker.getPosition());
  }

  map.fitBounds(bounds);

  google.maps.event.addListenerOnce(map, "bounds_changed", function() {
    if (map.getZoom() > 16) map.setZoom(16);
  });
}

function normalizedText(value) {
  return String(value || "").trim().toLowerCase();
}

function getFilterElements() {
  return {
    keywordEl: document.getElementById("map-keyword"),
    stationEl: document.getElementById("map-station"),
    genreEl: document.getElementById("map-genre"),
    smokingAreaEl: document.getElementById("map-smoking-area"),
    smokingTypeEl: document.getElementById("map-smoking-type"),
    openNowOnlyEl: document.getElementById("map-open-now-only")
  };
}

function getCurrentFilterValues() {
  const { keywordEl, stationEl, genreEl, smokingAreaEl, smokingTypeEl, openNowOnlyEl } = getFilterElements();

  return {
    keyword: normalizedText(keywordEl?.value),
    station: normalizedText(stationEl?.value),
    genre: genreEl?.value || "",
    smokingArea: smokingAreaEl?.value || "",
    smokingType: smokingTypeEl?.value || "",
    openNowOnly: !!openNowOnlyEl?.checked
  };
}

function renderActiveFilterChips() {
  const wrap = document.getElementById("map-active-filters");
  const list = document.getElementById("map-active-filters-list");
  if (!wrap || !list) return;

  const { keywordEl, stationEl, genreEl } = getFilterElements();
  const values = getCurrentFilterValues();

  const chips = [];

  if (values.smokingArea) {
    chips.push({
      key: "smoking_area",
      text: `喫煙エリア：${smokingAreaLabels[values.smokingArea] || values.smokingArea}`
    });
  }

  if (values.smokingType) {
    chips.push({
      key: "smoking_type",
      text: `喫煙タイプ：${smokingTypeLabels[values.smokingType] || values.smokingType}`
    });
  }

  if (values.station) {
    chips.push({
      key: "station",
      text: `最寄駅：${stationEl?.value || ""}`
    });
  }

  if (values.genre) {
    const genreText = genreEl?.selectedOptions?.[0]?.text || values.genre;
    chips.push({
      key: "genre",
      text: `ジャンル：${genreText}`
    });
  }

  if (values.keyword) {
    chips.push({
      key: "keyword",
      text: `キーワード：${keywordEl?.value || ""}`
    });
  }

  if (values.openNowOnly) {
    chips.push({
      key: "open_now",
      text: "営業中のみ"
    });
  }

  if (chips.length === 0) {
    wrap.style.display = "none";
    list.innerHTML = "";
    return;
  }

  wrap.style.display = "block";

  const chipsHtml = chips.map((chip) => {
    return `
      <button
        type="button"
        data-filter-key="${chip.key}"
        class="map-filter-chip-btn">
        <span>${escapeHtml(chip.text)}</span>
        <span>×</span>
      </button>
    `;
  }).join("");

  const clearAllHtml = `
    <button
      type="button"
      data-filter-key="all"
      class="map-filter-chip-btn map-filter-chip-btn--clear">
      <span>すべてクリア</span>
    </button>
  `;

  list.innerHTML = chipsHtml + clearAllHtml;
}

const mapResponseCache = new Map();
let requestTimer;
let activeRequest;
let requestVersion = 0;
let mapLoadingReady = false;

function focusNearby(center) {
  initialSearchCenter = center;
  firstRangeRendered = false;
  initialSearchCircle?.setMap(null);
  initialSearchCircle = new google.maps.Circle({map,center,radius:800,strokeColor:"#c5a858",strokeWeight:1,fillColor:"#c5a858",fillOpacity:0.05,clickable:false});
  const latitudeDelta = 800 / 111320;
  const longitudeDelta = latitudeDelta / Math.cos(center.lat * Math.PI / 180);
  map.fitBounds(new google.maps.LatLngBounds(
    {lat:center.lat-latitudeDelta,lng:center.lng-longitudeDelta},
    {lat:center.lat+latitudeDelta,lng:center.lng+longitudeDelta}
  ), 12);
}

function renderMapResponse(data) {
  firstRangeRendered = true;
  allShops = data.shops;
  smokingBadges = data.badges;
  filteredShops = allShops;
  renderMarkers(allShops);
  renderQuickActions(allShops);
  (data.clusters || []).forEach(cluster => {
    const marker = new google.maps.Marker({map, position:{lat:cluster.lat,lng:cluster.lng},
      label:{text:String(cluster.count),color:"#fff"}, title:`${cluster.count}店舗・拡大して表示`,
      icon:{path:google.maps.SymbolPath.CIRCLE,scale:22,fillColor:"#78602d",fillOpacity:1,strokeColor:"#e7cc83",strokeWeight:2}});
    marker.addListener("click",()=>{map.setCenter({lat:cluster.lat,lng:cluster.lng});map.setZoom(map.getZoom()+2);});
    markers.push(marker);
  });
  if (data.clusters?.length) {
    const list = document.getElementById("map-quick-actions-list");
    if (list) list.textContent = "地図を拡大すると、この範囲の店舗詳細を確認できます。";
    const count = document.getElementById("map-quick-actions-count");
    if (count) count.textContent = `${data.total}店舗を集約表示`;
  }
  updateVisibleCount(data.total);
  setStatus(data.clusters?.length ? `${data.total}店舗をまとめて表示しています。拡大すると個別の店舗が表示されます。` :
    (data.total ? `この範囲に${data.total}店舗を表示しています。` : "この範囲では条件に一致する店舗がありません。地図を移動・縮小して範囲を広げられます。"));
}

function applyFilters() {
  renderActiveFilterChips();
  syncMapQuery();
  if (!mapLoadingReady) return;
  clearTimeout(requestTimer);
  activeRequest?.abort();
  const version = ++requestVersion;
  // Clear stale pins so failed or pending searches never look like current results.
  clearMarkers();
  const quickList = document.getElementById("map-quick-actions-list");
  if (quickList) quickList.textContent = "この範囲の店舗を読み込み中です…";
  updateVisibleCount(0);
  setStatus("表示範囲の店舗を読み込み中です…");
  requestTimer = setTimeout(async () => {
    const bounds = map.getBounds();
    if (!bounds) return;
    const ne = bounds.getNorthEast(), sw = bounds.getSouthWest();
    const filters = getCurrentFilterValues();
    const query = new URLSearchParams({south:sw.lat(),west:Math.max(-180,sw.lng()),north:ne.lat(),east:Math.min(180,ne.lng()),
      q:filters.keyword,station:filters.station,genre:filters.genre,smoking_area:filters.smokingArea,smoking_type:filters.smokingType,open_now_only:filters.openNowOnly ? "1":"0"});
    if (initialSearchCenter) {
      query.set("center_lat", initialSearchCenter.lat);
      query.set("center_lng", initialSearchCenter.lng);
      query.set("radius", "800");
    }
    const key = query.toString();
    const cached = mapResponseCache.get(key);
    if (cached && Date.now()-cached.time < 60000) { renderMapResponse(cached.data); return; }
    activeRequest = new AbortController();
    try {
      const response = await fetch(`/map.json?${query}`,{signal:activeRequest.signal,headers:{Accept:"application/json"}});
      if (!response.ok) throw new Error("map request failed");
      const data = await response.json();
      if (version !== requestVersion) return;
      mapResponseCache.set(key,{time:Date.now(),data});
      if (mapResponseCache.size > 12) mapResponseCache.delete(mapResponseCache.keys().next().value);
      renderMapResponse(data);
    } catch(error) {
      if (error.name === "AbortError" || version !== requestVersion) return;
      setStatus("店舗を読み込めませんでした。再読み込みボタンで再試行してください。");
    }
  }, 300);
}

function clearFilters() {
  const { keywordEl, stationEl, genreEl, smokingAreaEl, smokingTypeEl, openNowOnlyEl } = getFilterElements();

  if (keywordEl) keywordEl.value = "";
  if (stationEl) stationEl.value = "";
  if (genreEl) genreEl.value = "";
  if (smokingAreaEl) smokingAreaEl.value = "";
  if (smokingTypeEl) smokingTypeEl.value = "";
  if (openNowOnlyEl) openNowOnlyEl.checked = false;
}

function clearSingleFilter(key) {
  const { keywordEl, stationEl, genreEl, smokingAreaEl, smokingTypeEl, openNowOnlyEl } = getFilterElements();

  if (key === "keyword" && keywordEl) keywordEl.value = "";
  if (key === "station" && stationEl) stationEl.value = "";
  if (key === "genre" && genreEl) genreEl.value = "";
  if (key === "smoking_area" && smokingAreaEl) smokingAreaEl.value = "";
  if (key === "smoking_type" && smokingTypeEl) smokingTypeEl.value = "";
  if (key === "open_now" && openNowOnlyEl) openNowOnlyEl.checked = false;

  applyFilters();
}

function setMyLocationMarker(lat, lng, options = {}) {
  const me = { lat: lat, lng: lng };

  if (myLocationMarker) {
    myLocationMarker.setMap(null);
  }

  myLocationMarker = new google.maps.Marker({
    map: map,
    position: me,
    title: "現在地",
    icon: {
      path: google.maps.SymbolPath.CIRCLE,
      scale: 8,
      fillColor: "#2563eb",
      fillOpacity: 1,
      strokeColor: "#ffffff",
      strokeWeight: 2
    }
  });

  if (!options.preserveCenter) {
    focusNearby(me);
  }
}

function saveMapState() {
  if (!map) return;

  const center = map.getCenter();
  const zoom = map.getZoom();
  const { keywordEl, stationEl, genreEl, smokingAreaEl, smokingTypeEl, openNowOnlyEl } = getFilterElements();

  const myLocationPosition = myLocationMarker ? myLocationMarker.getPosition() : null;

  const state = {
    lat: center ? center.lat() : null,
    lng: center ? center.lng() : null,
    zoom: zoom,
    myLocation: {
      lat: myLocationPosition ? myLocationPosition.lat() : null,
      lng: myLocationPosition ? myLocationPosition.lng() : null
    },
    filters: {
      keyword: keywordEl?.value || "",
      station: stationEl?.value || "",
      genre: genreEl?.value || "",
      smokingArea: smokingAreaEl?.value || "",
      smokingType: smokingTypeEl?.value || "",
      openNowOnly: !!openNowOnlyEl?.checked
    }
  };

  try {
    sessionStorage.setItem("suelog_map_state", JSON.stringify(state));
  } catch(e) {}
}

function showMyLocation() {
  if (!navigator.geolocation) {
    setStatus("このブラウザでは現在地を取得できません。");
    return;
  }

  setStatus("現在地を取得中です...");

  navigator.geolocation.getCurrentPosition(
    (pos) => {
      setMyLocationMarker(pos.coords.latitude, pos.coords.longitude);
      setStatus("現在地を表示しています。");
    },
    () => {
      setStatus("現在地を取得できませんでした。ブラウザの位置情報許可を確認してください。");
    },
    {
      enableHighAccuracy: true,
      timeout: 10000,
      maximumAge: 0
    }
  );
}

function bindFilterEvents() {
  const { keywordEl, stationEl, genreEl, smokingAreaEl, smokingTypeEl, openNowOnlyEl } = getFilterElements();
  const myBtn = document.getElementById("show-my-location-btn");
  const chipList = document.getElementById("map-active-filters-list");

  if (keywordEl) {
    keywordEl.addEventListener("input", applyFilters);
  }

  if (stationEl) {
    stationEl.addEventListener("input", applyFilters);
  }

  if (genreEl) {
    genreEl.addEventListener("change", applyFilters);
  }

  if (smokingAreaEl) {
    smokingAreaEl.addEventListener("change", applyFilters);
  }

  if (smokingTypeEl) {
    smokingTypeEl.addEventListener("change", applyFilters);
  }

  if (openNowOnlyEl) {
    openNowOnlyEl.addEventListener("change", applyFilters);
  }

  if (chipList) {
    chipList.addEventListener("click", (event) => {
      const btn = event.target.closest("[data-filter-key]");
      if (!btn) return;

      const key = btn.getAttribute("data-filter-key");
      if (key === "all") {
        clearFilters();
        applyFilters();
        return;
      }

      clearSingleFilter(key);
    });
  }

  document.getElementById("reload-map-shops")?.addEventListener("click",()=>{mapResponseCache.clear();applyFilters();});

  if (myBtn) {
    myBtn.addEventListener("click", showMyLocation);
  }

  document.addEventListener("click", function(event) {
    const link = event.target.closest("[data-map-link]");
    if (!link) return;

    saveMapState();
  });
}

function restoreMapState() {
  try {
    const saved = sessionStorage.getItem("suelog_map_state");
    if (!saved) return false;

    const state = JSON.parse(saved);
    sessionStorage.removeItem("suelog_map_state");

    if (state.filters) {
      const { keywordEl, stationEl, genreEl, smokingAreaEl, smokingTypeEl, openNowOnlyEl } = getFilterElements();

      if (keywordEl) keywordEl.value = state.filters.keyword || "";
      if (stationEl) stationEl.value = state.filters.station || "";
      if (genreEl) genreEl.value = state.filters.genre || "";
      if (smokingAreaEl) smokingAreaEl.value = state.filters.smokingArea || "";
      if (smokingTypeEl) smokingTypeEl.value = state.filters.smokingType || "";
      if (openNowOnlyEl) openNowOnlyEl.checked = !!state.filters.openNowOnly;
    }

    applyFilters({ preserveViewport: true });

    if (
      state.myLocation &&
      Number.isFinite(state.myLocation.lat) &&
      Number.isFinite(state.myLocation.lng)
    ) {
      setMyLocationMarker(state.myLocation.lat, state.myLocation.lng, { preserveCenter: true });
    }

    if (Number.isFinite(state.lat) && Number.isFinite(state.lng)) {
      map.setCenter({ lat: state.lat, lng: state.lng });
      if (state.zoom) map.setZoom(state.zoom);
    }

    setStatus("前回の地図状態を復元しました。");
    return true;
  } catch(e) {
    return false;
  }
}

function readMapQuery() {
  const p = new URLSearchParams(location.search);
  const keys = {q:"map-keyword", station:"map-station", genre:"map-genre", smoking_area:"map-smoking-area", smoking_type:"map-smoking-type"};
  Object.entries(keys).forEach(([key,id]) => { document.getElementById(id).value = p.get(key) || ""; });
  const open = document.getElementById("map-open-now-only");
  if (p.has("open_now_only") || p.has("open_now")) open.checked = p.get("open_now_only") !== "0" && p.get("open_now") !== "0";
}
function syncMapQuery() {
  const url = new URL(location.href);
  const keys = {q:"map-keyword", station:"map-station", genre:"map-genre", smoking_area:"map-smoking-area", smoking_type:"map-smoking-type"};
  Object.entries(keys).forEach(([key,id]) => { const value = document.getElementById(id).value; value ? url.searchParams.set(key,value) : url.searchParams.delete(key); });
  url.searchParams.delete("open_now");
  url.searchParams.set("open_now_only",document.getElementById("map-open-now-only").checked ? "1" : "0");
  history.replaceState(null,"",url);
}
window.addEventListener("popstate", () => { readMapQuery(); applyFilters({preserveViewport:true}); });
function initMap() {
  const mapEl = document.getElementById("map");
  if (!mapEl) return;

  map = new google.maps.Map(mapEl, {
    center: { lat: 34.7025, lng: 135.4959 },
    zoom: 15,
    minZoom: 6,
    mapTypeControl: false,
    streetViewControl: false,
    fullscreenControl: true
  });

  infoWindow = new google.maps.InfoWindow();
  bindFilterEvents();

  const hasQueryFilters = ["q","station","genre","smoking_area","smoking_type","open_now_only","open_now"].some(key => initialParams.has(key));
  const restored = hasQueryFilters ? false : restoreMapState();
  if (hasQueryFilters) readMapQuery();

  mapLoadingReady = true;
  map.addListener("idle", applyFilters);
  const leaveInitialRadius = () => {
    initialSearchCenter = null;
    initialSearchCircle?.setMap(null);
  };
  map.addListener("dragstart", leaveInitialRadius);
  map.addListener("zoom_changed", () => { if (firstRangeRendered) leaveInitialRadius(); });
  if (!restored) {
    if (hasInitialLocation) setMyLocationMarker(initialLat, initialLng);
    else { focusNearby({lat:34.7025,lng:135.4959}); showMyLocation(); }
  }
  applyFilters();
}

window.initMap = initMap;
})();
</script>

<script async defer
src="https://maps.googleapis.com/maps/api/js?key=<%= ENV.fetch("GOOGLE_MAPS_API_KEY", "") %>&libraries=geometry&callback=initMap">
</script>
